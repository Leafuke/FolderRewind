<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform Condition="'$(InstallerPlatform)'==''">x64</InstallerPlatform>
    <!-- WiX 7 OSMF EULA: the project owner accepted this for the CI build channel. -->
    <AcceptEula>wix7</AcceptEula>
    <ProductVersion Condition="'$(ProductVersion)'==''">1.9.1.0</ProductVersion>
    <PackageLanguage Condition="'$(PackageLanguage)'==''">1033</PackageLanguage>
    <PackageIdentifier Condition="'$(PackageIdentifier)'==''">Leafuke.FolderRewind.Msi</PackageIdentifier>
    <PackageDisplayName Condition="'$(PackageDisplayName)'==''">FolderRewind</PackageDisplayName>
    <InstallerRegistryKey Condition="'$(InstallerRegistryKey)'==''">Software\Leafuke\FolderRewind</InstallerRegistryKey>
    <UpgradeCode Condition="'$(UpgradeCode)'==''">{6BCE6B1A-ADA1-5399-91BD-238EBF552F6E}</UpgradeCode>
    <EnableFaultInjection Condition="'$(EnableFaultInjection)'==''">0</EnableFaultInjection>
    <Cultures Condition="'$(Cultures)'==''">en-US</Cultures>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NativeOutputDirectory Condition="'$(NativeOutputDirectory)'==''">$(MSBuildThisFileDirectory)..\artifacts\installer-native</NativeOutputDirectory>
    <PublishDir Condition="'$(PublishDir)'==''">$(MSBuildThisFileDirectory)..\FolderRewind\bin\$(InstallerPlatform)\Release\net10.0-windows10.0.19041.0\win-$(InstallerPlatform)\publish</PublishDir>
    <OutputName Condition="'$(OutputName)'==''">FolderRewind_$(ProductVersion)_$(InstallerPlatform)</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir);ProductCode=$(ProductCode);PackageLanguage=$(PackageLanguage);NativeOutputDirectory=$(NativeOutputDirectory);PackageIdentifier=$(PackageIdentifier);PackageDisplayName=$(PackageDisplayName);InstallerRegistryKey=$(InstallerRegistryKey);UpgradeCode=$(UpgradeCode);EnableFaultInjection=$(EnableFaultInjection)</DefineConstants>
    <!-- Generated file components use registry key paths and explicit directory cleanup. -->
    <SuppressValidation>false</SuppressValidation>
    <!-- ICE57 cannot model the context-dependent HKMU keypath and redirected
         ProgramMenuFolder/DesktopFolder in a dual-scope package. Other ICEs run. -->
    <!-- ICE03/60 are rerun after normalizing upstream PE language metadata. -->
    <!-- ICE105 does not evaluate ALLUSERS conditions on the machine-only CAs.
         Repair-MsiMetadata validates their exact execution guards instead. -->
    <SuppressIces>ICE57;ICE105;ICE03;ICE60</SuppressIces>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(GeneratedComponents)" />
    <Compile Include="Package.wxs" />
    <EmbeddedResource Include="Localization\$(Cultures).wxl" />
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>
  <Target Name="ValidateFinalMsiMetadata" AfterTargets="Build">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\.github\scripts\Repair-MsiMetadata.ps1&quot; -PackagePath &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
