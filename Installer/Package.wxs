<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Id="Leafuke.FolderRewind.Msi"
      Name="FolderRewind"
      Manufacturer="Leafuke"
      Version="$(var.ProductVersion)"
      Language="1033"
      Scope="perUser"
      Compressed="yes">
    <MajorUpgrade
        DowngradeErrorMessage="A newer version of FolderRewind is already installed."
        Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Preserve the user's selected path during major upgrades. The value is
         searched before the old package is removed and written again by the
         Start Menu component in the new package. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch
          Id="RememberedInstallFolder"
          Root="HKCU"
          Key="Software\Leafuke\FolderRewind"
          Name="InstallFolder"
          Type="raw" />
    </Property>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FolderRewind" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="FolderRewindProgramsFolder" Name="FolderRewind">
        <Component Id="StartMenuShortcutComponent">
          <Shortcut
              Id="StartMenuShortcut"
              Name="FolderRewind"
              Description="FolderRewind"
              Target="[INSTALLFOLDER]FolderRewind.exe"
              WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveFolderRewindProgramsFolder" On="uninstall" />
          <RegistryValue
              Root="HKCU"
              Key="Software\Leafuke\FolderRewind"
              Name="StartMenuShortcut"
              Type="integer"
              Value="1"
              KeyPath="yes" />
          <RegistryValue
              Root="HKCU"
              Key="Software\Leafuke\FolderRewind"
              Name="InstallFolder"
              Type="string"
              Value="[INSTALLFOLDER]" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="FolderRewind" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
