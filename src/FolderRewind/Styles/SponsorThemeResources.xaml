<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="SponsorPaperBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF7F0E3" Offset="0" />
                <GradientStop Color="#FFE1D2B5" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SponsorForestBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE8F2E9" Offset="0" />
                <GradientStop Color="#FFBCD5C6" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SponsorNightBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFEEF0FA" Offset="0" />
                <GradientStop Color="#FFCFD5EF" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <LinearGradientBrush x:Key="SponsorPaperBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF28231D" Offset="0" />
                <GradientStop Color="#FF453828" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SponsorForestBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF14241C" Offset="0" />
                <GradientStop Color="#FF254337" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SponsorNightBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF141D35" Offset="0" />
                <GradientStop Color="#FF30294D" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="SponsorPaperBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="SponsorForestBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="SponsorNightBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
