<Page
    x:Class="FolderRewind.Views.SpatialPreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FolderRewind.ViewModels"
    xmlns:views="using:FolderRewind.Views"
    xmlns:controls="using:FolderRewind.Controls"
    KeyboardAcceleratorPlacementMode="Hidden" KeyDown="OnPageKeyDown">
    <Page.Resources>
        <Style x:Key="PreviewIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="OnCoordinateShortcut"/>
    </Page.KeyboardAccelerators>
    <Grid Padding="12,0" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="CoordinateFlyout" Opening="OnCoordinateOpening" Opened="OnCoordinateOpened">
                <StackPanel Width="224" Spacing="12">
                    <NumberBox x:Name="CoordinateX" Header="{x:Bind ViewModel.HorizontalAxis, Mode=OneWay}" AutomationProperties.AutomationId="PreviewCoordinateX" Minimum="-1000000000" Maximum="1000000000"/>
                    <NumberBox x:Name="CoordinateY" Header="{x:Bind ViewModel.VerticalAxis, Mode=OneWay}" AutomationProperties.AutomationId="PreviewCoordinateY" Minimum="-1000000000" Maximum="1000000000"/>
                    <TextBlock x:Name="CoordinateRange" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBlock x:Name="CoordinateError" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Uid="Preview_Locate" HorizontalAlignment="Right" AutomationProperties.AutomationId="PreviewLocate" Click="OnLocate"/>
                </StackPanel>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
        <Grid x:Name="Toolbar" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid ColumnSpacing="4" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Border Visibility="{x:Bind ViewModel.IsHistoricalSource, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="4,0">
                        <TextBlock x:Uid="Preview_HistoryBadge" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </Border>
                    <Border Visibility="{x:Bind ViewModel.IsPartialSource, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="4,0">
                        <TextBlock x:Uid="Preview_PartialBadge" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </Border>
                </StackPanel>
            </Grid>
            <Button x:Name="InformationButton" Grid.Column="1" x:Uid="Preview_InformationButton" Style="{StaticResource PreviewIconButtonStyle}"
                    AutomationProperties.AutomationId="PreviewInformation" AutomationProperties.Name="{x:Bind ViewModel.InformationName, Mode=OneWay}">
                <Grid>
                    <FontIcon Glyph="&#xE946;" FontSize="16" Visibility="{x:Bind views:SpatialPreviewPage.ShowUnless(ViewModel.HasPreviewWarning), Mode=OneWay}"/>
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                              Visibility="{x:Bind ViewModel.HasPreviewWarning, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                </Grid>
                <Button.Flyout>
                    <Flyout x:Name="InformationFlyout" Opening="OnInformationOpening">
                        <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Width="320" Spacing="12">
                                <TextBlock x:Uid="Preview_WorldInformation" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <Expander x:Name="MapStatusExpander" x:Uid="Preview_MapStatus" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="PreviewMapStatus">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="PreviewStatus"/>
                                        <TextBlock Text="{x:Bind ViewModel.StatisticsText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind ViewModel.LegendText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind ViewModel.ErrorDetails, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                   Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Uid="Preview_OperationHelp" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="PreviewOperationHelp">
                                    <TextBlock x:Uid="Preview_Help" TextWrapping="Wrap"/>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox x:Name="Layers" Width="124" Height="32" MinHeight="32" HorizontalContentAlignment="Stretch"
                          AutomationProperties.AutomationId="PreviewLayers" AutomationProperties.Name="{x:Bind ViewModel.LayerLabel, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.LayerLabel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.HasLayers, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.Layers, Mode=OneWay}" SelectionChanged="OnLayerChanged">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PreviewLayerChoice">
                        <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}"/>
                    </DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="ViewButton" x:Uid="Preview_ViewOptionsButton" Height="32" Width="152" MinWidth="128" HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="PreviewViewOptions" IsEnabled="{x:Bind ViewModel.HasLayers, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.ViewButtonText, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                        <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12"/>
                    </Grid>
                    <Button.Flyout>
                        <Flyout x:Name="ViewFlyout" Closing="OnViewFlyoutClosing" Closed="OnViewFlyoutClosed" Placement="Bottom">
                            <StackPanel Width="288" Spacing="12" PreviewKeyDown="OnViewPreviewKeyDown">
                                <StackPanel x:Name="ModeControls" Spacing="8">
                                    <TextBlock x:Uid="Preview_ViewModeLabel" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <ComboBox x:Name="ModeSelector" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Modes, Mode=OneWay}"
                                              SelectionChanged="OnModeChanged" x:Uid="Preview_ViewMode" AutomationProperties.AutomationId="PreviewViewMode">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PreviewModeChoice"><TextBlock Text="{x:Bind Name, Mode=OneTime}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HeightEnabled, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="{x:Bind ViewModel.HeightLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <Slider x:Name="HeightSlider" StepFrequency="1" SmallChange="1" LargeChange="16"
                                            Minimum="{x:Bind ViewModel.HeightMinimum, Mode=OneWay}" Maximum="{x:Bind ViewModel.HeightMaximum, Mode=OneWay}"
                                            Value="{x:Bind ViewModel.DraftHeight, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.HeightEnabled, Mode=OneWay}"
                                            AutomationProperties.AutomationId="PreviewHeightSlider" AutomationProperties.Name="{x:Bind ViewModel.HeightLabel, Mode=OneWay}"
                                            LostFocus="OnHeightLostFocus" KeyUp="OnHeightSliderKeyUp"/>
                                    <NumberBox x:Name="MaximumHeight" ValidationMode="Disabled" SmallChange="1" LargeChange="16"
                                               Text="{x:Bind ViewModel.HeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Inline"
                                               IsEnabled="{x:Bind ViewModel.HeightEnabled, Mode=OneWay}" LostFocus="OnHeightLostFocus"
                                               AutomationProperties.AutomationId="PreviewHeight" AutomationProperties.Name="{x:Bind ViewModel.HeightLabel, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind ViewModel.HeightError, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                                <TextBlock x:Uid="Preview_HeightHelp" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ProgressRing Width="16" Height="16" Margin="4,0" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" x:Uid="Preview_LoadingIndicator" AutomationProperties.AutomationId="PreviewLoading"/>
                <SplitButton x:Name="NavigateButton" Content="{x:Bind ViewModel.NavigationLabel, Mode=OneWay}" Height="32"
                             IsEnabled="{x:Bind ViewModel.HasLayers, Mode=OneWay}" AutomationProperties.AutomationId="PreviewNavigate"
                             AutomationProperties.Name="{x:Bind ViewModel.NavigationLabel, Mode=OneWay}" Click="OnQuickNavigate">
                    <SplitButton.Flyout>
                        <Flyout x:Name="NavigationFlyout">
                            <StackPanel Spacing="12" Width="288">
                                <Button x:Uid="Preview_CoordinatesButton" AutomationProperties.AutomationId="PreviewCoordinates" Click="OnShowCoordinates"/>
                                <TextBlock Text="{x:Bind ViewModel.NavigationStatus, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <ListView ItemsSource="{x:Bind ViewModel.Targets, Mode=OneWay}" MaxHeight="320" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTargetClicked"
                                          AutomationProperties.AutomationId="PreviewTargets" AutomationProperties.Name="{x:Bind ViewModel.NavigationLabel, Mode=OneWay}">
                                    <ListView.ItemTemplate><DataTemplate x:DataType="vm:PreviewTargetChoice">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}"/>
                                            <TextBlock Text="{x:Bind Description, Mode=OneTime}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                                        </StackPanel>
                                    </DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button x:Name="RefreshButton" x:Uid="Preview_RefreshIcon" Style="{StaticResource PreviewIconButtonStyle}" AutomationProperties.AutomationId="PreviewRefresh" Click="OnRefresh">
                    <SymbolIcon Symbol="Refresh"/>
                </Button>
                <Button x:Name="FitButton" x:Uid="Preview_FitIcon" Style="{StaticResource PreviewIconButtonStyle}" AutomationProperties.AutomationId="PreviewFitMap" Click="OnFit">
                    <FontIcon Glyph="&#xE9A6;" FontSize="16"/>
                </Button>
                <Button x:Name="MoreButton" x:Uid="Preview_MoreButton" Style="{StaticResource PreviewIconButtonStyle}" AutomationProperties.AutomationId="PreviewMore">
                    <SymbolIcon Symbol="More"/>
                    <Button.Flyout>
                        <MenuFlyout x:Name="MoreFlyout">
                            <MenuFlyoutItem x:Name="OverflowNavigate" Text="{x:Bind ViewModel.NavigationLabel, Mode=OneWay}" Click="OnOpenNavigation" AutomationProperties.AutomationId="PreviewOverflowNavigate" IsEnabled="{x:Bind ViewModel.HasLayers, Mode=OneWay}"/>
                            <MenuFlyoutItem x:Uid="Preview_CoordinatesMenu" KeyboardAcceleratorTextOverride="Ctrl+G" Click="OnShowCoordinates" AutomationProperties.AutomationId="PreviewCoordinatesMenu" IsEnabled="{x:Bind ViewModel.HasLayers, Mode=OneWay}"/>
                            <MenuFlyoutItem x:Name="OverflowRefresh" x:Uid="Preview_RefreshMenu" Click="OnRefresh" AutomationProperties.AutomationId="PreviewOverflowRefresh"/>
                            <MenuFlyoutItem x:Name="OverflowFit" x:Uid="Preview_FitMenu" Click="OnFit" AutomationProperties.AutomationId="PreviewOverflowFit"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutSubItem x:Uid="Preview_DisplayMenu" AutomationProperties.AutomationId="PreviewDisplay">
                                <ToggleMenuFlyoutItem x:Name="GridToggle" x:Uid="Preview_GridMenu" Click="OnGridToggled" AutomationProperties.AutomationId="PreviewGrid"/>
                                <ToggleMenuFlyoutItem x:Name="OverlayToggle" x:Uid="Preview_StatusOverlayMenu" IsChecked="{x:Bind ViewModel.ShowStatusOverlay, Mode=TwoWay}"
                                                      Click="OnOverlayToggled" AutomationProperties.AutomationId="PreviewStatusOverlay"
                                                      Visibility="{x:Bind ViewModel.SupportsStatusOverlay, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Uid="Preview_ZoomInMenu" Click="OnZoomIn" AutomationProperties.AutomationId="PreviewZoomIn"/>
                            <MenuFlyoutItem x:Uid="Preview_ZoomOutMenu" Click="OnZoomOut" AutomationProperties.AutomationId="PreviewZoomOut"/>
                            <MenuFlyoutSeparator/>
                            <ToggleMenuFlyoutItem x:Name="FocusModeMenu" x:Uid="Preview_FocusMode" IsChecked="{x:Bind ViewModel.IsFocusMode, Mode=TwoWay}"
                                                  Click="OnFocusModeChanged" AutomationProperties.AutomationId="PreviewFocusMode"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <SplitView x:Name="DetailLayout" Grid.Row="1" PanePlacement="Right" DisplayMode="Inline" OpenPaneLength="280" IsPaneOpen="False">
            <SplitView.Pane>
                <Grid Padding="16" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Button x:Uid="Preview_CloseDetails" HorizontalAlignment="Right" AutomationProperties.AutomationId="PreviewCloseDetails" Click="OnCloseDetails"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{x:Bind ViewModel.Details, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>
            <Grid>
                <controls:SpatialPreviewCanvas x:Name="Map" Background="{ThemeResource LayerFillColorAltBrush}" FlowDirection="LeftToRight"/>
                <Border Margin="16" Padding="16" MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{x:Bind ViewModel.ShowMapMessage, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                    <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Uid="Preview_HistoryCancel" Click="OnCancelPreparation" AutomationProperties.AutomationId="PreviewCancelPreparation"
                                    Visibility="{x:Bind ViewModel.IsPreparing, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                            <Button x:Uid="Preview_HistoryDownloadLink" Click="OnOpenHistory" AutomationProperties.AutomationId="PreviewHistoryDownload"
                                    Visibility="{x:Bind ViewModel.NeedsHistoryDownload, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                            <Button x:Uid="Preview_ViewStatusButton" Click="OnShowInformation" AutomationProperties.AutomationId="PreviewErrorDetails"
                                    Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </SplitView>
        <Grid Grid.Row="2" ColumnSpacing="16" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.CursorText, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border x:Name="ScaleBar" Height="6" BorderThickness="1,0,1,1" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ScaleLabel" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="PreviewScale"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
