<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="FolderRewind.Views.GameDiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FolderRewind.Models"
    xmlns:discovery="using:FolderRewind.Services.Discovery"
    xmlns:vm="using:FolderRewind.ViewModels"
    xmlns:local="using:FolderRewind.Views"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <Style x:Key="DiscoveryRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <DataTemplate x:Key="SetRow" x:DataType="vm:GameDiscoveryBackupSetItem">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12" Margin="0,8,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox IsThreeState="True" IsChecked="{x:Bind SelectionState, Mode=OneWay}"
                        IsEnabled="{x:Bind CanSelect, Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="OnSetSelectionClick"
                        MinWidth="0" VerticalAlignment="Top" AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"/>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind SelectionSummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                            <Run Text="{x:Bind KindText, Mode=OneTime}"/><Run Text="  ·  "/><Run Text="{x:Bind PluginText, Mode=OneTime}"/>
                        </TextBlock>
                        <TextBlock Text="{x:Bind SettingsSummary, Mode=OneWay}" TextWrapping="Wrap"
                            Visibility="{x:Bind HasPresetPicker, Mode=OneTime, Converter={StaticResource BoolToVisInvertConverter}}"/>
                        <ComboBox x:Name="PresetPicker" x:Load="{x:Bind HasPresetPicker, Mode=OneTime}" x:Uid="GameDiscovery_SettingsPicker"
                            ItemsSource="{x:Bind Presets, Mode=OneTime}" SelectedItem="{x:Bind SelectedPreset, Mode=TwoWay}"
                            DisplayMemberPath="Name" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DiscoveryPreset"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ResourceRow" x:DataType="vm:GameDiscoveryResourceItem">
            <Grid ColumnSpacing="12" Padding="12,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneTime}"
                    MinWidth="0" VerticalAlignment="Top" AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"/>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind Name, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind Expression, Mode=OneTime}" TextWrapping="Wrap" FontFamily="Consolas" IsTextSelectionEnabled="True"/>
                    <TextBlock Text="{x:Bind PathSummary, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                        Visibility="{x:Bind PathSummary, Mode=OneTime, Converter={StaticResource StringNullOrEmptyToVisConverter}}"/>
                    <TextBlock Text="{x:Bind SupportText, Mode=OneTime}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                        Visibility="{x:Bind SupportText, Mode=OneTime, Converter={StaticResource StringNullOrEmptyToVisConverter}}"/>
                </StackPanel>
                <Button Grid.Column="2" x:Uid="GameDiscovery_ResourceActions" AutomationProperties.AutomationId="DiscoveryResourceActions" Tag="{x:Bind Mode=OneTime}" Click="OnResourceActionsClick"
                    VerticalAlignment="Top" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE712;" FontSize="16"/>
                </Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DraftRow" x:DataType="vm:GameDiscoveryDraftItem">
            <Border Style="{StaticResource OutlinedCardStyle}" Margin="0,8,0,4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0"
                        AutomationProperties.Name="{x:Bind ConfigName, Mode=OneWay}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBox x:Uid="GameDiscovery_DraftName" Text="{x:Bind ConfigName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="{x:Bind IsExistingConfiguration, Mode=OneTime}"/>
                        <TextBox x:Uid="GameDiscovery_DraftDestination" Text="{x:Bind DestinationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="{x:Bind IsExistingConfiguration, Mode=OneTime}"/>
                        <TextBlock Text="{x:Bind Reconciliation, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind Issues, Mode=OneTime}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ChangeRow" x:DataType="models:DiscoverySourceChange">
            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsActionable, Mode=OneTime}"
                AutomationProperties.Name="{x:Bind NormalizedRootPath, Mode=OneTime}" Margin="16,4">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Kind, Mode=OneTime}"/>
                    <TextBlock Text="{x:Bind NormalizedRootPath, Mode=OneTime}" TextWrapping="Wrap" FontFamily="Consolas"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
        <local:GameDiscoveryRowTemplateSelector x:Key="RowTemplates" SetTemplate="{StaticResource SetRow}"
            ResourceTemplate="{StaticResource ResourceRow}" DraftTemplate="{StaticResource DraftRow}" ChangeTemplate="{StaticResource ChangeRow}"/>
    </Page.Resources>
    <SplitView x:Name="RulesSplitView" DisplayMode="Overlay" PanePlacement="Right" OpenPaneLength="420"
        PaneOpened="OnRulesPaneOpened">
        <SplitView.Pane>
            <Grid x:Name="RulesPane" x:Load="False" Padding="20" RowSpacing="16" KeyDown="OnRulesPaneKeyDown">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="GameDiscovery_RulesHeading" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="CloseRulesButton" x:Uid="GameDiscovery_CloseRules" AutomationProperties.AutomationId="DiscoveryCloseRules" Click="OnCloseRulesClick" Width="32" Height="32" Padding="0">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Padding="0,0,4,12">
                        <TextBlock x:Uid="GameDiscovery_DataHelp" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.CacheStatus, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <Button x:Uid="GameDiscoveryPage_DownloadAndScan" Click="OnDownloadAndScanClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                            <Button x:Uid="GameDiscoveryPage_CheckUpdate" Click="OnDownloadAndScanClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                            <Button x:Uid="GameDiscoveryPage_ImportManifest" Click="OnImportManifestClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                        </StackPanel>
                        <TextBox x:Uid="GameDiscovery_SecondaryInput" Text="{x:Bind ViewModel.SecondaryManifestPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                        <Button x:Uid="Common_Browse" Click="OnBrowseSecondaryClick" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                        <TextBox x:Uid="GameDiscovery_OverrideInput" Text="{x:Bind ViewModel.OverridePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                        <Button x:Uid="Common_Browse" Click="OnBrowseOverrideClick" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                        <Expander x:Uid="GameDiscoveryPage_LibraryRoots" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.LibraryRoots, Mode=OneTime}">
                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:GameLibraryRootSetting">
                                        <StackPanel Spacing="4" Margin="0,4">
                                            <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" Header="{x:Bind Store, Mode=OneTime}" AutomationProperties.Name="{x:Bind Path, Mode=OneTime}"/>
                                            <TextBox Text="{x:Bind Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{x:Bind IsAutoDetected, Mode=OneTime}" AutomationProperties.Name="{x:Bind Path, Mode=OneTime}"/>
                                            <Button x:Uid="GameDiscoveryPage_DeleteRoot" Tag="{x:Bind Mode=OneTime}" Click="OnRemoveRootClick"
                                                Visibility="{x:Bind IsAutoDetected, Mode=OneTime, Converter={StaticResource BoolToVisInvertConverter}}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Uid="GameDiscoveryPage_AddSteamRoot" Click="OnAddSteamRootClick"/>
                                <Button x:Uid="GameDiscoveryPage_AddGogRoot" Click="OnAddGogRootClick"/>
                                <Button x:Uid="GameDiscoveryPage_AddEpicRoot" Click="OnAddEpicRootClick"/>
                                <Button x:Uid="GameDiscoveryPage_SaveRoots" Click="OnSaveSettingsClick"/>
                            </StackPanel>
                        </Expander>
                        <HyperlinkButton x:Uid="GameDiscoveryPage_LudusaviSource" NavigateUri="https://github.com/mtkennerly/ludusavi-manifest" HorizontalAlignment="Left"/>
                        <HyperlinkButton x:Uid="GameDiscoveryPage_PcgwNotice" NavigateUri="https://www.pcgamingwiki.com/wiki/PCGamingWiki:Disclaimer" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </SplitView.Pane>
        <Grid x:Name="PageLayout" Padding="24" RowSpacing="12" SizeChanged="OnPageSizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="GameDiscoveryPage_Title" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" x:Name="RulesButton" x:Uid="GameDiscovery_RulesButton" AutomationProperties.AutomationId="DiscoveryRules" Click="OnOpenRulesClick" VerticalAlignment="Top"
                        Visibility="{x:Bind ViewModel.IsFullMachineMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                </Grid>
                <Grid x:Name="FilterToolbar" x:Load="{x:Bind ViewModel.IsStandardDiscoveryMode, Mode=OneWay}" ColumnSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SearchColumn" Width="*"/>
                        <ColumnDefinition x:Name="StoreColumn" Width="150"/>
                        <ColumnDefinition x:Name="StatusColumn" Width="190"/>
                        <ColumnDefinition x:Name="ActionsColumn" Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" x:Uid="GameDiscovery_SearchCompact" TextChanged="OnFilterChanged" AutomationProperties.AutomationId="DiscoverySearch"/>
                    <ComboBox x:Name="StoreFilter" Grid.Column="1" x:Uid="GameDiscovery_StoreCompact" AutomationProperties.AutomationId="DiscoveryStoreFilter" SelectedIndex="0" SelectionChanged="OnFilterChanged" HorizontalAlignment="Stretch">
                        <ComboBoxItem x:Uid="GameDiscoveryPage_FilterAllStores" Tag="All"/>
                        <ComboBoxItem Content="Steam" Tag="Steam"/><ComboBoxItem Content="GOG" Tag="Gog"/><ComboBoxItem Content="Epic" Tag="Epic"/>
                    </ComboBox>
                    <ComboBox x:Name="StatusFilter" Grid.Column="2" x:Uid="GameDiscovery_StatusCompact" AutomationProperties.AutomationId="DiscoveryStatusFilter" SelectedIndex="0" SelectionChanged="OnFilterChanged" HorizontalAlignment="Stretch">
                        <ComboBoxItem x:Uid="GameDiscoveryPage_FilterAllStatus" Tag="All"/>
                        <ComboBoxItem x:Uid="GameDiscoveryPage_FilterNew" Tag="New"/>
                        <ComboBoxItem x:Uid="GameDiscoveryPage_FilterNewResources" Tag="NewResources"/>
                        <ComboBoxItem x:Uid="GameDiscoveryPage_FilterUpToDate" Tag="UpToDate"/>
                    </ComboBox>
                    <StackPanel x:Name="ToolbarActions" Grid.Column="3" Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="GameDiscoveryPage_Scan" AutomationProperties.AutomationId="DiscoveryScan" Click="OnScanClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"/>
                        <Button x:Uid="GameDiscoveryPage_Cancel" Click="OnCancelClick" IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="PluginSummary" x:Load="{x:Bind ViewModel.IsPluginBatchMode, Mode=OneWay}" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.PluginBatchPluginName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.PluginBatchKindName, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.PluginBatchRoot, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <Button x:Uid="GameDiscovery_PluginBatch_DiscoverKnown" Click="OnPluginKnownLocationsClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" HorizontalAlignment="Left"/>
                    <Button x:Uid="GameDiscovery_PluginBatch_PickRoot" Click="OnPluginPickRootClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" HorizontalAlignment="Left"/>
                    <Button x:Uid="GameDiscoveryPage_Cancel" Click="OnCancelClick" IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}" HorizontalAlignment="Left"/>
                    <InfoBar IsOpen="{x:Bind ViewModel.HasPluginBatchFatalMessage, Mode=OneWay}" Message="{x:Bind ViewModel.PluginBatchFatalMessage, Mode=OneWay}" Severity="Error" IsClosable="False"/>
                    <TextBlock Text="{x:Bind ViewModel.PluginBatchSummary, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ProgressText, Mode=OneWay, Converter={StaticResource StringNullOrEmptyToVisConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ResultSummary, Mode=OneWay, Converter={StaticResource StringNullOrEmptyToVisConverter}}"/>
            </StackPanel>
            <Grid x:Name="ResultsLayout" Grid.Row="1" ColumnSpacing="12"
                Visibility="{x:Bind ViewModel.ShowResults, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                IsHitTestVisible="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="GameColumn" Width="260"/><ColumnDefinition x:Name="DetailColumn" Width="*"/></Grid.ColumnDefinitions>
                <Grid x:Name="GamesPane">
                    <ListView x:Name="GameList" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.VisibleGames, Mode=OneTime}" SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}"
                        SelectionChanged="OnGameSelectionChanged" ItemContainerStyle="{StaticResource DiscoveryRowStyle}" AutomationProperties.AutomationId="DiscoveryGames"
                        ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:GameDiscoveryCandidateItem">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox IsThreeState="True" IsChecked="{x:Bind SelectionState, Mode=OneWay}" IsEnabled="{x:Bind CanSelect, Mode=OneTime}"
                                    Tag="{x:Bind Mode=OneTime}" Click="OnGameSelectionClick" MinWidth="0" AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"/>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind Name, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind Stores, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                        Visibility="{x:Bind Stores, Mode=OneTime, Converter={StaticResource StringNullOrEmptyToVisConverter}}"/>
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Bind ViewModel.EmptyResultsText, Mode=OneWay}" TextWrapping="Wrap" Margin="8"
                        Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisInvertConverter}}"/>
                </Grid>
                <Grid x:Name="DetailPane" Grid.Column="1" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <Button x:Name="BackToGames" x:Uid="GameDiscovery_BackToGames" Click="OnBackToGamesClick" HorizontalAlignment="Left" Visibility="Collapsed"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedGameName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedGameNotes, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.SelectedGameNotes, Mode=OneWay, Converter={StaticResource StringNullOrEmptyToVisConverter}}"/>
                        <TextBlock x:Uid="GameDiscovery_SelectGame" Visibility="{x:Bind ViewModel.HasSelectedGame, Mode=OneWay, Converter={StaticResource BoolToVisInvertConverter}}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListView Grid.Row="1" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.SelectedGameDetailRows, Mode=OneWay}" ItemTemplateSelector="{StaticResource RowTemplates}"
                        SelectionMode="None" ItemContainerStyle="{StaticResource DiscoveryRowStyle}" AutomationProperties.AutomationId="DiscoveryResources"
                        ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.HasDrafts, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Uid="GameDiscoveryPage_ConfirmHeading" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <ListView Grid.Row="1" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.ReviewRows, Mode=OneTime}" ItemTemplateSelector="{StaticResource RowTemplates}" SelectionMode="None"
                    ItemContainerStyle="{StaticResource DiscoveryRowStyle}" AutomationProperties.AutomationId="DiscoveryReview"
                    ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
            <ListView x:Name="PluginResults" x:Load="{x:Bind ViewModel.IsPluginBatchMode, Mode=OneWay}" Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.PluginBatchItems, Mode=OneTime}" SelectionMode="None" ItemContainerStyle="{StaticResource DiscoveryRowStyle}">
                <ListView.ItemTemplate><DataTemplate x:DataType="discovery:PluginBatchCreationSummaryItem">
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ConfigName, Mode=OneTime}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ConfigName, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind KindName, Mode=OneTime}"/>
                            <TextBlock Text="{x:Bind SourceSummary, Mode=OneTime}" TextWrapping="Wrap" FontFamily="Consolas"/>
                            <TextBlock Text="{x:Bind DestinationPath, Mode=OneTime}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel Spacing="8">
                    <Grid x:Name="StandardFooter" x:Load="{x:Bind ViewModel.IsStandardDiscoveryMode, Mode=OneWay}" ColumnSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="FooterSummary" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.HiddenSelectionSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind ViewModel.HiddenSelectionSummary, Mode=OneWay, Converter={StaticResource StringNullOrEmptyToVisConverter}}"/>
                        </StackPanel>
                        <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Uid="GameDiscovery_BackToResults" Click="OnBackToResultsClick" Visibility="{x:Bind ViewModel.HasDrafts, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                            <Button x:Uid="GameDiscovery_Next" Click="OnReviewClick" IsEnabled="{x:Bind ViewModel.CanReview, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowResults, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="{x:Bind ViewModel.CommitLabel, Mode=OneWay}" Click="OnCommitClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasDrafts, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="PluginFooter" x:Load="{x:Bind ViewModel.IsPluginBatchMode, Mode=OneWay}" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.PluginBatchSkippedSummary, Mode=OneWay}" TextWrapping="Wrap"/>
                        <CheckBox x:Uid="GameDiscovery_PluginBatch_BroadRootConfirm" IsChecked="{x:Bind ViewModel.IsPluginBatchBroadRootConfirmed, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.RequiresPluginBatchBroadRootConfirmation, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                        <TextBlock Text="{x:Bind ViewModel.PluginBatchBroadRootSummary, Mode=OneWay}" TextWrapping="Wrap"/>
                        <Button Content="{x:Bind ViewModel.PluginBatchCommitLabel, Mode=OneWay}" Click="OnPluginBatchCommitClick" IsEnabled="{x:Bind ViewModel.CanCommitPluginBatch, Mode=OneWay}"
                            HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </SplitView>
</Page>
