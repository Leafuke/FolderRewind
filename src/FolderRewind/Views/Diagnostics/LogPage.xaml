<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FolderRewind.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FolderRewind.Models"
    xmlns:local="using:FolderRewind.Views"
    xmlns:controls="using:FolderRewind.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="LogPage"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <Thickness x:Key="LogCardPadding">12,12,12,12</Thickness>
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" local:PageLayout.ResponsivePadding="True" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock x:Uid="LogPage_Title" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock x:Uid="LogPage_Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <InfoBar x:Name="OperationFilterNotice" x:Uid="NotificationCenter_LogFilter" IsOpen="False" IsClosable="False" Severity="Informational">
                <InfoBar.ActionButton><Button x:Uid="NotificationCenter_ShowAllLogs" Click="OnClearOperationFilter" AutomationProperties.AutomationId="NotificationShowAllLogs"/></InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
        <Grid x:Name="LogToolbar" Grid.Row="1" ColumnSpacing="12" RowSpacing="8" SizeChanged="OnToolbarSizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="LevelFilter" x:Uid="LogPage_LevelFilter" AutomationProperties.AutomationId="LogLevelFilter" MinWidth="120" MaxWidth="240" VerticalAlignment="Center" SelectionChanged="OnLevelChanged" SelectedIndex="0">
                    <ComboBoxItem x:Uid="LogPage_Level_All" Tag="All"/><ComboBoxItem x:Uid="LogPage_Level_Info" Tag="Info"/>
                    <ComboBoxItem x:Uid="LogPage_Level_Warning" Tag="Warning"/><ComboBoxItem x:Uid="LogPage_Level_Error" Tag="Error"/><ComboBoxItem x:Uid="LogPage_Level_Debug" Tag="Debug"/>
                </ComboBox>
                <TextBox Grid.Column="1" x:Name="SearchBox" x:Uid="LogPage_SearchBox" AutomationProperties.AutomationId="LogSearch" TextChanged="OnKeywordChanged" MaxWidth="360" HorizontalAlignment="Left" VerticalAlignment="Center" Width="320"/>
            </Grid>
            <CommandBar x:Name="LogCommands" Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsOpen="False" HorizontalAlignment="Right">
                <AppBarButton x:Uid="LogCommands_Display" Icon="Setting" AutomationProperties.AutomationId="LogDisplayOptions">
                    <AppBarButton.Flyout><Flyout><StackPanel Spacing="12">
                        <TextBlock x:Name="LiveRefreshLabel" x:Uid="LogPage_LiveRefresh"/>
                        <ToggleSwitch x:Name="LiveToggle" AutomationProperties.AutomationId="LogLiveRefresh" AutomationProperties.LabeledBy="{x:Bind LiveRefreshLabel, Mode=OneTime}" IsOn="True" Toggled="OnLiveToggled" OnContent="" OffContent=""/>
                        <TextBlock x:Name="AutoScrollLabel" x:Uid="LogPage_AutoScroll"/>
                        <ToggleSwitch x:Name="AutoScrollToggle" AutomationProperties.AutomationId="LogAutoScroll" AutomationProperties.LabeledBy="{x:Bind AutoScrollLabel, Mode=OneTime}" IsOn="True" OnContent="" OffContent=""/>
                    </StackPanel></Flyout></AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Uid="LogCommands_Copy" Icon="Copy" Click="OnCopyClick" AutomationProperties.AutomationId="LogCopySelected"/>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Uid="LogCommands_OpenFolder" Icon="OpenFile" Click="OnOpenFolderClick" AutomationProperties.AutomationId="LogOpenFolder"/>
                    <AppBarButton x:Uid="LogCommands_OpenFile" Icon="Document" Click="OnOpenFileClick" AutomationProperties.AutomationId="LogOpenCurrentFile"/>
                    <AppBarSeparator/>
                    <AppBarButton x:Uid="LogCommands_Clear" Icon="Delete" Click="OnClearClick" AutomationProperties.AutomationId="LogClear"/>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>
        <Grid Grid.Row="2">
            <ListView x:Name="LogList"
                      AutomationProperties.AutomationId="LogEntries"
                      ItemsSource="{x:Bind FilteredEntries, Mode=OneWay}"
                      SelectionMode="Extended"
                      IsMultiSelectCheckBoxEnabled="True"
                      IsItemClickEnabled="False"
                      Padding="0,0,0,20">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LogEntry">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                Padding="{StaticResource LogCardPadding}">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" Grid.ColumnSpan="2">
                                    <TextBlock Text="{x:Bind Timestamp, Mode=OneTime}" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <controls:LogLevelPresenter Level="{x:Bind Level, Mode=OneTime}" />
                                    <TextBlock Text="{x:Bind Source, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Message, Mode=OneTime}" TextWrapping="WrapWholeWords" Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind Exception, Mode=OneTime}" TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind Exception, Converter={StaticResource StringNullOrEmptyToVisConverter}, Mode=OneTime}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <TextBlock Grid.Row="3" x:Uid="LogPage_BottomHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
