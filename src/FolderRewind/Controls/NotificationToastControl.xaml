<UserControl x:Class="FolderRewind.Controls.NotificationToastControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FolderRewind.Controls">
    <Border Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}"
            BackgroundSizing="InnerBorderEdge" Padding="12" Translation="0,0,16">
        <!-- The rounded surface owns the shadow; the outer UserControl is rectangular. -->
        <Border.Shadow><ThemeShadow x:Name="ToastShadow"/></Border.Shadow>
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <controls:NotificationStatusIcon x:Name="StatusIcon" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" x:Uid="NotificationUI_CloseToast" Style="{StaticResource TransparentIconButtonStyle}"
                                Padding="4" Width="28" Height="28" MinWidth="28" MinHeight="28" VerticalAlignment="Top" Click="OnClose"
                                AutomationProperties.AutomationId="NotificationToastClose">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ProjectText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <HyperlinkButton x:Name="ActionButton" Padding="0,4" HorizontalAlignment="Left" Click="OnAction" AutomationProperties.AutomationId="NotificationToastAction"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
