<UserControl x:Class="FolderRewind.Controls.NotificationToastControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FolderRewind.Controls">
    <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Padding="16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <controls:NotificationStatusIcon x:Name="StatusIcon" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ProjectText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <HyperlinkButton x:Name="ActionButton" Padding="0,4" Click="OnAction" AutomationProperties.AutomationId="NotificationToastAction"/>
                </StackPanel>
                <Button Grid.Column="2" x:Uid="NotificationUI_CloseToast" Padding="4" Width="28" Height="28" VerticalAlignment="Top" Click="OnClose"
                        Background="{ThemeResource ControlFillColorTransparentBrush}" BorderBrush="{ThemeResource ControlFillColorTransparentBrush}" AutomationProperties.AutomationId="NotificationToastClose">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
