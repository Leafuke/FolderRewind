<UserControl
    x:Class="FolderRewind.Controls.HistoryTimelineMarker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" UseLayoutRounding="True" AutomationProperties.AccessibilityView="Raw">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <x:Double x:Key="TimelineLineWidth">2</x:Double>
                    <x:Double x:Key="TimelineLineOpacity">1</x:Double>
                    <x:Double x:Key="TimelineNodeStroke">1.5</x:Double>
                    <StaticResource x:Key="TimelineLineBrush" ResourceKey="TextFillColorTertiaryBrush"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <x:Double x:Key="TimelineLineWidth">2</x:Double>
                    <x:Double x:Key="TimelineLineOpacity">1</x:Double>
                    <x:Double x:Key="TimelineNodeStroke">1.5</x:Double>
                    <StaticResource x:Key="TimelineLineBrush" ResourceKey="TextFillColorTertiaryBrush"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <x:Double x:Key="TimelineLineWidth">2</x:Double>
                    <x:Double x:Key="TimelineLineOpacity">1</x:Double>
                    <x:Double x:Key="TimelineNodeStroke">2</x:Double>
                    <SolidColorBrush x:Key="TimelineLineBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Keep one unrounded logical center for the line, ring and center dot. -->
    <Grid Width="16" HorizontalAlignment="Center" UseLayoutRounding="False">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SemanticStates">
                <VisualState x:Name="Neutral"><VisualState.Setters><Setter Target="Node.Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Target="CenterDot.Fill" Value="{ThemeResource TextFillColorSecondaryBrush}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Info"><VisualState.Setters><Setter Target="Node.Stroke" Value="{ThemeResource SystemControlForegroundAccentBrush}"/><Setter Target="CenterDot.Fill" Value="{ThemeResource SystemControlForegroundAccentBrush}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Success"><VisualState.Setters><Setter Target="Node.Stroke" Value="{ThemeResource SystemFillColorSuccessBrush}"/><Setter Target="CenterDot.Fill" Value="{ThemeResource SystemFillColorSuccessBrush}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Warning"><VisualState.Setters><Setter Target="Node.Stroke" Value="{ThemeResource SystemFillColorCautionBrush}"/><Setter Target="CenterDot.Fill" Value="{ThemeResource SystemFillColorCautionBrush}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Error"><VisualState.Setters><Setter Target="Node.Stroke" Value="{ThemeResource SystemFillColorCriticalBrush}"/><Setter Target="CenterDot.Fill" Value="{ThemeResource SystemFillColorCriticalBrush}"/></VisualState.Setters></VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Rectangle Width="{ThemeResource TimelineLineWidth}" Opacity="{ThemeResource TimelineLineOpacity}" UseLayoutRounding="False"
                   Fill="{ThemeResource TimelineLineBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
        <Ellipse x:Name="Node" Width="12" Height="12" StrokeThickness="{ThemeResource TimelineNodeStroke}" UseLayoutRounding="False"
                 Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                 Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse x:Name="CenterDot" Width="4" Height="4" UseLayoutRounding="False" Fill="{ThemeResource TextFillColorSecondaryBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
