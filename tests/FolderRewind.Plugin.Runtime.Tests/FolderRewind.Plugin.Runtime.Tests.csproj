<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fixtures\**\*.cs" />
    <ProjectReference Include="../../src/FolderRewind.Plugin.Runtime/FolderRewind.Plugin.Runtime.csproj" />
    <ProjectReference Include="Fixtures/HostBridge/HostBridge.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Fixtures/PluginBase/PluginBase.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Fixtures/PluginOne/PluginOne.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Fixtures/PluginTwo/PluginTwo.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
