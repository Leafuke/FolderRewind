<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>AnyCPU</Platforms>
    <DefineConstants>$(DefineConstants);UI_ACCEPTANCE_CRITERIA_TEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>

    <None Update="Fixtures\AppUpdate\*.json" CopyToOutputDirectory="PreserveNewest" />

    <None Update="Fixtures\Legacy182\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\Legacy196\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FolderRewind.Plugin.Abstractions/FolderRewind.Plugin.Abstractions.csproj" />
    <ProjectReference Include="../../src/FolderRewind.Plugin.Runtime/FolderRewind.Plugin.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="ValveKeyValue" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FolderRewind.Core/FolderRewind.Core.csproj" />
    <ProjectReference Include="../../tools/HistoryGraphProbe/HistoryGraphProbe.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="FolderRewindFaultInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FolderRewind.TestSupport/FolderRewind.TestSupport.csproj" />
  </ItemGroup>
  <Import Project="HostSourceLinks.props" />
  <Target Name="CopyHistoryGraphProbe" AfterTargets="Build">
    <MSBuild Projects="../../tools/HistoryGraphProbe/HistoryGraphProbe.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="FolderRewindFaultInjection">
      <Output TaskParameter="TargetOutputs" ItemName="_HistoryGraphProbeTarget" />
    </MSBuild>
    <PropertyGroup>
      <_HistoryGraphProbeOutputDirectory>@(_HistoryGraphProbeTarget->'%(RootDir)%(Directory)')</_HistoryGraphProbeOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_HistoryGraphProbeFiles Include="$(_HistoryGraphProbeOutputDirectory)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HistoryGraphProbeFiles)"
          DestinationFiles="@(_HistoryGraphProbeFiles->'$(OutDir)HistoryGraphProbe\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
