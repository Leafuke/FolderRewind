<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject><Platforms>AnyCPU</Platforms></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FolderRewind.Core/FolderRewind.Core.csproj" />
    <ProjectReference Include="../FolderRewind.TestSupport/FolderRewind.TestSupport.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
  <Target Name="RequireFaultInjectionBuild" BeforeTargets="CoreCompile">
    <Error Condition="'$(FolderRewindFaultInjection)' != 'true'" Text="Run recovery acceptance with -p:FolderRewindFaultInjection=true to isolate test hooks and outputs." />
  </Target>
</Project>
