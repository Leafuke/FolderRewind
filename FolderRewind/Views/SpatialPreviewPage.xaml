<Page
    x:Class="FolderRewind.Views.SpatialPreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FolderRewind.ViewModels"
    xmlns:controls="using:FolderRewind.Controls">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid x:Name="Toolbar" Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="LayerControls" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.LayerLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                <ComboBox x:Name="Layers" MinWidth="112" MaxWidth="180" HorizontalContentAlignment="Stretch"
                          AutomationProperties.AutomationId="PreviewLayers" AutomationProperties.Name="{x:Bind ViewModel.LayerLabel, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.Layers, Mode=OneWay}" SelectionChanged="OnLayerChanged">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PreviewLayerChoice">
                        <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}"/>
                    </DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                </StackPanel>
                <StackPanel x:Name="ModeControls" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="Preview_ViewModeLabel" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ModeSelector" MinWidth="96" MaxWidth="160" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.Modes, Mode=OneWay}"
                              SelectionChanged="OnModeChanged" x:Uid="Preview_ViewMode" AutomationProperties.AutomationId="PreviewViewMode">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PreviewModeChoice"><TextBlock Text="{x:Bind Name, Mode=OneTime}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="ActionControls" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <SplitButton x:Name="NavigateButton" Content="{x:Bind ViewModel.NavigationLabel, Mode=OneWay}"
                             AutomationProperties.AutomationId="PreviewNavigate" AutomationProperties.Name="{x:Bind ViewModel.NavigationLabel, Mode=OneWay}" Click="OnQuickNavigate">
                    <SplitButton.Flyout>
                        <Flyout x:Name="NavigationFlyout">
                            <StackPanel Spacing="8" Width="304">
                                <TextBlock Text="{x:Bind ViewModel.NavigationStatus, Mode=OneWay}" TextWrapping="Wrap"/>
                                <ListView ItemsSource="{x:Bind ViewModel.Targets, Mode=OneWay}" MaxHeight="360" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTargetClicked"
                                          AutomationProperties.AutomationId="PreviewTargets" AutomationProperties.Name="{x:Bind ViewModel.NavigationLabel, Mode=OneWay}">
                                    <ListView.ItemTemplate><DataTemplate x:DataType="vm:PreviewTargetChoice">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}"/>
                                            <TextBlock Text="{x:Bind Description, Mode=OneTime}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                                        </StackPanel>
                                    </DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </SplitButton.Flyout>
                </SplitButton>
            <Button x:Uid="Preview_CoordinatesButton" AutomationProperties.AutomationId="PreviewCoordinates">
                <Button.Flyout>
                    <Flyout x:Name="CoordinateFlyout" Opening="OnCoordinateOpening">
                        <StackPanel Width="224" Spacing="12">
                            <NumberBox x:Name="CoordinateX" Header="{x:Bind ViewModel.HorizontalAxis, Mode=OneWay}" AutomationProperties.AutomationId="PreviewCoordinateX" Minimum="-1000000000" Maximum="1000000000"/>
                            <NumberBox x:Name="CoordinateY" Header="{x:Bind ViewModel.VerticalAxis, Mode=OneWay}" AutomationProperties.AutomationId="PreviewCoordinateY" Minimum="-1000000000" Maximum="1000000000"/>
                            <TextBlock x:Name="CoordinateRange" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock x:Name="CoordinateError" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Uid="Preview_Locate" HorizontalAlignment="Right" AutomationProperties.AutomationId="PreviewLocate" Click="OnLocate"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Uid="Preview_RefreshButton" AutomationProperties.AutomationId="PreviewRefresh" Click="OnRefresh"/>
                <Button x:Uid="Preview_OptionsButton" AutomationProperties.AutomationId="PreviewDisplay">
                    <Button.Flyout><Flyout><StackPanel Width="272" Spacing="12">
                        <ToggleSwitch x:Name="GridToggle" x:Uid="Preview_Grid" AutomationProperties.AutomationId="PreviewGrid" Toggled="OnGridToggled"/>
                        <TextBlock x:Uid="Preview_Help" TextWrapping="Wrap"/>
                    </StackPanel></Flyout></Button.Flyout>
                </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="4">
            <Button x:Name="CancelPreparationButton" x:Load="{x:Bind ViewModel.IsPreparing, Mode=OneWay}" x:Uid="Preview_HistoryCancel"
                    AutomationProperties.AutomationId="PreviewCancelPreparation" Click="OnCancelPreparation"/>
            <Button x:Name="DownloadHistoryButton" x:Load="{x:Bind ViewModel.NeedsHistoryDownload, Mode=OneWay}" x:Uid="Preview_HistoryDownloadLink"
                    AutomationProperties.AutomationId="PreviewHistoryDownload" Click="OnOpenHistory"/>
            <Expander x:Name="LoadErrorDetails" x:Load="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" x:Uid="Preview_ErrorDetails" AutomationProperties.AutomationId="PreviewErrorDetails" HorizontalAlignment="Stretch">
                <ScrollViewer MaxHeight="128" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{x:Bind ViewModel.ErrorDetails, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
            </Expander>
            <Grid x:Name="HeightControls" ColumnSpacing="12" RowSpacing="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="HeightCaption" Text="{x:Bind ViewModel.HeightLabel, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="224"/>
                <Slider x:Name="HeightSlider" Grid.Column="1" MinWidth="96" VerticalAlignment="Center" StepFrequency="1" SmallChange="1" LargeChange="16"
                        Minimum="{x:Bind ViewModel.HeightMinimum, Mode=OneWay}" Maximum="{x:Bind ViewModel.HeightMaximum, Mode=OneWay}"
                        Value="{x:Bind ViewModel.DraftHeight, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.HeightEnabled, Mode=OneWay}"
                        AutomationProperties.AutomationId="PreviewHeightSlider" AutomationProperties.Name="{x:Bind ViewModel.HeightLabel, Mode=OneWay}"
                        LostFocus="OnHeightLostFocus" KeyUp="OnHeightSliderKeyUp"/>
                <NumberBox x:Name="MaximumHeight" Grid.Column="2" Width="112" VerticalAlignment="Center" ValidationMode="Disabled" SmallChange="1" LargeChange="16"
                           Text="{x:Bind ViewModel.HeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Compact"
                           IsEnabled="{x:Bind ViewModel.HeightEnabled, Mode=OneWay}" LostFocus="OnHeightLostFocus"
                           AutomationProperties.AutomationId="PreviewHeight" AutomationProperties.Name="{x:Bind ViewModel.HeightLabel, Mode=OneWay}"/>
                <ToggleSwitch x:Name="OverlayToggle" Grid.Column="3" VerticalAlignment="Center" x:Uid="Preview_StatusOverlay"
                              AutomationProperties.AutomationId="PreviewStatusOverlay" IsOn="{x:Bind ViewModel.ShowStatusOverlay, Mode=TwoWay}" Toggled="OnOverlayToggled"/>
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.HeightError, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <SplitView x:Name="DetailLayout" Grid.Row="3" PanePlacement="Right" DisplayMode="Inline" OpenPaneLength="280" IsPaneOpen="False">
            <SplitView.Pane>
                <Grid Padding="16" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Button x:Uid="Preview_CloseDetails" HorizontalAlignment="Right" AutomationProperties.AutomationId="PreviewCloseDetails" Click="OnCloseDetails"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{x:Bind ViewModel.Details, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>
            <Grid>
                <controls:SpatialPreviewCanvas x:Name="Map" Background="{ThemeResource LayerFillColorAltBrush}" FlowDirection="LeftToRight"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Spacing="4">
                    <Button x:Name="ZoomInButton" Content="+" Width="40" AutomationProperties.AutomationId="PreviewZoomIn" Click="OnZoomIn"/>
                    <Button x:Name="ZoomOutButton" Content="−" Width="40" AutomationProperties.AutomationId="PreviewZoomOut" Click="OnZoomOut"/>
                    <Button x:Uid="Preview_Fit" AutomationProperties.AutomationId="PreviewFitMap" Click="OnFit"/>
                </StackPanel>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" IsHitTestVisible="False" Width="32" Height="32"/>
            </Grid>
        </SplitView>
        <StackPanel Grid.Row="4" Spacing="4">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.CursorText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HeightSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="ScaleLabel" Style="{StaticResource CaptionTextBlockStyle}"/>
                <Border x:Name="ScaleBar" Height="6" BorderThickness="1,0,1,1" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.LegendText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind ViewModel.StatisticsText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="PreviewStatus"
                       AutomationProperties.LiveSetting="Polite" Style="{StaticResource CaptionTextBlockStyle}"/>
        </StackPanel>
    </Grid>
</Page>
