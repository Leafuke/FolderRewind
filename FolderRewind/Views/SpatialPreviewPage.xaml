<Page
    x:Class="FolderRewind.Views.SpatialPreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FolderRewind.Controls">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Uid="Preview_Back" AutomationProperties.AutomationId="PreviewBack" Click="OnBack"/>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" x:Uid="Preview_Refresh" AutomationProperties.AutomationId="PreviewRefresh" Click="OnRefresh"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="Layers" x:Uid="Preview_Layers" AutomationProperties.AutomationId="PreviewLayers" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.Layers, Mode=OneWay}" DisplayMemberPath="Name" SelectionChanged="OnLayerChanged"/>
            <NumberBox x:Name="MaximumHeight" Grid.Column="1" Width="180" AutomationProperties.AutomationId="PreviewHeight" ValueChanged="OnHeightChanged" SpinButtonPlacementMode="Compact"/>
            <Button Grid.Column="2" x:Uid="Preview_ZoomOut" AutomationProperties.AutomationId="PreviewZoomOut" VerticalAlignment="Bottom" Click="OnZoomOut"/>
            <Button Grid.Column="3" x:Uid="Preview_ZoomIn" AutomationProperties.AutomationId="PreviewZoomIn" VerticalAlignment="Bottom" Click="OnZoomIn"/>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <NumberBox x:Name="CoordinateX" Header="{x:Bind ViewModel.HorizontalAxis, Mode=OneWay}" AutomationProperties.AutomationId="PreviewCoordinateX" Minimum="-1000000000" Maximum="1000000000" Value="0"/>
            <NumberBox x:Name="CoordinateY" Grid.Column="1" Header="{x:Bind ViewModel.VerticalAxis, Mode=OneWay}" AutomationProperties.AutomationId="PreviewCoordinateY" Minimum="-1000000000" Maximum="1000000000" Value="0"/>
            <Button Grid.Column="2" x:Uid="Preview_Locate" AutomationProperties.AutomationId="PreviewLocate" VerticalAlignment="Bottom" Click="OnLocate"/>
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="240"/></Grid.ColumnDefinitions>
            <controls:SpatialPreviewCanvas x:Name="Map" Background="{ThemeResource LayerFillColorAltBrush}" FlowDirection="LeftToRight"/>
            <ScrollViewer x:Name="DetailPane" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Preview_Help" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.Details, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="PreviewDetails"/>
                </StackPanel>
            </ScrollViewer>
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" IsHitTestVisible="False" Width="40" Height="40"/>
        </Grid>
        <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="PreviewStatus" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Page>
