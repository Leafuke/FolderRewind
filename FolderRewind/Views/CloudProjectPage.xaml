<Page x:Class="FolderRewind.Views.CloudProjectPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:FolderRewind.ViewModels">
 <ScrollViewer Padding="24"><StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Stretch">
  <TextBlock x:Uid="CloudWizard_ProjectTitle" Style="{StaticResource TitleTextBlockStyle}"/>
  <TextBlock x:Name="ProjectSummary" TextWrapping="Wrap"/>
  <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="False"/>
  <Button x:Uid="CloudWizard_ChangeConnection" Click="OnConnect"/>
  <Button x:Uid="CloudWizard_EditConnection" Click="OnEdit"/>
  <ToggleSwitch x:Name="Automatic" x:Uid="CloudWizard_Automatic" Toggled="OnAutomatic"/>
  <TextBlock x:Uid="CloudWizard_ManualHelp" TextWrapping="Wrap"/>
  <Button x:Uid="CloudSetup_LoadVersions" Click="OnLoadVersions"/>
  <ComboBox x:Uid="CloudSetup_Version_Input" ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedVersionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
  <Button x:Uid="CloudSetup_Upload" Click="OnUpload" IsEnabled="{x:Bind ViewModel.CanUpload, Mode=OneWay}"/>
  <TextBlock x:Uid="CloudWizard_JobsTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
  <ListView ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedJobIndex, Mode=TwoWay}" MaxHeight="360">
   <ListView.ItemTemplate><DataTemplate x:DataType="vm:CloudJobDisplay"><StackPanel Spacing="4"><TextBlock Text="{x:Bind Summary, Mode=OneTime}"/><TextBlock Text="{x:Bind Detail, Mode=OneTime}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate>
  </ListView>
  <Button x:Uid="CloudJob_Refresh" Click="OnRefresh"/>
  <StackPanel Visibility="{x:Bind ViewModel.HasMaintenanceIssue, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Spacing="12">
   <Button x:Uid="CloudJob_Retry" Click="OnRetry"/>
   <Button x:Uid="CloudJob_Cancel" Click="OnCancelJob"/>
   <Expander x:Uid="Diagnostics_Details" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><Button x:Uid="CloudJob_Abandon" Click="OnAbandon"/></StackPanel></Expander>
  </StackPanel>
  <Button x:Uid="CloudJob_InitializeMissing" Click="OnInitializeMissing" Visibility="{x:Bind ViewModel.CanInitializeMissingJournal, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
  <Button x:Uid="CloudWizard_OpenRecovery" Click="OnRecovery"/>
 </StackPanel></ScrollViewer>
</Page>
