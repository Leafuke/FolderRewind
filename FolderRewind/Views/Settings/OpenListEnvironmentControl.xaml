<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:FolderRewind.ViewModels" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls" x:Class="FolderRewind.Views.Settings.OpenListEnvironmentControl">
    <Expander HorizontalContentAlignment="Stretch" x:Name="EnvironmentExpander" x:Uid="OpenList_Environment" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12">
            <TextBlock x:Uid="OpenList_ManualOnlyHelp" TextWrapping="Wrap"/>
            <toolkit:SettingsCard x:Uid="OpenList_Executable" SizeChanged="OnEnvironmentCardSizeChanged">
                <TextBox x:Name="Executable" x:Uid="OpenList_Executable_Input" TextChanged="OnDraftChanged" AutomationProperties.AutomationId="OpenListExecutable"/>
            </toolkit:SettingsCard>
            <Button x:Uid="OpenList_PickExecutable" Click="OnPickExecutable" AutomationProperties.AutomationId="OpenListPickExecutable"/>
            <toolkit:SettingsCard x:Uid="OpenList_ServiceUri" SizeChanged="OnEnvironmentCardSizeChanged">
                <TextBox x:Name="ServiceUri" x:Uid="OpenList_ServiceUri_Input" TextChanged="OnDraftChanged" AutomationProperties.AutomationId="OpenListServiceUri"/>
            </toolkit:SettingsCard>
            <Expander HorizontalContentAlignment="Stretch" x:Uid="OpenList_Advanced" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <toolkit:SettingsCard x:Uid="OpenList_Working" SizeChanged="OnEnvironmentCardSizeChanged">
                        <TextBox x:Name="Working" x:Uid="OpenList_Working_Input" TextChanged="OnDraftChanged" AutomationProperties.AutomationId="OpenListWorkingDirectory"/>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="OpenList_Data" SizeChanged="OnEnvironmentCardSizeChanged">
                        <TextBox x:Name="Data" x:Uid="OpenList_Data_Input" TextChanged="OnDraftChanged" AutomationProperties.AutomationId="OpenListDataDirectory"/>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="OpenList_Config" SizeChanged="OnEnvironmentCardSizeChanged">
                        <TextBox x:Name="Config" x:Uid="OpenList_Config_Input" TextChanged="OnDraftChanged" AutomationProperties.AutomationId="OpenListConfigFile"/>
                    </toolkit:SettingsCard>
                </StackPanel>
            </Expander>
            <Button x:Uid="OpenList_Save" Click="OnSave" AutomationProperties.AutomationId="OpenListSave"/>
            <Button x:Uid="OpenList_Check" Click="OnCheck" AutomationProperties.AutomationId="OpenListCheck"/>
            <Button x:Uid="CloudSetup_OpenManagement" Click="OnOpenManagement" AutomationProperties.AutomationId="OpenListOpenManagement"/>
            <HyperlinkButton x:Uid="OpenList_ManualGuide" NavigateUri="https://doc.oplist.org/guide/installation/manual" AutomationProperties.AutomationId="OpenListManualGuide"/>
            <TextBlock x:Name="Result" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <ListView ItemsSource="{x:Bind Diagnostics, Mode=OneWay}" MaxHeight="240" SelectionMode="None" AutomationProperties.AutomationId="OpenListDiagnostics">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OnboardingDiagnosticItem">
                        <StackPanel Spacing="8" Padding="8">
                            <TextBlock Text="{x:Bind ComponentName, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind StatusText, Mode=OneTime}"/>
                            <TextBlock Text="{x:Bind Summary, Mode=OneTime}" TextWrapping="Wrap"/>
                            <Button Content="{x:Bind RepairLabel, Mode=OneTime}" Visibility="{x:Bind CanRepair, Mode=OneTime, Converter={StaticResource BoolToVisConverter}}" Tag="{x:Bind Mode=OneTime}" Click="OnRepair" AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Expander HorizontalContentAlignment="Stretch" x:Uid="Diagnostics_Details" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{x:Bind Diagnostics, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OnboardingDiagnosticItem">
                                <TextBlock Text="{x:Bind Display, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Uid="Diagnostics_Export" Click="OnExportDiagnostics" AutomationProperties.AutomationId="OpenListExportDiagnostics"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Expander>
</UserControl>
