<UserControl
    x:Class="FolderRewind.Views.Settings.DataManagementControl"
    x:DefaultBindMode="OneWay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FolderRewind.ViewModels"
    xmlns:local="using:FolderRewind.Views.Settings"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <!-- 扩展 -->
        <TextBlock x:Uid="SettingsPage_Section_Extensions" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

        <toolkit:SettingsExpander IsExpanded="False">
            <toolkit:SettingsExpander.Header>
                <TextBlock x:Uid="SettingsPage_TemplateData" AutomationProperties.AutomationId="SettingsTemplateDataHeader" Style="{StaticResource SettingsHeaderTextStyle}" />
            </toolkit:SettingsExpander.Header>
            <toolkit:SettingsExpander.Description>
                <TextBlock x:Uid="SettingsPage_TemplateDataDesc" Style="{StaticResource SettingsDescriptionStyle}" />
            </toolkit:SettingsExpander.Description>
            <toolkit:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8D2;" />
            </toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Uid="SettingsPage_ExportTemplate" AutomationProperties.AutomationId="SettingsExportTemplate" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnExportTemplateClick" />
                        <Button x:Uid="SettingsPage_ImportTemplate" AutomationProperties.AutomationId="SettingsImportTemplate" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnImportTemplateClick" />
                        <Button x:Uid="SettingsPage_BrowseOfficialTemplates" AutomationProperties.AutomationId="SettingsBrowseOfficialTemplates" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnBrowseOfficialTemplatesClick" />
                        <Button x:Uid="SettingsPage_UseTemplateShareCode" AutomationProperties.AutomationId="SettingsUseTemplateShareCode" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnUseTemplateShareCodeClick" />
                        <Button x:Uid="SettingsPage_PrepareTemplateSubmission" AutomationProperties.AutomationId="SettingsPrepareTemplateSubmission" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnPrepareTemplateSubmissionClick" />
                        <Button x:Uid="SettingsPage_ManageTemplates" AutomationProperties.AutomationId="SettingsManageTemplates" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnManageTemplatesClick" />
                    </StackPanel>
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>

        <!-- 数据迁移 -->
        <toolkit:SettingsExpander IsExpanded="False">
            <toolkit:SettingsExpander.Header>
                <TextBlock x:Uid="SettingsPage_DataMigration" AutomationProperties.AutomationId="SettingsDataMigrationHeader" Style="{StaticResource SettingsHeaderTextStyle}" />
            </toolkit:SettingsExpander.Header>
            <toolkit:SettingsExpander.Description>
                <TextBlock Text="{x:Bind Migration.Summary, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SettingsDescriptionStyle}" />
            </toolkit:SettingsExpander.Description>
            <toolkit:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8DE;" />
            </toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header><TextBlock x:Uid="Migration_DataTransferHeader" Style="{StaticResource SettingsHeaderTextStyle}" /></toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description><TextBlock x:Uid="Migration_DataTransferDescription" TextWrapping="Wrap" Style="{StaticResource SettingsDescriptionStyle}" /></toolkit:SettingsCard.Description>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ExportDataButton" x:Uid="Migration_ExportData" AutomationProperties.AutomationId="MigrationExportData" Click="OnExportDataClick" Style="{StaticResource SettingsActionRowButtonStyle}" />
                            <Button x:Name="ImportDataButton" x:Uid="Migration_ImportData" AutomationProperties.AutomationId="MigrationImportData" Click="OnImportDataClick" Style="{StaticResource SettingsActionRowButtonStyle}" />
                        </StackPanel>
                        <Button x:Name="RecoverDataButton" x:Uid="Migration_RecoverData" AutomationProperties.AutomationId="MigrationRecoverData" Click="OnRecoverDataClick" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Visibility="{x:Bind local:MigrationReviewControl.ToVisibility(Migration.ShowPanel), Mode=OneWay}" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <InfoBar x:Name="MigrationStatusBar" AutomationProperties.AutomationId="MigrationStatus" IsOpen="False" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:MigrationReviewControl.ToVisibility(Migration.ShowRestart), Mode=OneWay}">
                            <Button x:Name="RestartImportButton" x:Uid="Migration_Restart" Click="OnRestartImportClick" IsEnabled="{x:Bind Migration.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="MigrationRestart" />
                            <Button x:Name="CancelPendingButton" x:Uid="Migration_CancelPending" Click="OnCancelPendingClick" IsEnabled="{x:Bind Migration.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="MigrationCancelPending" />
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{x:Bind local:MigrationReviewControl.ToVisibility(Migration.ShowProgress), Mode=OneWay}">
                            <ProgressBar IsIndeterminate="True" />
                            <Button x:Name="CancelOperationButton" IsEnabled="{x:Bind Migration.CanCancel, Mode=OneWay}" x:Uid="Migration_CancelOperation" Click="OnCancelOperationClick" AutomationProperties.AutomationId="MigrationCancelOperation" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind Migration.Projects}" MaxHeight="320" SelectionMode="None" HorizontalContentAlignment="Stretch"
                                  Visibility="{x:Bind local:MigrationReviewControl.ToVisibility(Migration.ShowSetup), Mode=OneWay}" AutomationProperties.AutomationId="MigrationProjectStatus">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MigrationReviewItem">
                                    <StackPanel Spacing="4" Padding="0,4">
                                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Status}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Spacing="8" Visibility="{x:Bind local:MigrationReviewControl.ToVisibility(Migration.ShowSetup), Mode=OneWay}">
                            <Button x:Uid="Migration_BatchReview" Click="OnBatchReviewClick" IsEnabled="{x:Bind Migration.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="MigrationBatchReview" />
                            <Button x:Uid="Migration_BatchPaths" Click="OnBatchPathsClick" IsEnabled="{x:Bind Migration.CanOperate}"
                                    Visibility="{x:Bind local:MigrationReviewControl.ToVisibility(Migration.HasPathWork)}" AutomationProperties.AutomationId="MigrationBatchPaths" />
                            <Button x:Name="SetupProjectButton" Visibility="{x:Bind local:MigrationReviewControl.ToVisibility(Migration.HasPathWork), Mode=OneWay}" x:Uid="Migration_Setup" Click="OnSetupProjectClick" IsEnabled="{x:Bind Migration.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="MigrationSetup" />
                        </StackPanel>
                        <Button x:Uid="Migration_ReadOriginal" Click="OnReadOriginalClick" IsEnabled="{x:Bind Migration.CanOperate, Mode=OneWay}"
                                Visibility="{x:Bind local:MigrationReviewControl.ToVisibility(Migration.ShowLegacy), Mode=OneWay}" AutomationProperties.AutomationId="MigrationReadOriginal" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_ConfigData" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_ConfigDataDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ExportConfigButton" x:Uid="SettingsPage_ExportConfig" AutomationProperties.AutomationId="SettingsExportConfig" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnExportConfigClick" />
                        <Button x:Name="ImportConfigButton" x:Uid="SettingsPage_ImportConfig" AutomationProperties.AutomationId="SettingsImportConfig" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnImportConfigClick" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_HistoryData" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_HistoryDataDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ExportHistoryButton" x:Uid="SettingsPage_ExportHistory" AutomationProperties.AutomationId="SettingsExportHistory" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnExportHistoryClick" />
                        <Button x:Name="ImportHistoryButton" x:Uid="SettingsPage_ImportHistory" AutomationProperties.AutomationId="SettingsImportHistory" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnImportHistoryClick" />
                    </StackPanel>
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
    </StackPanel>
</UserControl>
