<UserControl
    x:Class="FolderRewind.Views.Settings.DataManagementControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <InfoBar x:Name="MigrationStatusBar" AutomationProperties.AutomationId="MigrationStatus" IsOpen="False" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button x:Name="RestartImportButton" AutomationProperties.AutomationId="MigrationRestart" Click="OnRestartImportClick" HorizontalAlignment="Stretch" Margin="0,0,8,8">
                <TextBlock x:Uid="Migration_Restart" TextWrapping="Wrap" />
            </Button>
            <Button x:Name="CancelPendingButton" Grid.Column="1" AutomationProperties.AutomationId="MigrationCancelPending" Click="OnCancelPendingClick" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                <TextBlock x:Uid="Migration_CancelPending" TextWrapping="Wrap" />
            </Button>
            <Button x:Name="SetupProjectButton" Grid.Row="1" AutomationProperties.AutomationId="MigrationSetup" Click="OnSetupProjectClick" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                <TextBlock x:Uid="Migration_Setup" TextWrapping="Wrap" />
            </Button>
            <Button x:Name="CancelOperationButton" Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="MigrationCancelOperation" Click="OnCancelOperationClick" HorizontalAlignment="Stretch" IsEnabled="False">
                <TextBlock x:Uid="Migration_CancelOperation" TextWrapping="Wrap" />
            </Button>
        </Grid>
        <!-- 扩展 -->
        <TextBlock x:Uid="SettingsPage_Section_Extensions" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

        <toolkit:SettingsExpander IsExpanded="False">
            <toolkit:SettingsExpander.Header>
                <TextBlock x:Uid="SettingsPage_TemplateData" AutomationProperties.AutomationId="SettingsTemplateDataHeader" Style="{StaticResource SettingsHeaderTextStyle}" />
            </toolkit:SettingsExpander.Header>
            <toolkit:SettingsExpander.Description>
                <TextBlock x:Uid="SettingsPage_TemplateDataDesc" Style="{StaticResource SettingsDescriptionStyle}" />
            </toolkit:SettingsExpander.Description>
            <toolkit:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8D2;" />
            </toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Uid="SettingsPage_ExportTemplate" AutomationProperties.AutomationId="SettingsExportTemplate" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnExportTemplateClick" />
                        <Button x:Uid="SettingsPage_ImportTemplate" AutomationProperties.AutomationId="SettingsImportTemplate" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnImportTemplateClick" />
                        <Button x:Uid="SettingsPage_BrowseOfficialTemplates" AutomationProperties.AutomationId="SettingsBrowseOfficialTemplates" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnBrowseOfficialTemplatesClick" />
                        <Button x:Uid="SettingsPage_UseTemplateShareCode" AutomationProperties.AutomationId="SettingsUseTemplateShareCode" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnUseTemplateShareCodeClick" />
                        <Button x:Uid="SettingsPage_PrepareTemplateSubmission" AutomationProperties.AutomationId="SettingsPrepareTemplateSubmission" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnPrepareTemplateSubmissionClick" />
                        <Button x:Uid="SettingsPage_ManageTemplates" AutomationProperties.AutomationId="SettingsManageTemplates" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnManageTemplatesClick" />
                    </StackPanel>
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>

        <!-- 数据迁移 -->
        <toolkit:SettingsExpander IsExpanded="False">
            <toolkit:SettingsExpander.Header>
                <TextBlock x:Uid="SettingsPage_DataMigration" AutomationProperties.AutomationId="SettingsDataMigrationHeader" Style="{StaticResource SettingsHeaderTextStyle}" />
            </toolkit:SettingsExpander.Header>
            <toolkit:SettingsExpander.Description>
                <TextBlock x:Uid="SettingsPage_DataMigrationDesc" Style="{StaticResource SettingsDescriptionStyle}" />
            </toolkit:SettingsExpander.Description>
            <toolkit:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8DE;" />
            </toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_ConfigData" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_ConfigDataDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Uid="SettingsPage_ExportConfig" AutomationProperties.AutomationId="SettingsExportConfig" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnExportConfigClick" />
                        <Button x:Name="ImportConfigButton" x:Uid="SettingsPage_ImportConfig" AutomationProperties.AutomationId="SettingsImportConfig" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnImportConfigClick" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_HistoryData" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_HistoryDataDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ExportHistoryButton" x:Uid="SettingsPage_ExportHistory" AutomationProperties.AutomationId="SettingsExportHistory" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnExportHistoryClick" />
                        <Button x:Name="ImportHistoryButton" x:Uid="SettingsPage_ImportHistory" AutomationProperties.AutomationId="SettingsImportHistory" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnImportHistoryClick" />
                    </StackPanel>
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
    </StackPanel>
</UserControl>
