<UserControl
    x:Class="FolderRewind.Views.Settings.DataManagementControl"
    x:DefaultBindMode="OneWay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FolderRewind.ViewModels"
    xmlns:local="using:FolderRewind.Views.Settings"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <!-- 扩展 -->
        <TextBlock x:Uid="SettingsPage_Section_Extensions" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

        <toolkit:SettingsExpander IsExpanded="False">
            <toolkit:SettingsExpander.Header>
                <TextBlock x:Uid="SettingsPage_TemplateData" AutomationProperties.AutomationId="SettingsTemplateDataHeader" Style="{StaticResource SettingsHeaderTextStyle}" />
            </toolkit:SettingsExpander.Header>
            <toolkit:SettingsExpander.Description>
                <TextBlock x:Uid="SettingsPage_TemplateDataDesc" Style="{StaticResource SettingsDescriptionStyle}" />
            </toolkit:SettingsExpander.Description>
            <toolkit:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8D2;" />
            </toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8" SizeChanged="OnActionRowSizeChanged">
                        <Button x:Uid="SettingsPage_BrowseOfficialTemplates" AutomationProperties.AutomationId="SettingsBrowseOfficialTemplates" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnBrowseOfficialTemplatesClick" />
                        <Button x:Uid="SettingsPage_ImportTemplate" AutomationProperties.AutomationId="SettingsImportTemplate" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnImportTemplateClick" />
                        <Button x:Uid="SettingsTemplates_More" AutomationProperties.AutomationId="SettingsTemplatesMore">
                            <FontIcon Glyph="&#xE712;"/>
                            <Button.Flyout><MenuFlyout>
                                <MenuFlyoutItem x:Uid="SettingsTemplates_ExportMenu" AutomationProperties.AutomationId="SettingsTemplatesExportMenu" Click="OnExportTemplateClick"/>
                                <MenuFlyoutItem x:Uid="SettingsTemplates_ShareCodeMenu" AutomationProperties.AutomationId="SettingsTemplatesShareCodeMenu" Click="OnUseTemplateShareCodeClick"/>
                                <MenuFlyoutItem x:Uid="SettingsTemplates_SubmitMenu" AutomationProperties.AutomationId="SettingsTemplatesSubmitMenu" Click="OnPrepareTemplateSubmissionClick"/>
                                <MenuFlyoutItem x:Uid="SettingsTemplates_ManageMenu" AutomationProperties.AutomationId="SettingsTemplatesManageMenu" Click="OnManageTemplatesClick"/>
                            </MenuFlyout></Button.Flyout>
                        </Button>
                    </StackPanel>
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>

        <!-- 数据迁移 -->
        <toolkit:SettingsExpander IsExpanded="False">
            <toolkit:SettingsExpander.Header>
                <TextBlock x:Uid="SettingsPage_DataMigration" AutomationProperties.AutomationId="SettingsDataMigrationHeader" Style="{StaticResource SettingsHeaderTextStyle}"/>
            </toolkit:SettingsExpander.Header>
            <toolkit:SettingsExpander.Description>
                <TextBlock Text="{x:Bind Migration.Summary, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SettingsDescriptionStyle}"/>
            </toolkit:SettingsExpander.Description>
            <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8DE;"/></toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="MigrationWizard_EntryDescription" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" SizeChanged="OnActionRowSizeChanged">
                            <Button x:Uid="Migration_ExportData" Click="OnExportDataClick" AutomationProperties.AutomationId="MigrationExportData"/>
                            <Button x:Uid="Migration_ImportData" Click="OnImportDataClick" AutomationProperties.AutomationId="MigrationImportData"/>
                            <Button x:Uid="MigrationWizard_Continue" Click="OnContinueMigrationClick" IsEnabled="{x:Bind Migration.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="MigrationContinue"/>
                        </StackPanel>
                        <InfoBar IsOpen="{x:Bind Migration.HasPending, Mode=OneWay}" IsClosable="False" Severity="Informational" x:Uid="MigrationWizard_PendingCard" AutomationProperties.AutomationId="MigrationPendingCard"/>
                        <InfoBar x:Name="MigrationStatusBar" IsOpen="False" AutomationProperties.AutomationId="MigrationStatus"/>
                        <Expander x:Uid="MigrationWizard_Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="MigrationAdvanced">
                            <StackPanel Spacing="12">
                                <TextBlock x:Uid="MigrationWizard_AdvancedDescription" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" SizeChanged="OnActionRowSizeChanged">
                                    <Button x:Uid="SettingsPage_ExportConfig" Click="OnExportConfigClick" AutomationProperties.AutomationId="SettingsExportConfig"/>
                                    <Button x:Uid="SettingsPage_ImportConfig" Click="OnImportConfigClick" AutomationProperties.AutomationId="SettingsImportConfig"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" SizeChanged="OnActionRowSizeChanged">
                                    <Button x:Uid="SettingsPage_ExportHistory" Click="OnExportHistoryClick" AutomationProperties.AutomationId="SettingsExportHistory"/>
                                    <Button x:Uid="SettingsPage_ImportHistory" Click="OnImportHistoryClick" AutomationProperties.AutomationId="SettingsImportHistory"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" SizeChanged="OnActionRowSizeChanged">
                                    <Button x:Uid="MigrationWizard_ExportMetadata" Click="OnExportMetadataClick" AutomationProperties.AutomationId="MigrationExportMetadata"/>
                                    <Button x:Uid="MigrationWizard_ImportMetadata" Click="OnImportMetadataClick" AutomationProperties.AutomationId="MigrationImportMetadata"/>
                                </StackPanel>
                                <Button x:Uid="Migration_ReadOriginal" Click="OnReadOriginalClick" HorizontalAlignment="Left" AutomationProperties.AutomationId="MigrationReadOriginal"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
    </StackPanel>
</UserControl>
