<UserControl
    x:Class="FolderRewind.Views.Settings.AppearanceLayoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <!-- 外观与布局 (Expander) -->
        <toolkit:SettingsExpander IsExpanded="False">
            <toolkit:SettingsExpander.Header>
                <TextBlock x:Uid="SettingsPage_Personalization" Style="{StaticResource SettingsHeaderTextStyle}" />
            </toolkit:SettingsExpander.Header>
            <toolkit:SettingsExpander.Description>
                <TextBlock x:Uid="SettingsPage_PersonalizationSectionDesc" Style="{StaticResource SettingsDescriptionStyle}" />
            </toolkit:SettingsExpander.Description>
            <toolkit:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE771;" />
            </toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_Language" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_LanguageDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <ComboBox x:Name="LanguageCombo" Style="{StaticResource SettingsSelectorStyle}" SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem x:Uid="SettingsPage_LanguageSystem" />
                        <ComboBoxItem x:Uid="SettingsPage_LanguageEnglish" />
                        <ComboBoxItem x:Uid="SettingsPage_LanguageChinese" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_AppTheme" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_AppThemeDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <ComboBox Style="{StaticResource SettingsSelectorStyle}" SelectedIndex="{x:Bind ViewModel.Settings.ThemeIndex, Mode=TwoWay}" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem x:Uid="SettingsPage_ThemeDark" />
                        <ComboBoxItem x:Uid="SettingsPage_ThemeLight" />
                        <ComboBoxItem x:Uid="SettingsPage_ThemeSystem" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_CompletionSound" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_CompletionSoundDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Style="{StaticResource SettingsSelectorStyle}"
                                  ItemsSource="{x:Bind ViewModel.CompletionSoundPresets, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.Settings.CompletionSoundIndex, Mode=OneWay}"
                                  SelectionChanged="OnCompletionSoundChanged" />
                        <Button x:Uid="SettingsPage_CompletionSoundPreview"
                                Style="{StaticResource SettingsActionRowButtonStyle}"
                                Command="{x:Bind ViewModel.PreviewCompletionSoundCommand, Mode=OneTime}" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_FontFamily" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_FontFamilyDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <ComboBox x:Name="FontFamilyCombo" Style="{StaticResource SettingsSelectorStyle}" ItemsSource="{x:Bind ViewModel.FontFamilies, Mode=OneWay}" SelectionChanged="OnFontFamilyChanged" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_FontSize" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_FontSizeDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <NumberBox x:Name="FontSizeBox" Style="{StaticResource SettingsNumberBoxStyle}" Minimum="12" Maximum="20" SmallChange="0.5" LargeChange="1" Value="{x:Bind ViewModel.Settings.BaseFontSize, Mode=TwoWay}" ValueChanged="OnFontSizeChanged" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_HistoryStatusColors" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_HistoryStatusColorsDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.UseHistoryStatusColors, Mode=OneWay}" Toggled="OnHistoryColorsToggled" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_NavPaneWidth" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_NavPaneWidthDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <NumberBox Style="{StaticResource SettingsNumberBoxStyle}" Minimum="100" Maximum="600" Value="{x:Bind ViewModel.Settings.NavPaneWidth, Mode=TwoWay}" SmallChange="10" LargeChange="50" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_StartupSize" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_StartupSizeDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <NumberBox x:Name="StartupWidthBox"
                                   Width="112"
                                   Minimum="{StaticResource StartupWidthMin}"
                                   Maximum="{StaticResource StartupWidthMax}"
                                   Value="{x:Bind ViewModel.Settings.StartupWidth, Mode=TwoWay}"
                                   ValueChanged="OnStartupSizeChanged" />
                        <TextBlock Text="×" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="StartupHeightBox"
                                   Width="112"
                                   Minimum="{StaticResource StartupHeightMin}"
                                   Maximum="{StaticResource StartupHeightMax}"
                                   Value="{x:Bind ViewModel.Settings.StartupHeight, Mode=TwoWay}"
                                   ValueChanged="OnStartupSizeChanged" />
                        <TextBlock Text="px" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Uid="SettingsPage_ApplySize" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnApplyStartupSizeClick" />
                    </StackPanel>
                </toolkit:SettingsCard>

                
                <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_Sponsor" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_SponsorDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.SponsorStatusText, Mode=OneWay}"
                                   Style="{StaticResource SettingsDescriptionStyle}" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="SettingsPage_SponsorPurchase"
                                    Style="{StaticResource SettingsActionRowButtonStyle}"
                                    Command="{x:Bind ViewModel.OpenSponsorWindowCommand, Mode=OneTime}"
                                    IsEnabled="{x:Bind ViewModel.IsSponsorOperationIdle, Mode=OneWay}" />
                            <Button x:Uid="SettingsPage_SponsorRestore"
                                    Style="{StaticResource SettingsActionRowButtonStyle}"
                                    Command="{x:Bind ViewModel.RestoreSponsorCommand, Mode=OneTime}"
                                    IsEnabled="{x:Bind ViewModel.IsSponsorOperationIdle, Mode=OneWay}" />
                            <Button x:Uid="SettingsPage_SponsorRefresh"
                                    Style="{StaticResource SettingsActionRowButtonStyle}"
                                    Command="{x:Bind ViewModel.RefreshSponsorCommand, Mode=OneTime}"
                                    IsEnabled="{x:Bind ViewModel.IsSponsorOperationIdle, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Visibility="{x:Bind ViewModel.IsSponsorLocked, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_SponsorLocked" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_SponsorLockedDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <FontIcon Glyph="&#xE72E;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </toolkit:SettingsCard>

                <!-- 赞助专属个性化 (次级 Expander) -->
                <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <toolkit:SettingsExpander IsExpanded="False"
                                            IsEnabled="{x:Bind ViewModel.IsSponsorUnlocked, Mode=OneWay}">
                        <toolkit:SettingsExpander.Header>
                            <TextBlock x:Uid="SettingsPage_SponsorPersonalization" Style="{StaticResource SettingsHeaderTextStyle}" />
                        </toolkit:SettingsExpander.Header>
                        <toolkit:SettingsExpander.Description>
                            <TextBlock x:Uid="SettingsPage_SponsorPersonalizationDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </toolkit:SettingsExpander.Description>
                        <toolkit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard>
                                <toolkit:SettingsCard.Header>
                                    <TextBlock x:Uid="SettingsPage_SponsorAccent" Style="{StaticResource SettingsHeaderTextStyle}" />
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Description>
                                    <TextBlock x:Uid="SettingsPage_SponsorAccentDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                                </toolkit:SettingsCard.Description>
                                <ComboBox Style="{StaticResource SettingsSelectorStyle}"
                                        ItemsSource="{x:Bind ViewModel.SponsorAccentPresets, Mode=OneWay}"
                                        SelectedIndex="{x:Bind ViewModel.Settings.SponsorAccentColorIndex, Mode=TwoWay}"
                                        SelectionChanged="OnSponsorAccentChanged" />
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard>
                                <toolkit:SettingsCard.Header>
                                    <TextBlock x:Uid="SettingsPage_SponsorBackdrop" Style="{StaticResource SettingsHeaderTextStyle}" />
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Description>
                                    <TextBlock x:Uid="SettingsPage_SponsorBackdropDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                                </toolkit:SettingsCard.Description>
                                <ComboBox Style="{StaticResource SettingsSelectorStyle}"
                                        ItemsSource="{x:Bind ViewModel.SponsorBackdropPresets, Mode=OneWay}"
                                        SelectedIndex="{x:Bind ViewModel.Settings.SponsorBackdropIndex, Mode=TwoWay}"
                                        SelectionChanged="OnSponsorBackdropChanged" />
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard>
                                <toolkit:SettingsCard.Header>
                                    <TextBlock x:Uid="SettingsPage_SponsorTitleText" Style="{StaticResource SettingsHeaderTextStyle}" />
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Description>
                                    <TextBlock x:Uid="SettingsPage_SponsorTitleTextDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                                </toolkit:SettingsCard.Description>
                                <TextBox Width="180"
                                        Text="{x:Bind ViewModel.Settings.SponsorTitleText, Mode=OneWay}"
                                        TextChanged="OnSponsorTitleTextChanged" />
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard>
                                <toolkit:SettingsCard.Header>
                                    <TextBlock x:Uid="SettingsPage_SponsorTitleIcon" Style="{StaticResource SettingsHeaderTextStyle}" />
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Description>
                                    <TextBlock x:Uid="SettingsPage_SponsorTitleIconDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                                </toolkit:SettingsCard.Description>
                                <ComboBox Style="{StaticResource SettingsSelectorStyle}"
                                        ItemsSource="{x:Bind ViewModel.SponsorTitleIconGlyphs, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.Settings.SponsorTitleIconGlyph, Mode=TwoWay}"
                                        SelectionChanged="OnSponsorTitleIconChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <FontIcon Glyph="{x:Bind Mode=OneTime}" FontSize="18" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard>
                                <toolkit:SettingsCard.Header>
                                    <TextBlock x:Uid="SettingsPage_SponsorBackground" Style="{StaticResource SettingsHeaderTextStyle}" />
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Description>
                                    <TextBlock x:Uid="SettingsPage_SponsorBackgroundDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                                </toolkit:SettingsCard.Description>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Uid="SettingsPage_SponsorBackgroundChoose"
                                            Style="{StaticResource SettingsActionRowButtonStyle}"
                                            Click="OnChooseSponsorBackgroundClick" />
                                    <Button x:Uid="SettingsPage_SponsorBackgroundClear"
                                            Style="{StaticResource SettingsActionRowButtonStyle}"
                                            Command="{x:Bind ViewModel.ClearSponsorBackgroundCommand, Mode=OneTime}" />
                                </StackPanel>
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard>
                                <toolkit:SettingsCard.Header>
                                    <TextBlock x:Uid="SettingsPage_SponsorBackgroundEnabled" Style="{StaticResource SettingsHeaderTextStyle}" />
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Description>
                                    <TextBlock x:Uid="SettingsPage_SponsorBackgroundEnabledDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                                </toolkit:SettingsCard.Description>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.SponsorBackgroundEnabled, Mode=OneWay}" Toggled="OnSponsorBackgroundEnabledToggled" />
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard>
                                <toolkit:SettingsCard.Header>
                                    <TextBlock x:Uid="SettingsPage_SponsorBackgroundStretch" Style="{StaticResource SettingsHeaderTextStyle}" />
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Description>
                                    <TextBlock x:Uid="SettingsPage_SponsorBackgroundStretchDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                                </toolkit:SettingsCard.Description>
                                <ComboBox Style="{StaticResource SettingsSelectorStyle}"
                                        ItemsSource="{x:Bind ViewModel.SponsorBackgroundStretchModes, Mode=OneWay}"
                                        SelectedIndex="{x:Bind ViewModel.Settings.SponsorBackgroundStretchIndex, Mode=TwoWay}"
                                        SelectionChanged="OnSponsorBackgroundStretchChanged" />
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard>
                                <toolkit:SettingsCard.Header>
                                    <TextBlock x:Uid="SettingsPage_SponsorBackgroundImageOpacity" Style="{StaticResource SettingsHeaderTextStyle}" />
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Description>
                                    <TextBlock x:Uid="SettingsPage_SponsorBackgroundImageOpacityDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                                </toolkit:SettingsCard.Description>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <NumberBox Style="{StaticResource SettingsNumberBoxStyle}"
                                            Minimum="0"
                                            Maximum="100"
                                            SmallChange="5"
                                            LargeChange="10"
                                            Value="{x:Bind ViewModel.SponsorBackgroundImageOpacityPercent, Mode=OneWay}"
                                            ValueChanged="OnSponsorBackgroundImageOpacityChanged" />
                                    <TextBlock Text="%" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard>
                                <toolkit:SettingsCard.Header>
                                    <TextBlock x:Uid="SettingsPage_SponsorBackgroundOverlayOpacity" Style="{StaticResource SettingsHeaderTextStyle}" />
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Description>
                                    <TextBlock x:Uid="SettingsPage_SponsorBackgroundOverlayOpacityDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                                </toolkit:SettingsCard.Description>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <NumberBox Style="{StaticResource SettingsNumberBoxStyle}"
                                            Minimum="0"
                                            Maximum="100"
                                            SmallChange="5"
                                            LargeChange="10"
                                            Value="{x:Bind ViewModel.SponsorBackgroundOverlayOpacityPercent, Mode=OneWay}"
                                            ValueChanged="OnSponsorBackgroundOverlayOpacityChanged" />
                                    <TextBlock Text="%" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard>
                                <toolkit:SettingsCard.Header>
                                    <TextBlock x:Uid="SettingsPage_CustomCompletionSound" Style="{StaticResource SettingsHeaderTextStyle}" />
                                </toolkit:SettingsCard.Header>
                                <toolkit:SettingsCard.Description>
                                    <TextBlock x:Uid="SettingsPage_CustomCompletionSoundDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                                </toolkit:SettingsCard.Description>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Uid="SettingsPage_CustomCompletionSoundChoose"
                                            Style="{StaticResource SettingsActionRowButtonStyle}"
                                            Click="OnChooseCustomCompletionSoundClick" />
                                    <Button x:Uid="SettingsPage_CustomCompletionSoundClear"
                                            Style="{StaticResource SettingsActionRowButtonStyle}"
                                            Command="{x:Bind ViewModel.ClearCustomCompletionSoundCommand, Mode=OneTime}" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                </toolkit:SettingsCard>

            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
    </StackPanel>
</UserControl>
