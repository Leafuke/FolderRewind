<UserControl
    x:Class="FolderRewind.Views.Settings.PluginsKnotLinkControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:FolderRewind.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <!-- 插件 -->
        <toolkit:SettingsExpander x:Name="PluginsExpander" IsExpanded="False" Expanded="OnPluginsExpanderExpanded">
            <toolkit:SettingsExpander.Header>
                <TextBlock x:Uid="SettingsPage_Plugins" Style="{StaticResource SettingsHeaderTextStyle}" />
            </toolkit:SettingsExpander.Header>
            <toolkit:SettingsExpander.Description>
                <TextBlock x:Uid="SettingsPage_PluginsSectionDesc" Style="{StaticResource SettingsDescriptionStyle}" />
            </toolkit:SettingsExpander.Description>
            <toolkit:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE943;" />
            </toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_PluginsEnabled" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_PluginsEnabledDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <ToggleSwitch x:Name="PluginsMasterSwitch" IsOn="{x:Bind ViewModel.Settings.Plugins.Enabled, Mode=TwoWay}" Toggled="OnPluginsEnabledToggled" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_PluginsAutoCheckUpdates" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_PluginsAutoCheckUpdatesDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.Plugins.AutoCheckUpdates, Mode=OneWay}" Toggled="OnPluginsAutoCheckUpdatesToggled" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" x:Uid="SettingsPage_OpenPluginStore" HorizontalAlignment="Stretch" Style="{StaticResource SettingsActionButtonStyle}" Click="OnOpenPluginStoreClick" IsEnabled="{x:Bind ViewModel.Settings.Plugins.Enabled, Mode=OneWay}" />
                        <Button Grid.Row="0" Grid.Column="1" x:Uid="SettingsPage_ManualInstallPlugin" HorizontalAlignment="Stretch" Style="{StaticResource SettingsActionButtonStyle}" Click="OnManualInstallPluginClick" IsEnabled="{x:Bind ViewModel.Settings.Plugins.Enabled, Mode=OneWay}" />
                        <Button Grid.Row="0" Grid.Column="2" x:Uid="SettingsPage_OpenPluginFolder" HorizontalAlignment="Stretch" Style="{StaticResource SettingsActionButtonStyle}" Click="OnOpenPluginFolderClick" />
                        <Button Grid.Row="1" Grid.Column="0" x:Uid="SettingsPage_RefreshPlugins" HorizontalAlignment="Stretch" Style="{StaticResource SettingsActionButtonStyle}" Click="OnRefreshPluginsClick" />
                        <Button Grid.Row="1" Grid.Column="1" x:Uid="SettingsPage_CheckPluginUpdates" HorizontalAlignment="Stretch" Style="{StaticResource SettingsActionButtonStyle}" Click="OnCheckPluginUpdatesClick" IsEnabled="{x:Bind ViewModel.Settings.Plugins.Enabled, Mode=OneWay}" />
                        <Button Grid.Row="1" Grid.Column="2" x:Uid="SettingsPage_RestartSafeMode" HorizontalAlignment="Stretch" Style="{StaticResource SettingsActionButtonStyle}" Click="OnRestartSafeModeClick" />
                    </Grid>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_InstalledPlugins" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.InstalledPlugins, Mode=OneWay}"
                                  IsEnabled="{x:Bind ViewModel.Settings.Plugins.Enabled, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:InstalledPluginInfo">
                                <Grid Padding="8,12" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource SettingsHeaderTextStyle}" />
                                            <Border Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    Visibility="{x:Bind HasUpdate, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind LatestVersion, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource SettingsDescriptionStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind Version}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Author}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Id}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind LoadError}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind LoadError, Converter={StaticResource StringNullOrEmptyToVisConverter}, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Uid="SettingsPage_PluginUpdate"
                                                Style="{StaticResource SettingsActionRowButtonStyle}"
                                                Click="OnPluginUpdateClick"
                                                Tag="{x:Bind}"
                                                Visibility="{x:Bind HasUpdate, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                                <TextBlock x:Uid="SettingsPage_PluginUpdateText" />
                                            </StackPanel>
                                        </Button>
                                        <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=OneWay}" Margin="8,0,0,0" Toggled="OnPluginEnabledToggled" />
                                        <Button x:Uid="SettingsPage_PluginSettings" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnPluginSettingsClick" Tag="{x:Bind}" />
                                        <Button x:Uid="SettingsPage_PluginUninstall" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnPluginUninstallClick" Tag="{x:Bind}" />
                                        <Button x:Uid="SettingsPage_PluginDeleteData" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnPluginDeleteDataClick" Tag="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>

        <!-- KnotLink 互联 -->
        <toolkit:SettingsExpander IsExpanded="False">
            <toolkit:SettingsExpander.Header>
                <TextBlock x:Uid="SettingsPage_KnotLink" Style="{StaticResource SettingsHeaderTextStyle}" />
            </toolkit:SettingsExpander.Header>
            <toolkit:SettingsExpander.Description>
                <TextBlock x:Uid="SettingsPage_KnotLinkSectionDesc" Style="{StaticResource SettingsDescriptionStyle}" />
            </toolkit:SettingsExpander.Description>
            <toolkit:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE968;" />
            </toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_KnotLinkEnabled" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_KnotLinkEnabledDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <ToggleSwitch x:Name="KnotLinkSwitch" IsOn="{x:Bind ViewModel.Settings.EnableKnotLink, Mode=TwoWay}" Toggled="OnKnotLinkToggled" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{x:Bind ViewModel.KnotLinkStatusColor, Mode=OneWay}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="SettingsPage_KnotLinkStatus" Style="{StaticResource SettingsHeaderTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.KnotLinkStatusMessage, Mode=OneWay}" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                    </Grid>
                </toolkit:SettingsCard>

                <!-- 服务端版本与状态 -->
                <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F8;" FontSize="16"
                                  Foreground="{x:Bind ViewModel.KnotLinkServerStatusBrush, Mode=OneWay}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Uid="SettingsPage_KnotLinkServerVersion" Style="{StaticResource SettingsHeaderTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.KnotLinkServerVersionText, Mode=OneWay}" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Uid="SettingsPage_KnotLinkStartServer"
                                    Style="{StaticResource SettingsActionRowButtonStyle}"
                                    Click="OnKnotLinkStartServerClick"
                                    Visibility="{x:Bind ViewModel.KnotLinkServerCanStart, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.Settings.EnableKnotLink, Mode=OneWay}" />
                            <Button x:Uid="SettingsPage_KnotLinkCheckServerUpdate"
                                    Style="{StaticResource SettingsActionRowButtonStyle}"
                                    Click="OnKnotLinkCheckServerUpdateClick"
                                    Visibility="{x:Bind ViewModel.KnotLinkServerInstalled, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}" />
                            <Button x:Uid="SettingsPage_KnotLinkUpdateServer"
                                    Style="{StaticResource SettingsActionRowButtonStyle}"
                                    Click="OnKnotLinkUpdateServerClick"
                                    Visibility="{x:Bind ViewModel.KnotLinkServerHasUpdate, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.KnotLinkServerUpdateEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </toolkit:SettingsCard>

                <!-- 自动启动服务端 -->
                <toolkit:SettingsCard>
                    <toolkit:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_KnotLinkAutoStart" Style="{StaticResource SettingsHeaderTextStyle}" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_KnotLinkAutoStartDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                    </toolkit:SettingsCard.Description>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.AutoStartKnotLinkServer, Mode=TwoWay}" Toggled="OnKnotLinkAutoStartToggled" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="SettingsPage_KnotLinkRestart" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnKnotLinkRestartClick" IsEnabled="{x:Bind ViewModel.Settings.EnableKnotLink, Mode=OneWay}" />
                        <Button x:Uid="SettingsPage_KnotLinkTest" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnKnotLinkTestClick" IsEnabled="{x:Bind ViewModel.Settings.EnableKnotLink, Mode=OneWay}" />
                        <Button x:Uid="SettingsPage_KnotLinkSendCustom" Style="{StaticResource SettingsActionRowButtonStyle}" Click="OnKnotLinkSendCustomClick" IsEnabled="{x:Bind ViewModel.Settings.EnableKnotLink, Mode=OneWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <toolkit:SettingsExpander x:Uid="SettingsPage_KnotLinkCommands" IsExpanded="False">
                        <toolkit:SettingsExpander.Description>
                            <TextBlock x:Uid="SettingsPage_KnotLinkCommandsDesc" Style="{StaticResource SettingsDescriptionStyle}" />
                        </toolkit:SettingsExpander.Description>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                <TextBlock x:Uid="SettingsPage_KnotLinkCommandsBody"
                                           FontFamily="Consolas"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
    </StackPanel>
</UserControl>
