<Page
    x:Class="FolderRewind.Views.MigrationWizardPage"
    x:DefaultBindMode="OneWay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FolderRewind.Views"
    xmlns:vm="using:FolderRewind.ViewModels"
    AutomationProperties.AutomationId="MigrationWizardPage">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind ViewModel.StepText}" AutomationProperties.AutomationId="MigrationWizardStep" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{x:Bind ViewModel.HasMessage}" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.Message}" AutomationProperties.AutomationId="MigrationWizardStatus"/>
            <Expander x:Uid="MigrationWizard_TechnicalDetails" HorizontalAlignment="Stretch" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.HasErrorDetails)}" AutomationProperties.AutomationId="MigrationWizardActionDetails">
                <TextBlock Text="{x:Bind ViewModel.ErrorDetails}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </Expander>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.Busy)}" AutomationProperties.AutomationId="MigrationWizardProgress"/>
        </StackPanel>
        <ContentControl Grid.Row="2" IsEnabled="{x:Bind ViewModel.CanOperate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid>
            <ListView ItemsSource="{x:Bind ViewModel.Projects}" SelectionMode="None" HorizontalContentAlignment="Stretch"
                      Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowExportProjects)}" AutomationProperties.AutomationId="MigrationWizardExportProjects">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MigrationWizardProjectItem">
                        <StackPanel Padding="8" Spacing="4">
                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind Selected, Mode=TwoWay}" AutomationProperties.AutomationId="{x:Bind ExportSelectionAutomationId}"/>
                            <TextBlock Text="{x:Bind BackupRoot}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ScrollViewer Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowExportContent)}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.ScopeText}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                <RadioButtons x:Uid="MigrationWizard_ArchiveMode" ItemsSource="{x:Bind ViewModel.ArchiveOptions}" SelectedIndex="{x:Bind ViewModel.ArchiveIndex, Mode=TwoWay}"
                              Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowArchiveOptions)}" AutomationProperties.AutomationId="MigrationWizardArchiveMode"/>
                <TextBlock Text="{x:Bind ViewModel.ContentDescription}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind ViewModel.ExternalArchiveRoots}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
            </ScrollViewer>
            <ScrollViewer Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowTransport)}" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <RadioButtons x:Uid="MigrationWizard_Location" ItemsSource="{x:Bind ViewModel.TransportOptions}" SelectedIndex="{x:Bind ViewModel.TransportIndex, Mode=TwoWay}" AutomationProperties.AutomationId="MigrationWizardLocation"/>
                    <StackPanel Spacing="8" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowLocalPackage)}">
                        <Button x:Uid="MigrationWizard_ChoosePackage" Click="OnChoosePackage" AutomationProperties.AutomationId="MigrationWizardChoosePackage" IsEnabled="{x:Bind ViewModel.CanOperate}"/>
                        <TextBlock Text="{x:Bind ViewModel.PackagePath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="MigrationWizardPackagePath"/>
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowCloud)}">
                        <ComboBox x:Uid="MigrationWizard_Connection" ItemsSource="{x:Bind ViewModel.Connections}" SelectedIndex="{x:Bind ViewModel.ConnectionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MigrationWizardConnection"/>
                        <TextBox x:Uid="MigrationWizard_RemoteRoot" Text="{x:Bind ViewModel.RemoteRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="MigrationWizardRemoteRoot"/>
                        <Button x:Uid="MigrationWizard_ManageConnections" Click="OnManageConnections" AutomationProperties.AutomationId="MigrationWizardManageConnections"/>
                        <StackPanel Spacing="8" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowCloudSnapshots)}">
                            <Button x:Uid="MigrationWizard_LoadSnapshots" Click="OnLoadSnapshots" IsEnabled="{x:Bind ViewModel.CanOperate}" AutomationProperties.AutomationId="MigrationWizardLoadSnapshots"/>
                            <ComboBox x:Uid="MigrationWizard_Snapshots" ItemsSource="{x:Bind ViewModel.Snapshots}" SelectedIndex="{x:Bind ViewModel.SnapshotIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MigrationWizardSnapshots"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ImportSummary}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowImportSelection)}" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.ImportSummary}" TextWrapping="Wrap"/>
                    <TextBlock x:Uid="MigrationWizard_KeepSource" TextWrapping="Wrap"/>
                    <CheckBox x:Uid="MigrationWizard_ImportConfiguration" IsChecked="{x:Bind ViewModel.IncludeConfiguration, Mode=TwoWay}" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowConfigurationChoice)}" AutomationProperties.AutomationId="MigrationWizardImportConfiguration"/>
                </StackPanel>
                <Expander Grid.Row="1" x:Uid="MigrationWizard_BatchPaths" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MigrationWizardBatchPaths">
                    <StackPanel Spacing="8">
                        <TextBox x:Uid="Migration_BatchOldRoot" Text="{x:Bind ViewModel.OldRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="MigrationWizardOldRoot"/>
                        <TextBox x:Uid="Migration_BatchNewRoot" Text="{x:Bind ViewModel.NewRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="MigrationWizardNewRoot"/>
                        <Button x:Uid="MigrationWizard_ApplyMapping" Click="OnApplyMapping" AutomationProperties.AutomationId="MigrationWizardApplyMapping"/>
                    </StackPanel>
                </Expander>
                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Projects}" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="MigrationWizardImportProjects">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MigrationWizardProjectItem">
                            <StackPanel Padding="8" Spacing="8">
                                <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind Selected, Mode=TwoWay}" AutomationProperties.AutomationId="{x:Bind ImportSelectionAutomationId}"/>
                                <TextBlock Text="{x:Bind Status}" TextWrapping="Wrap"/>
                                <TextBox x:Uid="MigrationWizard_BackupRoot" Text="{x:Bind BackupRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="{x:Bind BackupPathAutomationId}"/>
                                <Button x:Uid="MigrationWizard_ChooseDirectory" Tag="{x:Bind Id}" Click="OnBrowseBackupRoot" HorizontalAlignment="Left" AutomationProperties.AutomationId="{x:Bind BackupPickerAutomationId}"/>
                                <ItemsRepeater ItemsSource="{x:Bind Sources}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MigrationWizardSourceItem">
                                            <StackPanel Spacing="4" Margin="0,4">
                                                <TextBox Header="{x:Bind Name}" Text="{x:Bind Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="{x:Bind AutomationId}"/>
                                                <Button x:Uid="MigrationWizard_ChooseDirectory" Click="OnBrowseSource" HorizontalAlignment="Left" AutomationProperties.AutomationId="{x:Bind PickerAutomationId}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <ListView ItemsSource="{x:Bind ViewModel.Projects}" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowOriginalSelection)}" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="MigrationWizardOriginalProjects">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MigrationWizardProjectItem">
                        <StackPanel Padding="8" Spacing="8">
                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind Selected, Mode=TwoWay}" AutomationProperties.AutomationId="{x:Bind OriginalSelectionAutomationId}"/>
                            <CheckBox x:Uid="MigrationWizard_OriginalAutoBackup" IsChecked="{x:Bind AutoBackup, Mode=TwoWay}" AutomationProperties.AutomationId="{x:Bind BackupPermissionAutomationId}"/>
                            <CheckBox x:Uid="MigrationWizard_OriginalCloud" IsChecked="{x:Bind CloudPreference, Mode=TwoWay}" AutomationProperties.AutomationId="{x:Bind CloudPermissionAutomationId}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowRecovery)}" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <ListView ItemsSource="{x:Bind ViewModel.Projects}" MaxHeight="200" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="MigrationWizardProjectProgress">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MigrationWizardProjectItem">
                            <StackPanel Padding="8" Spacing="4">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind Status}" TextWrapping="Wrap"/>
                                <Button x:Uid="MigrationWizard_HandleProject" Click="OnHandleProject" Tag="{x:Bind Id}" Visibility="{x:Bind local:MigrationWizardPage.Visible(CanHandle)}" AutomationProperties.AutomationId="{x:Bind HandleAutomationId}"/>
                                <StackPanel Spacing="4" Visibility="{x:Bind local:MigrationWizardPage.Visible(ShowPermissions)}">
                                    <CheckBox x:Uid="MigrationWizard_AllowBackup" IsChecked="{x:Bind BackupSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelectBackup}" AutomationProperties.AutomationId="{x:Bind BackupPermissionAutomationId}"/>
                                    <CheckBox x:Uid="MigrationWizard_AllowCloud" IsChecked="{x:Bind CloudSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelectCloud}" Visibility="{x:Bind local:MigrationWizardPage.Visible(CloudEnabled)}" AutomationProperties.AutomationId="{x:Bind CloudPermissionAutomationId}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ScrollViewer Grid.Row="1" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowIssue)}" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.SelectedProjectName}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                        <Button x:Uid="MigrationWizard_AttachHistory" Click="OnAttachPackage" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowHistoryFile)}" AutomationProperties.AutomationId="MigrationWizardAttachHistory"/>
                        <StackPanel Spacing="8" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowIssuePaths)}">
                            <TextBox x:Uid="MigrationWizard_BackupRoot" Text="{x:Bind ViewModel.SelectedBackupRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="MigrationWizardIssueBackupRoot"/>
                            <Button x:Uid="MigrationWizard_ChooseDirectory" Click="OnBrowseIssueRoot" HorizontalAlignment="Left" AutomationProperties.AutomationId="MigrationWizardIssueRootPicker"/>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedSources}">
                                <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:MigrationWizardSourceItem">
                                    <StackPanel Spacing="4" Margin="0,4">
                                        <TextBox Header="{x:Bind Name}" Text="{x:Bind Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="{x:Bind IssueAutomationId}"/>
                                        <Button x:Uid="MigrationWizard_ChooseDirectory" Click="OnBrowseSource" HorizontalAlignment="Left" AutomationProperties.AutomationId="{x:Bind IssuePickerAutomationId}"/>
                                    </StackPanel>
                                </DataTemplate></ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowPassword)}">
                            <PasswordBox x:Name="OriginalPassword" x:Uid="MigrationWizard_Password" AutomationProperties.AutomationId="MigrationWizardOriginalPassword"/>
                            <Button x:Uid="MigrationWizard_VerifyPassword" Click="OnVerifyPassword" AutomationProperties.AutomationId="MigrationWizardVerifyPassword"/>
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Archives}">
                            <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:MigrationWizardArchiveItem">
                                <StackPanel Spacing="4" Margin="0,4" Visibility="{x:Bind local:MigrationWizardPage.Visible(NeedsChoice)}">
                                    <ComboBox Header="{x:Bind Name}" ItemsSource="{x:Bind Options}" SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="{x:Bind AutomationId}"/>
                                    <TextBlock Text="{x:Bind SelectedPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                    <CheckBox x:Uid="MigrationWizard_ConfirmLegacy" IsChecked="{x:Bind ConfirmLegacy, Mode=TwoWay}" Visibility="{x:Bind local:MigrationWizardPage.Visible(NeedsLegacyConfirmation)}" AutomationProperties.AutomationId="{x:Bind ConfirmAutomationId}"/>
                                    <Button x:Uid="MigrationWizard_ChooseArchive" Tag="{x:Bind Id}" Click="OnChooseArchive" AutomationProperties.AutomationId="{x:Bind ChooseAutomationId}"/>
                                </StackPanel>
                            </DataTemplate></ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Branches}">
                            <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:MigrationWizardBranchItem">
                                <StackPanel Spacing="4" Margin="0,4">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap"/>
                                    <ComboBox ItemsSource="{x:Bind Options}" SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" Visibility="{x:Bind local:MigrationWizardPage.Visible(ShowSelector)}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="{x:Bind AutomationId}" AutomationProperties.Name="{x:Bind Name}"/>
                                </StackPanel>
                            </DataTemplate></ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <Button x:Uid="MigrationWizard_Reconcile" Click="OnReconcile" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowReconciliation)}" AutomationProperties.AutomationId="MigrationWizardReconcile"/>
                        <Button x:Uid="MigrationWizard_RetainMissing" Click="OnRetainMissing" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowMissingArchives)}" AutomationProperties.AutomationId="MigrationWizardRetainMissing"/>
                        <Expander x:Uid="MigrationWizard_TechnicalDetails" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MigrationWizardTechnicalDetails">
                            <TextBlock Text="{x:Bind ViewModel.TechnicalDetails}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <ListView ItemsSource="{x:Bind ViewModel.Projects}" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.ShowResult)}" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="MigrationWizardResults">
                <ListView.ItemTemplate><DataTemplate x:DataType="vm:MigrationWizardProjectItem">
                    <StackPanel Spacing="4" Padding="8"><TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock Text="{x:Bind Status}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind BackupRoot}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
        </ContentControl>
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Uid="MigrationWizard_Back" Click="OnBack" IsEnabled="{x:Bind ViewModel.CanGoBack}" AutomationProperties.AutomationId="MigrationWizardBack"/>
            <Button Grid.Column="1" x:Uid="MigrationWizard_Leave" Click="OnLeave" Visibility="{x:Bind local:MigrationWizardPage.NotVisible(ViewModel.Busy)}" AutomationProperties.AutomationId="MigrationWizardLeave"/>
            <Button Grid.Column="1" x:Uid="Migration_CancelOperation" Click="OnCancel" Visibility="{x:Bind local:MigrationWizardPage.Visible(ViewModel.Busy)}" AutomationProperties.AutomationId="MigrationWizardCancel"/>
            <Button Grid.Column="3" Content="{x:Bind ViewModel.PrimaryText}" Click="OnPrimary" IsEnabled="{x:Bind ViewModel.CanOperate}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="MigrationWizardPrimary"/>
        </Grid>
    </Grid>
</Page>
