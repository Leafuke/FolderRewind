<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:settings="using:CommunityToolkit.WinUI.Controls" xmlns:models="using:FolderRewind.Models" xmlns:services="using:FolderRewind.Services" xmlns:filters="using:FolderRewind.Plugin.Abstractions" x:Class="FolderRewind.Views.ConfigSettingsPage" SizeChanged="OnSettingsPageSizeChanged">
    <Grid x:Name="SettingsLayout" Margin="24" RowSpacing="12" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <Grid x:Name="SettingsHeaderGrid" ColumnSpacing="16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="SettingsProject_Title" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind Config.Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Config.Name, Mode=OneWay}"/>
                </StackPanel>
                <TextBox x:Name="SettingsSearchBox" x:Uid="SettingsProject_SearchCompact" TextChanged="OnSearchChanged" AutomationProperties.AutomationId="ProjectSettingsSearch" Grid.Column="1" Width="280" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Grid>
            <TextBlock x:Name="SearchFeedback" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ScrollViewer x:Name="CategoryStrip" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                <SelectorBar x:Name="ConfigSelectorBar" SelectionChanged="OnSettingsSelectorBarSelectionChanged" AutomationProperties.AutomationId="ConfigSelectorBar">
                    <SelectorBarItem AutomationProperties.AutomationId="ConfigSettingsTabGeneral" x:Uid="SettingsProject_TabGeneral" Tag="General" IsSelected="True">
                        </SelectorBarItem>
                    <SelectorBarItem AutomationProperties.AutomationId="ConfigSettingsTabBackup" x:Uid="SettingsProject_TabBackup" Tag="Backup">
                        </SelectorBarItem>
                    <SelectorBarItem AutomationProperties.AutomationId="ConfigSettingsTabResource" x:Uid="SettingsProject_TabResource" Tag="Resource">
                        </SelectorBarItem>
                    <SelectorBarItem AutomationProperties.AutomationId="ConfigSettingsTabRestore" x:Uid="SettingsProject_TabRestore" Tag="Restore">
                        </SelectorBarItem>
                    <SelectorBarItem AutomationProperties.AutomationId="ConfigSettingsTabAutomation" x:Uid="SettingsProject_TabAutomation" Tag="Automation">
                        </SelectorBarItem>
                    <SelectorBarItem AutomationProperties.AutomationId="ConfigSettingsTabCloud" x:Uid="SettingsProject_TabCloud" Tag="Cloud">
                        </SelectorBarItem>
                    <SelectorBarItem AutomationProperties.AutomationId="ConfigSettingsTabFilter" x:Uid="SettingsProject_TabFilter" Tag="Filter">
                        </SelectorBarItem>
                </SelectorBar>
            </ScrollViewer>
        </StackPanel>
        <!-- 1. 常规设置 -->
        <ScrollViewer x:Name="GeneralTabScrollViewer" x:Load="False" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4" Padding="0,8,0,16" HorizontalAlignment="Stretch">
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_ConfigName">
                    <TextBox Width="320" HorizontalAlignment="Left" AutomationProperties.AutomationId="ConfigSettingsName" x:Uid="ConfigSettingsDialog_ConfigName_CardInput" Text="{x:Bind Config.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </settings:SettingsCard>
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_ConfigKind">
                    <StackPanel Spacing="8">
                        <ComboBox Width="320" x:Uid="SettingsProject_KindPicker" ItemsSource="{x:Bind ConfigKindsView, Mode=OneWay}" SelectedItem="{x:Bind SelectedConfigKind, Mode=TwoWay}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="ConfigSettingsKindPicker" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ConfigKindDescriptionText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </settings:SettingsCard>
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_Icon">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="{x:Bind Config.IconGlyph, Mode=OneWay}" FontSize="24" VerticalAlignment="Center"/>
                        <Button x:Uid="SettingsProject_ChangeIcon" AutomationProperties.AutomationId="ProjectSettingsChangeIcon">
                            <Button.Flyout><Flyout>
                        <GridView x:Name="IconGrid" SelectionMode="Single" Width="288" MaxHeight="288" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="OnIconSelectionChanged" AutomationProperties.AutomationId="IconGrid" x:Uid="SettingsProject_IconPicker" ContainerContentChanging="OnIconContainerChanged">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Padding" Value="4"/>
                                    <Setter Property="Width" Value="48"/>
                                    <Setter Property="Height" Value="48"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="services:ConfigIconOption">
                                    <Border Width="40" Height="40" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" AutomationProperties.Name="{x:Bind Name, Mode=OneTime}" ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}">
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneTime}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                            </Flyout></Button.Flyout>
                        </Button>
                    </StackPanel>
                </settings:SettingsCard>
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_DestPath">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DestPathBox" x:Uid="ConfigSettingsDialog_DestPathPlaceholder" Text="{x:Bind Config.DestinationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="DestPathBox"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Click="OnBrowseClick" x:Uid="ConfigSettingsDialog_BrowseButton" AutomationProperties.AutomationId="ConfigSettingsDialog_BrowseButton">
                                <FontIcon Glyph=""/>
                            </Button>
                            <Button Grid.Column="2" Margin="8,0,0,0" Click="OnOpenDestinationClick" x:Uid="ConfigSettingsDialog_OpenDestination" AutomationProperties.AutomationId="ConfigSettingsDialog_OpenDestination">
                                <FontIcon Glyph=""/>
                            </Button>
                        </Grid>
                        <TextBlock x:Uid="ConfigSettingsDialog_DestPathDesc" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </settings:SettingsCard>
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_SaveAsTemplateText">
                    <StackPanel Spacing="6">
                        <Button AutomationProperties.AutomationId="ConfigSettingsSaveTemplate" Click="OnSaveAsTemplateClick" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7BF;"/>
                                <TextBlock x:Uid="ConfigSettingsDialog_SaveAsTemplateText"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Uid="ConfigSettingsDialog_SaveAsTemplateDesc" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </settings:SettingsCard>
            </StackPanel>
        </ScrollViewer>
        <!-- 2. 备份策略 -->
        <ScrollViewer x:Name="BackupTabScrollViewer" x:Load="False" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4" Padding="0,8,0,16" HorizontalAlignment="Stretch">
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_BackupVerification">
                    <StackPanel Spacing="8">
                        <RadioButtons Width="320" HorizontalAlignment="Left" SelectedIndex="{x:Bind ViewModel.BackupVerificationSelectedIndex, Mode=TwoWay}" MaxColumns="2" AutomationProperties.AutomationId="ConfigSettingsDialog_BackupVerification">
                            <RadioButton x:Uid="ConfigSettingsDialog_VerificationBalanced" AutomationProperties.AutomationId="BackupVerificationBalanced"/>
                            <RadioButton x:Uid="ConfigSettingsDialog_VerificationStrict" AutomationProperties.AutomationId="BackupVerificationStrict"/>
                        </RadioButtons>
                        <TextBlock x:Uid="ConfigSettingsDialog_BackupVerificationDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </settings:SettingsCard>
                <settings:SettingsCard ContentAlignment="Right" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_BackupMode" Tag="Responsive" SizeChanged="OnSettingCardSizeChanged">
                    <ComboBox x:Uid="ConfigSettingsDialog_BackupMode_CardInput" SelectedIndex="{x:Bind ModeSelectedIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ConfigSettingsDialog_BackupMode">
                        <ComboBoxItem x:Uid="ConfigSettingsDialog_ModeFull"/>
                        <ComboBoxItem x:Uid="ConfigSettingsDialog_ModeSmart"/>
                        <ComboBoxItem x:Uid="ConfigSettingsDialog_ModeRolling"/>
                    </ComboBox>
                </settings:SettingsCard>
                <Border Style="{StaticResource CautionCardStyle}" Visibility="{x:Bind IsRollingModeSelected, Mode=OneTime, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{x:Bind RollingModeDescriptionText, Mode=OneTime}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Border>
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_BackupScope">
                    <StackPanel Spacing="8">
                        <ComboBox x:Uid="ConfigSettingsDialog_BackupScope_CardInput" ItemsSource="{x:Bind ViewModel.BackupScopeOptions, Mode=OneWay}" DisplayMemberPath="DisplayName" SelectedIndex="{x:Bind ViewModel.BackupScopeSelectedIndex, Mode=OneWay}" SelectionChanged="OnBackupScopeSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ConfigSettingsDialog_BackupScope"/>
                        <TextBlock Text="{x:Bind ViewModel.BackupScopeDescription, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource CautionCardStyle}" Visibility="{x:Bind ViewModel.IsPluginBackupScopeSelected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock x:Uid="ConfigSettingsDialog_BackupScopePartialWarning" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Border>
                        <StackPanel x:Name="BackupScopeParametersPanel" Spacing="10" Visibility="{x:Bind ViewModel.IsPluginBackupScopeSelected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>
                </settings:SettingsCard>
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_SemanticBackup">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SemanticBackup_Description" TextWrapping="Wrap"/>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="SemanticBackupEnableLabel" x:Uid="SemanticBackup_EnableLabel" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Uid="SemanticBackup_Enable" IsOn="{x:Bind ViewModel.ExperimentalSemanticBackupEnabled, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.CanToggleSemanticBackup, Mode=OneWay}" HorizontalAlignment="Left"
                                          AutomationProperties.LabeledBy="{Binding ElementName=SemanticBackupEnableLabel}" AutomationProperties.AutomationId="SemanticBackupEnable"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SemanticBackupAvailability, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="SemanticBackupAvailability"/>
                        <Button x:Uid="SemanticBackup_Refresh" Command="{x:Bind ViewModel.RefreshSemanticAvailabilityCommand}" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SemanticBackupRefresh"/>
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ExperimentalSemanticBackupEnabled, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                            <Border Style="{StaticResource CautionCardStyle}">
                                <TextBlock x:Uid="SemanticBackup_ExperimentalWarning" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="SemanticBackupFallbackLabel" x:Uid="SemanticBackup_FallbackLabel" TextWrapping="Wrap"/>
                                <ToggleSwitch x:Uid="SemanticBackup_Fallback" IsOn="{x:Bind ViewModel.SemanticBackupFallbackEnabled, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.CanEditSemanticBackup, Mode=OneWay}" HorizontalAlignment="Left"
                                              AutomationProperties.LabeledBy="{Binding ElementName=SemanticBackupFallbackLabel}" AutomationProperties.AutomationId="SemanticBackupFallback"/>
                            </StackPanel>
                            <TextBlock x:Uid="SemanticBackup_FallbackHint" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock x:Uid="SemanticBackup_CheckpointHeader" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="SemanticBackup_CheckpointDescription" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" SizeChanged="OnCleanupButtonsSizeChanged">
                                <Button Content="{x:Bind ViewModel.SemanticCheckpointLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SemanticCheckpointCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanCreateSemanticCheckpoint, Mode=OneWay}" AutomationProperties.AutomationId="SemanticCheckpointCreate"/>
                                <Button x:Uid="SemanticBackup_CancelCheckpoint" Command="{x:Bind ViewModel.CancelSemanticCheckpointCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsSemanticCheckpointRunning, Mode=OneWay}" AutomationProperties.AutomationId="SemanticCheckpointCancel"/>
                            </StackPanel>
                            <ProgressRing Width="24" Height="24" HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.IsSemanticCheckpointRunning, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsSemanticCheckpointRunning, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                            <TextBlock Text="{x:Bind ViewModel.SemanticCheckpointStatus, Mode=OneWay}" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.SemanticCheckpointStatus, Mode=OneWay, Converter={StaticResource StringNullOrEmptyToVisConverter}}"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SemanticCheckpointStatus"/>
                        </StackPanel>
                    </StackPanel>
                </settings:SettingsCard>
                <settings:SettingsCard ContentAlignment="Right" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_SkipIfUnchanged" Tag="Responsive" SizeChanged="OnSettingCardSizeChanged">
                    <ToggleSwitch x:Uid="ConfigSettingsDialog_SkipIfUnchanged_CardInput" IsOn="{x:Bind ViewModel.SkipIfUnchanged, Mode=TwoWay}" AutomationProperties.AutomationId="ConfigSettingsDialog_SkipIfUnchanged"/>
                </settings:SettingsCard>
                <settings:SettingsCard ContentAlignment="Right" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_SourceReadMode" Tag="Responsive" SizeChanged="OnSettingCardSizeChanged">
                    <ComboBox x:Uid="ConfigSettingsDialog_SourceReadMode_CardInput" SelectedIndex="{x:Bind ViewModel.SourceReadModeSelectedIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ConfigSettingsDialog_SourceReadMode">
                        <ComboBoxItem x:Uid="ConfigSettingsDialog_SourceReadAutomatic"/>
                        <ComboBoxItem x:Uid="ConfigSettingsDialog_SourceReadAlwaysCopy"/>
                        <ComboBoxItem x:Uid="ConfigSettingsDialog_SourceReadDirectOnly"/>
                    </ComboBox>
                </settings:SettingsCard>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="ResourceTabScrollViewer" x:Load="False" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4" Padding="0,8,0,16" HorizontalAlignment="Stretch">
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_KeepCount">
                    <StackPanel Spacing="8">
                        <NumberBox x:Uid="ConfigSettingsDialog_KeepCount_CardInput" Value="{x:Bind ViewModel.KeepCount, Mode=TwoWay}" Minimum="0" AutomationProperties.AutomationId="ConfigSettingsDialog_KeepCount"/>
                        <TextBlock x:Uid="Retention_SettingDescription" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" SizeChanged="OnCleanupButtonsSizeChanged">
                            <Button Content="{x:Bind ViewModel.CleanNowLabel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanCleanNow, Mode=OneWay}" Click="OnCleanNowClick" AutomationProperties.AutomationId="RetentionCleanNow"/>
                            <Button x:Uid="Retention_ReportButton" Click="OnCleanupReportClick" AutomationProperties.AutomationId="RetentionReport"/>
                        </StackPanel>
                    </StackPanel>
                </settings:SettingsCard>
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_MaxSmartChain">
                    <StackPanel Spacing="4">
                        <NumberBox x:Uid="ConfigSettingsDialog_MaxSmartChain_CardInput" Value="{x:Bind ViewModel.MaxSmartBackupsPerFull, Mode=TwoWay}" Minimum="0" Maximum="100" IsEnabled="{x:Bind ViewModel.CanConfigureCoreSmartChain, Mode=OneWay}" AutomationProperties.AutomationId="ConfigSettingsDialog_MaxSmartChain"/>
                        <TextBlock x:Uid="ConfigSettingsDialog_MaxSmartChainDesc" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </settings:SettingsCard>
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_PerformancePreset">
                    <StackPanel Spacing="4">
                        <ComboBox x:Uid="ConfigSettingsDialog_PerformancePreset_CardInput" ItemsSource="{x:Bind ViewModel.PerformancePresetOptions, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.PerformanceChoice, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ConfigSettingsDialog_PerformancePreset"/>
                        <TextBlock Text="{x:Bind ViewModel.PerformancePresetDescription, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.PerformanceChangePreview, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock x:Uid="Performance_FileTypeOverrideHint" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Performance_Apply" Click="OnApplyPerformance" IsEnabled="{x:Bind ViewModel.CanApplyPerformancePreset, Mode=OneWay}" AutomationProperties.AutomationId="PerformanceApply"/>
                            <Button x:Uid="Performance_Undo" Click="OnUndoPerformance" IsEnabled="{x:Bind ViewModel.CanUndoPerformance, Mode=OneWay}" AutomationProperties.AutomationId="PerformanceUndo"/>
                        </StackPanel>
                    </StackPanel>
                </settings:SettingsCard>
                <Expander x:Uid="SettingsProject_AdvancedResources" HorizontalAlignment="Stretch" Margin="0,12,0,0">
                    <StackPanel Spacing="4">
                        <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_Format">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Uid="ConfigSettingsDialog_Format_CardInput" SelectedIndex="{x:Bind FormatSelectedIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,8,0" AutomationProperties.AutomationId="ConfigSettingsDialog_Format">
                                    <ComboBoxItem x:Uid="ConfigSettingsDialog_Format7z"/>
                                    <ComboBoxItem x:Uid="ConfigSettingsDialog_FormatZip"/>
                                </ComboBox>
                                <ComboBox x:Uid="ConfigSettingsDialog_Method" Grid.Column="1" SelectedIndex="{x:Bind ViewModel.CompressionMethodSelectedIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="8,0,0,0" AutomationProperties.AutomationId="ConfigSettingsDialog_Method">
                                    <ComboBoxItem Content="LZMA2"/>
                                    <ComboBoxItem Content="Deflate"/>
                                    <ComboBoxItem Content="BZip2"/>
                                    <ComboBoxItem Content="zstd"/>
                                </ComboBox>
                            </Grid>
                        </settings:SettingsCard>
                        <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_CompressionLevel">
                            <StackPanel Spacing="4">
                                <Slider x:Name="CompressionLevelSlider" Minimum="{x:Bind ViewModel.CompressionLevelMin, Mode=OneWay}" Maximum="{x:Bind ViewModel.CompressionLevelMax, Mode=OneWay}" Value="{x:Bind ViewModel.CompressionLevel, Mode=TwoWay}" AutomationProperties.AutomationId="CompressionLevelSlider"/>
                            </StackPanel>
                        </settings:SettingsCard>
                        <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_CpuThreads">
                            <StackPanel Spacing="4">
                                <Slider Minimum="0" Maximum="{x:Bind ViewModel.CpuThreadMax, Mode=OneWay}" StepFrequency="1" Value="{x:Bind ViewModel.CpuThreadsValue, Mode=TwoWay}" AutomationProperties.AutomationId="ProjectSettingsControl126"/>
                                <TextBlock Text="{x:Bind ViewModel.CpuThreadsDescription, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </settings:SettingsCard>
                        <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_LowPriority">
                            <StackPanel Spacing="4">
                                <ToggleSwitch x:Uid="ConfigSettingsDialog_LowPriority_CardInput" IsOn="{x:Bind ViewModel.RunCompressionAtLowPriority, Mode=TwoWay}" AutomationProperties.AutomationId="ConfigSettingsDialog_LowPriority"/>
                                <TextBlock x:Uid="ConfigSettingsDialog_LowPriorityDesc" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </settings:SettingsCard>
                        <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_Additional7zArgs">
                            <StackPanel Spacing="4">
                                <TextBox x:Uid="ConfigSettingsDialog_Additional7zArgsPlaceholder" Text="{x:Bind ViewModel.AdditionalSevenZipArgumentsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ConfigSettingsDialog_Additional7zArgsPlaceholder"/>
                                <TextBlock x:Uid="ConfigSettingsDialog_Additional7zArgsDesc" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </settings:SettingsCard>
                        <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_FileTypeHandling">
                            <StackPanel Spacing="8">
                                <ToggleSwitch x:Uid="ConfigSettingsDialog_FileTypeHandling_CardInput" IsOn="{x:Bind ViewModel.FileTypeHandlingEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="ConfigSettingsDialog_FileTypeHandling"/>
                                <TextBlock x:Uid="ConfigSettingsDialog_FileTypeHandlingDesc" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <StackPanel Visibility="{x:Bind ViewModel.FileTypeHandlingEnabled, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Spacing="8">
                                    <ListView x:Name="FileTypeRulesList" ItemsSource="{x:Bind ViewModel.FileTypeRules, Mode=OneWay}" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" AutomationProperties.AutomationId="FileTypeRulesList" MaxHeight="180" MinHeight="48">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:FileTypeRule">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Pattern, Mode=OneTime}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.6">
                                                        <Run Text="mx="/>
                                                        <Run Text="{x:Bind CompressionLevel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Button Grid.Column="2" Content="" FontFamily="Segoe MDL2 Assets" Click="OnRemoveFileTypeRuleClick" AutomationProperties.AutomationId="ProjectSettingsControl151" x:Uid="SettingsProject_RemoveRule"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="FileTypePatternBox" x:Uid="ConfigSettingsDialog_FileTypePatternPlaceholder" AutomationProperties.AutomationId="FileTypePatternBox"/>
                                        <NumberBox x:Name="FileTypeLevelBox" Grid.Column="1" Value="1" Minimum="0" Maximum="9" Width="130" AutomationProperties.AutomationId="FileTypeLevelBox"/>
                                        <Button Grid.Column="2" x:Uid="ConfigSettingsDialog_AddFileTypeRule" Click="OnAddFileTypeRuleClick" AutomationProperties.AutomationId="ConfigSettingsDialog_AddFileTypeRule"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </settings:SettingsCard>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <!-- 3. 还原策略 -->
        <ScrollViewer x:Name="RestoreTabScrollViewer" x:Load="False" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4" Padding="0,8,0,16" HorizontalAlignment="Stretch">
                <settings:SettingsCard ContentAlignment="Right" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_BackupBeforeRestore" Tag="Responsive" SizeChanged="OnSettingCardSizeChanged">
                    <ToggleSwitch x:Uid="ConfigSettingsDialog_BackupBeforeRestore_CardInput" IsOn="{x:Bind ViewModel.BackupBeforeRestore, Mode=TwoWay}" AutomationProperties.AutomationId="ConfigSettingsDialog_BackupBeforeRestore"/>
                </settings:SettingsCard>
                <settings:SettingsCard ContentAlignment="Right" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_QuickSafetySnapshot" Tag="Responsive" SizeChanged="OnSettingCardSizeChanged">
                    <ToggleSwitch x:Uid="ConfigSettingsDialog_QuickSafetySnapshot" IsOn="{x:Bind ViewModel.QuickRestoreSafetySnapshotEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="ConfigSettingsDialog_QuickSafetySnapshot"/>
                </settings:SettingsCard>
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" x:Uid="SettingsCard_ConfigSettingsDialog_RestorePreflight">
                    <StackPanel Spacing="8">
                        <RadioButtons Width="320" HorizontalAlignment="Left" SelectedIndex="{x:Bind ViewModel.RestorePreflightSelectedIndex, Mode=TwoWay}" MaxColumns="2" AutomationProperties.AutomationId="ConfigSettingsDialog_RestorePreflight">
