<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FolderRewind.Views.BackupBranchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FolderRewind.ViewModels"
    x:Name="RootPage"
    NavigationCacheMode="Required">

    <Grid Padding="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock x:Uid="BackupBranchPage_Title"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,8"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock x:Uid="BackupBranchPage_Description"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <ComboBox x:Name="ConfigFilter"
                      x:Uid="BackupBranchPage_ConfigFilter"
                      Width="280"
                      ItemsSource="{x:Bind ViewModel.Configs, Mode=OneWay}"
                      DisplayMemberPath="Name"
                      SelectionChanged="ConfigFilter_SelectionChanged"/>
            <Button x:Name="RefreshButton"
                    x:Uid="BackupBranchPage_Refresh"
                    Click="OnRefreshClick"
                    IsEnabled="{x:Bind ViewModel.CanStartCommand, Mode=OneWay}"/>
            <ProgressRing Width="20" Height="20"
                          VerticalAlignment="Center"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Uid="BackupBranchPage_CurrentBranch"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.CurrentBranchName, Mode=OneWay}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.HasCurrentBranchName, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                <TextBlock x:Uid="BackupBranchPage_CurrentBranchNone"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.HasCurrentBranchName, Mode=OneWay, Converter={StaticResource BoolToVisInvertConverter}}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Button x:Name="CreateFromRunButton"
                    x:Uid="BackupBranchPage_CreateFromRun"
                    Click="OnCreateFromRunClick"
                    IsEnabled="{x:Bind ViewModel.CanStartCommand, Mode=OneWay}"/>
            <Button x:Name="CheckoutButton"
                    x:Uid="BackupBranchPage_Checkout"
                    Click="OnCheckoutClick"
                    IsEnabled="{x:Bind ViewModel.CanCheckoutSelected, Mode=OneWay}"/>
            <Button x:Name="RenameButton"
                    x:Uid="BackupBranchPage_Rename"
                    Click="OnRenameClick"
                    IsEnabled="{x:Bind ViewModel.CanRenameSelected, Mode=OneWay}"/>
            <Button x:Name="DeleteButton"
                    x:Uid="BackupBranchPage_Delete"
                    Click="OnDeleteClick"
                    IsEnabled="{x:Bind ViewModel.CanDeleteSelected, Mode=OneWay}"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid Visibility="{x:Bind ViewModel.HasBranches, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,0,12,8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Uid="BackupBranchPage_Column_Name"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" x:Uid="BackupBranchPage_Column_Tips"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" x:Uid="BackupBranchPage_Column_Created"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Branches, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedBranch, Mode=TwoWay}">
                    <!-- 自定义选中样式：仅显示左侧强调色条，不显示整行灰色背景（与文件夹管理页同一手法）。
                         但本页卡片是整行宽且不透明的，会连悬停/按下的底色一起盖住，
                         所以卡片表面改由模板画，选中条则画在内容之上。 -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Grid x:Name="Root" Background="Transparent">
                                            <Border x:Name="CardSurface"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    CornerRadius="{StaticResource ControlCornerRadius}"/>

                                            <ContentPresenter x:Name="ContentPresenter"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"/>

                                            <!-- 落在卡片自身的 12px 内边距里，文字仍与表头左对齐。 -->
                                            <Border x:Name="SelectionIndicator"
                                                    Width="3"
                                                    Height="28"
                                                    Margin="6,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="1.5"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Opacity="0"/>

                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <!-- 每个状态都显式写回底色：状态之间只应用新状态的 storyboard，
                                                         不重置旧状态设过的属性，漏写会残留上一次的悬停色。 -->
                                                    <VisualState x:Name="Normal">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardSurface" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardSurface" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardSurface" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectionIndicator"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardSurface" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOverSelected">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectionIndicator"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.15"/>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardSurface" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="PressedSelected">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectionIndicator"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.15"/>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardSurface" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BackupBranchItem">
                            <!-- 卡片表面与圆角由列表项模板提供，这里只留内边距。 -->
                            <Border Padding="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Name}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4" Padding="6,2"
                                                Visibility="{x:Bind IsCurrent, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="{x:Bind CurrentBadge}"
                                                       FontSize="11"
                                                       TextWrapping="NoWrap"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </Border>
                                        <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="4" Padding="6,2"
                                                Visibility="{x:Bind IsMultiTip, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="{x:Bind MultiTipBadge}"
                                                       FontSize="11"
                                                       TextWrapping="NoWrap"/>
                                        </Border>
                                        <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="4" Padding="6,2"
                                                Visibility="{x:Bind HasNameCollision, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="{x:Bind NameCollisionBadge}"
                                                       FontSize="11"
                                                       TextWrapping="NoWrap"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind TipsDisplay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind CreatedDisplay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
        </Grid>
    </Grid>
</Page>
