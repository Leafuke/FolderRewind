<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FolderRewind.Views.BackupBranchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FolderRewind.ViewModels"
    xmlns:graph="using:FolderRewind.Views.Graph"
    x:Name="RootPage"
    NavigationCacheMode="Required">

    <Grid Padding="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock x:Uid="BackupBranchPage_Title"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,8"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock x:Uid="BackupBranchPage_Description"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <ComboBox x:Name="ConfigFilter"
                      x:Uid="BackupBranchPage_ConfigFilter"
                      Width="280"
                      ItemsSource="{x:Bind ViewModel.Configs, Mode=OneWay}"
                      DisplayMemberPath="Name"
                      SelectionChanged="ConfigFilter_SelectionChanged"/>
            <!-- 分支列表收成了下拉：选中项同时是「下面看哪条分支」，也决定那五个按钮的亮灭。
                 双向绑定就够了，不需要 SelectionChanged —— 重算记录、同步 SelectedBranch 都在 VM 的 setter 里。 -->
            <ComboBox x:Name="BranchFilter"
                      x:Uid="BackupBranchPage_BranchFilter"
                      Width="240"
                      ItemsSource="{x:Bind ViewModel.BranchFilterOptions, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedBranchFilter, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BranchFilterOption">
                        <Grid ColumnSpacing="8" MinWidth="200">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind Name}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="6,2"
                                        Visibility="{x:Bind IsCurrent, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="{x:Bind CurrentBadge}"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                                <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="4" Padding="6,2"
                                        Visibility="{x:Bind IsMultiTip, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="{x:Bind MultiTipBadge}"
                                               FontSize="11"
                                               TextWrapping="NoWrap"/>
                                </Border>
                                <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="4" Padding="6,2"
                                        Visibility="{x:Bind HasNameCollision, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="{x:Bind NameCollisionBadge}"
                                               FontSize="11"
                                               TextWrapping="NoWrap"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind CreatedDisplay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="RefreshButton"
                    x:Uid="BackupBranchPage_Refresh"
                    Click="OnRefreshClick"
                    IsEnabled="{x:Bind ViewModel.CanStartCommand, Mode=OneWay}"/>
            <ProgressRing Width="20" Height="20"
                          VerticalAlignment="Center"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Uid="BackupBranchPage_CurrentBranch"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.CurrentBranchName, Mode=OneWay}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.HasCurrentBranchName, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                <TextBlock x:Uid="BackupBranchPage_CurrentBranchNone"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.HasCurrentBranchName, Mode=OneWay, Converter={StaticResource BoolToVisInvertConverter}}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Button x:Name="CreateFromRunButton"
                    x:Uid="BackupBranchPage_CreateFromRun"
                    Click="OnCreateFromRunClick"
                    IsEnabled="{x:Bind ViewModel.CanStartCommand, Mode=OneWay}"/>
            <Button x:Name="CheckoutButton"
                    x:Uid="BackupBranchPage_Checkout"
                    Click="OnCheckoutClick"
                    IsEnabled="{x:Bind ViewModel.CanCheckoutSelected, Mode=OneWay}"/>
            <Button x:Name="MergeButton"
                    x:Uid="BackupBranchPage_Merge"
                    Click="OnMergeClick"
                    IsEnabled="{x:Bind ViewModel.CanMergeSelected, Mode=OneWay}"/>
            <Button x:Name="RenameButton"
                    x:Uid="BackupBranchPage_Rename"
                    Click="OnRenameClick"
                    IsEnabled="{x:Bind ViewModel.CanRenameSelected, Mode=OneWay}"/>
            <Button x:Name="DeleteButton"
                    x:Uid="BackupBranchPage_Delete"
                    Click="OnDeleteClick"
                    IsEnabled="{x:Bind ViewModel.CanDeleteSelected, Mode=OneWay}"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Uid="BackupBranchPage_Records"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="0,0,0,8"/>

            <Grid Grid.Row="1">
                <ListView ItemsSource="{x:Bind ViewModel.Records, Mode=OneWay}">
                    <!-- 容器什么都不画，也不许撑高：卡片表面由模板画，rail 画在卡片之外。
                         行高必须恰好等于 CheckpointGraphLayout.RowHeight —— 每行只画自己那一段线，
                         差一点就会在行与行之间看见断缝，所以容器的 Margin/Padding/MinHeight 全部清零。 -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BackupRecordItem">
                            <Grid Height="{x:Bind RowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <graph:CheckpointRail Row="{x:Bind Row}" Width="{x:Bind RailWidth}"/>

                                <!-- 卡片底色刻意留透明：选中/悬停是高亮，画在容器上、卡片之下，
                                     底色一不透明就把它盖掉了。分组感改由描边提供。 -->
                                <Border Grid.Column="1"
                                        Margin="6,3"
                                        Padding="12,8"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Background="Transparent"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>

                                            <!-- 没有备注时标题本身就是种类名，徽标就多余了。 -->
                                            <Border Grid.Column="1"
                                                    CornerRadius="4" Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind HasRunComment, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{x:Bind KindBadge}"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"/>
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind TimeDisplay}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="{x:Bind Subtitle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind HasSubtitle, Converter={StaticResource BoolToVisConverter}}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
