<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FolderRewind.Views.BackupBranchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FolderRewind.ViewModels"
    x:Name="RootPage"
    NavigationCacheMode="Required">

    <Grid Padding="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock x:Uid="BackupBranchPage_Title"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,8"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock x:Uid="BackupBranchPage_Description"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <ComboBox x:Name="ConfigFilter"
                      x:Uid="BackupBranchPage_ConfigFilter"
                      Width="280"
                      ItemsSource="{x:Bind ViewModel.Configs, Mode=OneWay}"
                      DisplayMemberPath="Name"
                      SelectionChanged="ConfigFilter_SelectionChanged"/>
            <Button x:Name="RefreshButton"
                    x:Uid="BackupBranchPage_Refresh"
                    Click="OnRefreshClick"
                    IsEnabled="{x:Bind ViewModel.CanStartCommand, Mode=OneWay}"/>
            <ProgressRing Width="20" Height="20"
                          VerticalAlignment="Center"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Uid="BackupBranchPage_CurrentBranch"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.CurrentBranchName, Mode=OneWay}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.HasCurrentBranchName, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
                <TextBlock x:Uid="BackupBranchPage_CurrentBranchNone"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.HasCurrentBranchName, Mode=OneWay, Converter={StaticResource BoolToVisInvertConverter}}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Button x:Name="CreateFromRunButton"
                    x:Uid="BackupBranchPage_CreateFromRun"
                    Click="OnCreateFromRunClick"
                    IsEnabled="{x:Bind ViewModel.CanStartCommand, Mode=OneWay}"/>
            <Button x:Name="CheckoutButton"
                    x:Uid="BackupBranchPage_Checkout"
                    Click="OnCheckoutClick"
                    IsEnabled="{x:Bind ViewModel.CanCheckoutSelected, Mode=OneWay}"/>
            <Button x:Name="RenameButton"
                    x:Uid="BackupBranchPage_Rename"
                    Click="OnRenameClick"
                    IsEnabled="{x:Bind ViewModel.CanRenameSelected, Mode=OneWay}"/>
            <Button x:Name="DeleteButton"
                    x:Uid="BackupBranchPage_Delete"
                    Click="OnDeleteClick"
                    IsEnabled="{x:Bind ViewModel.CanDeleteSelected, Mode=OneWay}"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid Visibility="{x:Bind ViewModel.HasBranches, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,0,12,8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Uid="BackupBranchPage_Column_Name"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" x:Uid="BackupBranchPage_Column_Tips"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" x:Uid="BackupBranchPage_Column_Created"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Branches, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedBranch, Mode=TwoWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BackupBranchItem">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Padding="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Name}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4" Padding="6,2"
                                                Visibility="{x:Bind IsCurrent, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="{x:Bind CurrentBadge}"
                                                       FontSize="11"
                                                       TextWrapping="NoWrap"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </Border>
                                        <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="4" Padding="6,2"
                                                Visibility="{x:Bind IsMultiTip, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="{x:Bind MultiTipBadge}"
                                                       FontSize="11"
                                                       TextWrapping="NoWrap"/>
                                        </Border>
                                        <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="4" Padding="6,2"
                                                Visibility="{x:Bind HasNameCollision, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="{x:Bind NameCollisionBadge}"
                                                       FontSize="11"
                                                       TextWrapping="NoWrap"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind TipsDisplay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind CreatedDisplay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
        </Grid>
    </Grid>
</Page>
