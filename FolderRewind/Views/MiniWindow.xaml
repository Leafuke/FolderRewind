<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FolderRewind.Views.MiniWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          PointerCaptureLost="RootGrid_PointerCaptureLost">

        <Grid.ColumnDefinitions>
            <!-- 左侧展开区域 (默认折叠) -->
            <ColumnDefinition x:Name="LeftExpandColumn" Width="0"/>
            <!-- Mini 正方形主体 -->
            <ColumnDefinition Width="Auto"/>
            <!-- 右侧展开区域 (默认折叠) -->
            <ColumnDefinition x:Name="RightExpandColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Mini 主卡片 -->
        <Grid x:Name="MiniSquare" Grid.Column="1"
              Width="{x:Bind MiniCardSizeDip}" Height="{x:Bind MiniCardSizeDip}"
              PointerEntered="MiniSquare_PointerEntered"
              PointerExited="MiniSquare_PointerExited"
              Tapped="MiniSquare_Tapped"
              RightTapped="MiniSquare_RightTapped">

            <SystemBackdropElement CornerRadius="{x:Bind MiniCornerRadius}">
                <SystemBackdropElement.SystemBackdrop>
                    <DesktopAcrylicBackdrop/>
                </SystemBackdropElement.SystemBackdrop>
            </SystemBackdropElement>

            <Border x:Name="MiniSurfaceBorder"
                    CornerRadius="{x:Bind MiniCornerRadius}"
                    Background="Transparent"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"/>

            <Border x:Name="HoverOverlay"
                    CornerRadius="{x:Bind MiniCornerRadius}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Opacity="0"/>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon x:Name="ActionIcon"
                          Glyph="&#xE898;"
                          FontSize="18"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                <ProgressRing x:Name="BackupProgressRing"
                              IsActive="False"
                              Width="20" Height="20"
                              Visibility="Collapsed"/>

                <FontIcon x:Name="DoneIcon"
                          Glyph="&#xE73E;"
                          FontSize="18"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                          Visibility="Collapsed"/>

                <FontIcon x:Name="FailIcon"
                          Glyph="&#xEA39;"
                          FontSize="18"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                          Visibility="Collapsed"/>
            </Grid>

            <Ellipse x:Name="StatusDot"
                     Width="8" Height="8"
                     Margin="0,8,8,0"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}"/>

            <!-- 悬停提示 -->
            <ToolTipService.ToolTip>
                <ToolTip x:Name="MiniTooltip"/>
            </ToolTipService.ToolTip>

            <!-- 右键菜单 -->
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="MenuItemOpenFolder" Text="" Click="OnContextOpenFolder">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE838;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuItemBackup" Text="" Click="OnContextBackup">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE898;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="MenuItemExpandLeft" Text="" Click="OnContextToggleExpandDirection">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE76B;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="MenuItemClose" Text="" Click="OnContextClose" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>
        </Grid>

        <!-- 单一输入面板会根据当前展开方向切换到主卡片左侧或右侧 -->
        <Grid x:Name="CommentPanel" Grid.Column="2"
              Width="{x:Bind CommentCardWidthDip}"
              Height="{x:Bind MiniCardSizeDip}"
              Visibility="Collapsed"
              VerticalAlignment="Center">
            <SystemBackdropElement CornerRadius="{x:Bind MiniCornerRadius}">
                <SystemBackdropElement.SystemBackdrop>
                    <DesktopAcrylicBackdrop/>
                </SystemBackdropElement.SystemBackdrop>
            </SystemBackdropElement>

            <Border x:Name="CommentSurfaceBorder"
                    CornerRadius="{x:Bind MiniCornerRadius}"
                    Background="Transparent"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"/>

            <TextBox x:Name="CommentBox"
                     PlaceholderText=""
                     Padding="12,0"
                     BorderThickness="0"
                     CornerRadius="{x:Bind MiniCornerRadius}"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     KeyDown="CommentBox_KeyDown"
                     LostFocus="CommentBox_LostFocus"/>
        </Grid>
    </Grid>
</Window>
