<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FolderRewind.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FolderRewind.Models"
    xmlns:vm="using:FolderRewind.ViewModels"
    xmlns:converters="using:FolderRewind.Converters"
    x:Name="RootPage"
    NavigationCacheMode="Required">

    <Grid Padding="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Uid="HistoryPage_Title" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,24" AutomationProperties.HeadingLevel="Level1"/>

        <!-- 顶部一体化控制面板 -->
        <Border Grid.Row="1" Margin="0,0,0,24" 
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Padding="16,14">
            <StackPanel Spacing="12">
                <!-- 第 1 行：核心维度切换 & 搜索 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ConfigFilter" x:Uid="HistoryPage_ConfigFilter"
                              AutomationProperties.AutomationId="HistoryConfigFilter"
                              ItemsSource="{x:Bind ViewModel.Configs, Mode=OneWay}"
                              HorizontalAlignment="Stretch"
                              DisplayMemberPath="Name"
                              SelectionChanged="ConfigFilter_SelectionChanged"/>

                    <ComboBox x:Name="FolderFilter" Grid.Column="1" x:Uid="HistoryPage_FolderFilter"
                              AutomationProperties.AutomationId="HistoryFolderFilter"
                              HorizontalAlignment="Stretch"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="FolderFilter_SelectionChanged"/>

                    <TextBox x:Name="CommentFilterBox" Grid.Column="2"
                             x:Uid="HistoryPage_CommentFilter"
                             AutomationProperties.AutomationId="HistoryCommentFilter"
                             TextChanged="CommentFilterBox_TextChanged"/>

                    <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Top">
                        <TextBlock x:Uid="HistoryPage_ViewSelectorHeader"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <SelectorBar x:Name="HistoryViewSelector"
                                     Height="32"
                                     AutomationProperties.AutomationId="HistoryViewSelector"
                                     SelectionChanged="OnHistoryViewSelectionChanged">
                            <SelectorBarItem x:Name="SourceHistoryViewItem" x:Uid="HistoryPage_ViewBySource" Tag="Source" IsSelected="True"/>
                            <SelectorBarItem x:Name="RunHistoryViewItem" x:Uid="HistoryPage_ViewByRun" Tag="Run"/>
                        </SelectorBar>
                    </StackPanel>
                </Grid>

                <!-- 分割线 -->
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2"/>

                <!-- 第 2 行：分支上下文与操作组（严格单行，所有控件垂直居中对齐） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：分支管理群组 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- 当前活动分支指示胶囊 -->
                        <Border Background="{ThemeResource LayerFillColorAltBrush}" 
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4" 
                                Padding="8,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8D7;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.CurrentBranchDisplay, Mode=OneWay}"
                                           AutomationProperties.AutomationId="HistoryCurrentBranch"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Uid="HistoryPage_BranchSelectLabel"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="4,0,0,0"/>

                        <!-- 分支筛选下拉（无 Header，纯标准 32px 控件） -->
                        <ComboBox x:Name="BranchFilter"
                                  x:Uid="HistoryPage_BranchDropdown"
                                  AutomationProperties.AutomationId="HistoryBranchFilter"
                                  MinWidth="160"
                                  MaxWidth="240"
                                  VerticalAlignment="Center"
                                  ItemsSource="{x:Bind ViewModel.Branches, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedBranch, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"/>

                        <TextBlock Text="{x:Bind ViewModel.SelectedBranchCheckoutStatusText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxWidth="260"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.SelectedBranchCheckoutDiagnostic, Mode=OneWay}"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="BranchCheckoutButton"
                                x:Uid="HistoryPage_BranchCheckoutButton"
                                AutomationProperties.AutomationId="HistoryBranchCheckout"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.CanStartCheckoutSelectedBranch, Mode=OneWay}"
                                Click="OnCheckoutBranchClick">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72A;" FontSize="12"/>
                                <TextBlock x:Uid="HistoryPage_BranchCheckoutText"/>
                            </StackPanel>
                        </Button>

                        <DropDownButton x:Name="BranchMoreActionsButton"
                                        x:Uid="HistoryPage_BranchMoreActions"
                                        AutomationProperties.AutomationId="HistoryBranchMoreActions"
                                        VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE712;" FontSize="12"/>
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="BranchReconcileItem"
                                                    x:Uid="HistoryPage_BranchReconcileItem"
                                                    AutomationProperties.AutomationId="HistoryBranchReconcile"
                                                    IsEnabled="{x:Bind ViewModel.CanReconcileSelectedBranch, Mode=OneWay}"
                                                    Click="OnReconcileBranchClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem x:Name="BranchRenameItem"
                                                    x:Uid="HistoryPage_BranchRenameItem"
                                                    AutomationProperties.AutomationId="HistoryBranchRename"
                                                    IsEnabled="{x:Bind ViewModel.CanRenameSelectedBranch, Mode=OneWay}"
                                                    Click="OnRenameBranchClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem x:Name="BranchDeleteItem"
                                                    x:Uid="HistoryPage_BranchDeleteItem"
                                                    AutomationProperties.AutomationId="HistoryBranchDelete"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    IsEnabled="{x:Bind ViewModel.CanDeleteSelectedBranch, Mode=OneWay}"
                                                    Click="OnDeleteBranchClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <!-- 右侧：维护与云端操作 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Uid="HistoryPage_OpenCloudSyncButton"
                                AutomationProperties.AutomationId="HistoryOpenCloudSync"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.CanOpenConfigCloudSync, Mode=OneWay}"
                                Click="OnOpenCloudSyncClick">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE753;" FontSize="13"/>
                                <TextBlock x:Uid="HistoryPage_OpenCloudSyncText"/>
                            </StackPanel>
                        </Button>

                        <DropDownButton x:Name="MaintenanceDropDownButton"
                                        x:Uid="HistoryPage_MaintenanceDropDown"
                                        AutomationProperties.AutomationId="HistoryMaintenanceDropDown"
                                        VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE90F;" FontSize="13"/>
                                <TextBlock x:Uid="HistoryPage_MaintenanceDropDownText"/>
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="ScanRecoverMenuItem"
                                                    x:Uid="HistoryPage_ScanRecoverMenuItem"
                                                    AutomationProperties.AutomationId="HistoryScanRecover"
                                                    IsEnabled="{x:Bind ViewModel.CanUsePerSourceActions, Mode=OneWay}"
                                                    Click="OnScanRecoverClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71C;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="ClearMissingMenuItem"
                                                    x:Uid="HistoryPage_ClearMissingMenuItem"
                                                    AutomationProperties.AutomationId="HistoryClearMissing"
                                                    IsEnabled="{x:Bind ViewModel.HasMissing, Mode=OneWay}"
                                                    Click="OnClearMissingClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="SafetySnapshotsMenuItem"
                                                    x:Uid="HistoryPage_SafetySnapshotsMenuItem"
                                                    AutomationProperties.AutomationId="HistorySafetySnapshots"
                                                    Click="OnManageSafetySnapshotsClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <ToggleMenuFlyoutItem x:Name="UseColorsToggleMenuItem"
                                                          x:Uid="HistoryPage_UseColorsMenuItem"
                                                          AutomationProperties.AutomationId="HistoryUseStatusColors"
                                                          IsChecked="{x:Bind ViewModel.UseHistoryStatusColors, Mode=TwoWay}"/>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,12">
            <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                  AutomationProperties.LiveSetting="Polite">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
                    <TextBlock x:Uid="HistoryPage_Loading"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
            <InfoBar x:Name="HistoryLoadError"
                     x:Uid="HistoryPage_LoadError"
                     AutomationProperties.AutomationId="HistoryLoadError"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Uid="HistoryPage_Retry"
                            AutomationProperties.AutomationId="HistoryRetry"
                            Click="OnRetryHistoryClick"/>
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- 历史列表 -->
        <ListView x:Name="HistoryList" Grid.Row="3" SelectionMode="None"
                  AutomationProperties.AutomationId="HistoryVersionList"
                  ItemsSource="{x:Bind ViewModel.FilteredHistory, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowPerSourceHistory, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <!-- ItemTemplate 保持之前的 Git 节点风格 -->
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:NativeHistoryVersionViewItem">
                    <Grid MinHeight="90">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                            <TextBlock Text="{x:Bind TimeDisplay, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{x:Bind DateDisplay, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Rectangle Width="2" Fill="{x:Bind TimelineLineBrush, Mode=OneTime}" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
                            <Border Width="16" Height="16" CornerRadius="8"
                                    Background="{x:Bind TimelineNodeFillBrush, Mode=OneTime}"
                                    BorderBrush="{x:Bind TimelineNodeBorderBrush, Mode=OneTime}"
                                    BorderThickness="2"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Message, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind FileSizeDisplay, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ReadinessText, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <FontIcon Glyph="&#xE8D7;" FontSize="11"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Visibility="{x:Bind HasBranchDisplay, Mode=OneTime, Converter={StaticResource BoolToVisConverter}}"/>
                                        <TextBlock Text="{x:Bind BranchDisplay, Mode=OneTime}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="280"
                                                   Visibility="{x:Bind HasBranchDisplay, Mode=OneTime, Converter={StaticResource BoolToVisConverter}}"/>
                                        <FontIcon Glyph="&#xE753;"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  VerticalAlignment="Center"
                                                  Visibility="{x:Bind HasCloudCopy, Mode=OneTime, Converter={StaticResource BoolToVisConverter}}"
                                                  ToolTipService.ToolTip="{x:Bind CloudStatusText, Mode=OneTime}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button x:Uid="HistoryPage_ToggleImportantButton" Click="OnToggleImportantClick"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="{x:Bind IsImportant, Mode=OneTime, Converter={StaticResource BoolToStarIconConverter}}" FontSize="14"
                                                  Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                    </Button>
                                    <Button x:Uid="HistoryPage_ViewButton" Click="OnViewClick" ToolTipService.ToolTip="{x:Bind FileName, Mode=OneTime}">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                                    </Button>
                                    <Button x:Uid="HistoryPage_EditCommentButton" Click="OnEditCommentClick">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                    </Button>
                                    <Button Click="OnCreateBranchFromVersionClick"
                                            IsEnabled="{x:Bind CanCreateBranch, Mode=OneTime}"
                                            ToolTipService.ToolTip="{x:Bind CreateBranchHintText, Mode=OneTime}">
                                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                    </Button>
                                    <Button x:Uid="HistoryPage_UploadCloudButton"
                                            Click="OnUploadToCloudClick"
                                            IsEnabled="{x:Bind CanUploadToCloud, Mode=OneTime}"
                                            ToolTipService.ToolTip="{x:Bind CloudActionHintText, Mode=OneTime}">
                                        <FontIcon Glyph="&#xE898;" FontSize="14"/>
                                    </Button>
                                    <Button x:Uid="HistoryPage_DownloadCloudButton"
                                            Click="OnDownloadFromCloudClick"
                                            IsEnabled="{x:Bind CanDownloadFromCloud, Mode=OneTime}"
                                            ToolTipService.ToolTip="{x:Bind DownloadFromCloudHintText, Mode=OneTime}">
                                        <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                    </Button>
                                    <Button x:Uid="HistoryPage_RestoreButton" Click="OnRestoreClick">
                                        <FontIcon Glyph="&#xE777;" FontSize="14"/>
                                    </Button>
                                    <Button x:Uid="HistoryPage_DeleteButton" Click="OnDeleteClick">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView x:Name="RunHistoryList" Grid.Row="3" SelectionMode="None"
                  AutomationProperties.AutomationId="HistoryRunList"
                  ItemsSource="{x:Bind ViewModel.FilteredRuns, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowGroupedRunHistory, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:BackupRunViewItem">
                    <Grid Margin="0,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind TimeDisplay, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind DateDisplay, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Expander Grid.Column="1" HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Expander.Header>
                                <Grid MinHeight="62" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Message, Mode=OneTime}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind SourceSummary, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button x:Uid="HistoryPage_ToggleImportantButton" Click="OnToggleRunImportantClick" Background="Transparent" BorderThickness="0">
                                            <FontIcon Glyph="{x:Bind IsImportant, Converter={StaticResource BoolToStarIconConverter}, Mode=OneTime}" FontSize="14" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                        </Button>
                                        <Button x:Uid="HistoryPage_EditCommentButton" Click="OnEditRunCommentClick"><FontIcon Glyph="&#xE70F;" FontSize="14"/></Button>
                                        <Button Click="OnCreateBranchFromRunClick"
                                                IsEnabled="{x:Bind CanCreateBranch, Mode=OneTime}"
                                                ToolTipService.ToolTip="{x:Bind CreateBranchHintText, Mode=OneTime}"><FontIcon Glyph="&#xE710;" FontSize="14"/></Button>
                                        <Button x:Uid="HistoryPage_RestoreButton" Click="OnRestoreRunClick" IsEnabled="{x:Bind CanRestore, Mode=OneTime}"><FontIcon Glyph="&#xE777;" FontSize="14"/></Button>
                                        <Button x:Uid="HistoryPage_DeleteButton" Click="OnDeleteRunClick"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{x:Bind Sources, Mode=OneTime}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BackupRunSourceViewItem">
                                        <Grid Padding="8,5" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind StatusText, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Detail, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空状态提示 -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <FontIcon Glyph="&#xE7BA;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Uid="HistoryPage_EmptyState" Margin="0,16,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Page>
