<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FolderRewind.Views.PluginStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plugins="using:FolderRewind.Services.Plugins"
    mc:Ignorable="d">

    <ScrollViewer Padding="28">
        <StackPanel Spacing="12">
            <TextBlock x:Uid="PluginStorePage_Title" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock x:Uid="PluginStorePage_Desc" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="PluginStorePage_Load" Command="{x:Bind ViewModel.LoadCommand}" IsEnabled="{x:Bind ViewModel.CanLoad, Mode=OneWay}"/>
                <Button x:Uid="PluginStorePage_InstallManual" Command="{x:Bind ViewModel.InstallManualCommand}" IsEnabled="{x:Bind ViewModel.CanLoad, Mode=OneWay}"/>
            </StackPanel>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Width="28" Height="28"/>

            <TextBlock Text="{x:Bind ViewModel.ReleaseSummary, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasReleaseSummary, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <Button x:Uid="PluginStorePage_Enable"
                    Command="{x:Bind ViewModel.EnableManualCommand}"
                    Visibility="{x:Bind ViewModel.CanEnableManualNow, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                    HorizontalAlignment="Left" />

            <TextBlock x:Uid="PluginStorePage_NoAssets" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.IsEmptyList, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>

            <ListView ItemsSource="{x:Bind ViewModel.Assets, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="plugins:PluginStoreAssetItem">
                        <Grid Padding="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind SizeDisplay, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Uid="PluginStorePage_InstalledBadge"
                                           Visibility="{x:Bind IsInstalled, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ProgressRing Width="20"
                                              Height="20"
                                              IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                              Visibility="{x:Bind IsBusy, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"/>
                                <TextBlock x:Uid="PluginStorePage_RestartRequired"
                                           Visibility="{x:Bind RequiresRestart, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Uid="PluginStorePage_Enable"
                                        Click="OnEnableClick"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind CanEnableNow, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"
                                        IsEnabled="{x:Bind CanInstall, Mode=OneWay}"/>
                                <Button x:Uid="PluginStorePage_Install" Click="OnInstallClick" Tag="{x:Bind}" IsEnabled="{x:Bind CanInstall, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
