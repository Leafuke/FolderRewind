<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FolderRewind.Views.MergePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FolderRewind.ViewModels"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}"/>
        <Style x:Key="MergeCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MergePaneStyle" TargetType="Border" BasedOn="{StaticResource StandardCardStyle}">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="DiffRowStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <DataTemplate x:Key="ChangeTemplate" x:DataType="vm:MergeChangeItem">
            <Grid ColumnSpacing="8" Padding="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind CanCheck, Mode=OneWay}" MinWidth="32"
                          AutomationProperties.Name="{x:Bind Path, Mode=OneWay}" AutomationProperties.AutomationId="{x:Bind Id, Mode=OneWay}"/>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Path, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource MergeCaptionStyle}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DiffLineTemplate" x:DataType="vm:MergeDiffLine">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Number, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Marker, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Text, Mode=OneTime}" FontFamily="Consolas" IsTextSelectionEnabled="True"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ReviewLineTemplate" x:DataType="vm:MergeReviewLine">
            <Grid ColumnSpacing="16" Padding="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Kind, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Path, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageLayout" Padding="24" RowSpacing="16" SizeChanged="OnSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- Context stays compact; task management never pushes the workspace down. -->
        <Grid RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Uid="MergeWorkspace_BackIcon" Click="OnBack" Style="{StaticResource TransparentIconButtonStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="MergeWorkspace_Back">
                    <SymbolIcon Symbol="Back"/>
                </Button>
                <TextBlock Grid.Column="1" x:Uid="MergeWorkspace_Title" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
                <Button Grid.Column="2" x:Uid="MergeWorkspace_TaskMenu" VerticalAlignment="Center" AutomationProperties.AutomationId="MergeWorkspace_TaskMenu">
                    <SymbolIcon Symbol="More"/>
                    <Button.Flyout>
                        <Flyout x:Name="TaskFlyout" Placement="BottomEdgeAlignedRight">
                            <ScrollViewer MaxHeight="440" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12" Width="280">
                                    <TextBlock x:Uid="MergeWorkspace_TaskTitle" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <ComboBox x:Name="SessionPicker" x:Uid="MergeWorkspace_Sessions" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" SelectionChanged="OnSessionChanged" IsEnabled="{Binding CanChooseSession}"/>
                                    <CheckBox x:Uid="MergeWorkspace_ShowCompleted" IsChecked="{Binding ShowCompleted, Mode=TwoWay}" AutomationProperties.AutomationId="MergeWorkspace_ShowCompleted"/>
                                    <Button x:Uid="MergeWorkspace_NewTask" Click="OnNewMerge" IsEnabled="{Binding CanStartNew}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MergeWorkspace_NewTask"/>
                                    <Button x:Uid="MergeWorkspace_Reload" Click="OnReload" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MergeWorkspace_Reload"/>
                                    <Button x:Uid="MergeWorkspace_Reanalyze" Click="OnRecompute" IsEnabled="{Binding CanRecompute}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MergeWorkspace_Reanalyze"/>
                                    <Button x:Uid="MergeWorkspace_DownloadButton" Click="OnDownload" IsEnabled="{Binding CanPrepare}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MergeWorkspace_Download"/>
                                    <Button x:Uid="MergeWorkspace_DiscardButton" Click="OnAbandon" IsEnabled="{Binding CanAbandon}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MergeWorkspace_Abandon"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <Border Grid.Row="1" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid ColumnSpacing="16" RowSpacing="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding FolderName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FolderName}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Direction}" Style="{StaticResource BodyStrongTextBlockStyle}" MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Direction}"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TargetPath}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding TargetPath}" IsTextSelectionEnabled="True"/>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StageLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
                <TextBlock Grid.Column="1" Text="{Binding SaveStatus}" Style="{StaticResource MergeCaptionStyle}" Visibility="{Binding ShowSaveStatus, Converter={StaticResource BoolToVisConverter}}"/>
            </Grid>
            <InfoBar x:Uid="MergeWorkspace_Attention" IsOpen="{Binding HasError}" Severity="Warning" IsClosable="False" Message="{Binding Error}"/>
            <InfoBar IsOpen="{Binding ShowOperationNotice}" Severity="Informational" IsClosable="False" Message="{Binding Status}"/>
            <Button x:Uid="MergeWorkspace_RetrySave" Click="OnRetrySave" Visibility="{Binding CanRetrySave, Converter={StaticResource BoolToVisConverter}}" AutomationProperties.AutomationId="MergeWorkspace_RetrySave"/>
            <StackPanel Spacing="8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource MergeCaptionStyle}" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar IsIndeterminate="True"/>
                <Button x:Uid="MergeWorkspace_StopButton" Click="OnStop" Visibility="{Binding ShowSetupStop, Converter={StaticResource BoolToVisConverter}}" AutomationProperties.AutomationId="MergeWorkspace_SetupStop"/>
            </StackPanel>
            <TextBlock Text="{Binding RecomputeSummary}" Style="{StaticResource MergeCaptionStyle}" Visibility="{Binding HasRecomputeSummary, Converter={StaticResource BoolToVisConverter}}"/>
        </StackPanel>

        <!-- Setup is a real first step, with no empty conflict tools or premature saved state. -->
        <ScrollViewer Grid.Row="2" Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVisConverter}}" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="24" Margin="0,16,0,24">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="MergeWorkspace_SetupTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Uid="MergeWorkspace_SetupDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Border Style="{StaticResource StandardCardStyle}" Padding="24">
                    <StackPanel Spacing="24">
                        <Grid x:Name="BranchPair" ColumnSpacing="24" RowSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="TargetPairColumn" Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ComboBox x:Name="SourcePicker" x:Uid="MergeWorkspace_Source" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="OnSourceChanged" IsEnabled="{Binding IsIdle}"/>
                            <StackPanel x:Name="TargetPair" Grid.Column="1" Spacing="8">
                                <TextBlock x:Uid="MergeWorkspace_TargetLabel"/>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12,8">
                                    <TextBlock Text="{Binding TargetBranchName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding TargetBranchName}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Uid="MergeWorkspace_Impact" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <InfoBar IsOpen="{Binding HasSourceWarning}" Message="{Binding SourceAvailability}" Severity="Informational" IsClosable="False"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="MergeWorkspace_Analyze" Click="OnAnalyze" IsEnabled="{Binding CanAnalyze}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="MergeWorkspace_Analyze"/>
                            <Button x:Uid="MergeWorkspace_CancelNew" Click="OnCancelNew" IsEnabled="{Binding IsIdle}" Visibility="{Binding HasSession, Converter={StaticResource BoolToVisConverter}}" AutomationProperties.AutomationId="MergeWorkspace_CancelNew"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="MergeWorkspace_SetupNext" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock x:Uid="MergeWorkspace_SetupHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" Visibility="{Binding ShowWorkspace, Converter={StaticResource BoolToVisConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="288"/><ColumnDefinition x:Name="SplitColumn" Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="FilePanel" RowSpacing="12" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding CountLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                    <TextBox x:Uid="MergeWorkspace_Search" Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="MergeWorkspace_Search"/>
                    <ComboBox x:Name="FilterPicker" x:Uid="MergeWorkspace_Filter" SelectedIndex="0" SelectionChanged="OnFilterChanged" HorizontalAlignment="Stretch">
                        <ComboBoxItem x:Uid="MergeWorkspace_FilterAll" Tag="All"/>
                        <ComboBoxItem x:Uid="MergeWorkspace_FilterUnresolved" Tag="Unresolved"/>
                        <ComboBoxItem x:Uid="MergeWorkspace_FilterResolved" Tag="Resolved"/>
                        <ComboBoxItem x:Uid="MergeWorkspace_FilterAutomatic" Tag="Automatic"/>
                    </ComboBox>
                </StackPanel>
                <ListView x:Name="ChangeList" Grid.Row="1" ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource ChangeTemplate}" SelectedItem="{Binding SelectedChange, Mode=TwoWay}" IsItemClickEnabled="True" ItemClick="OnChangeClicked" KeyDown="OnListKeyDown" Loaded="OnListLoaded" AutomationProperties.AutomationId="MergeChangeList">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4"/></Style></ListView.ItemContainerStyle>
                </ListView>
                <TextBlock Grid.Row="1" Text="{Binding EmptyListTitle}" Style="{StaticResource MergeCaptionStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyList, Converter={StaticResource BoolToVisConverter}}"/>
            </Grid>
            <Thumb x:Name="ListSplitter" x:Uid="MergeWorkspace_ResizeList" Grid.Column="1" Width="4" Opacity="0.3" DragDelta="OnListResize" IsTabStop="True" KeyDown="OnSplitterKeyDown"/>
            <Grid x:Name="DetailPanel" Grid.Column="2" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Button x:Name="BackToFiles" x:Uid="MergeWorkspace_BackToFiles" Click="OnBackToFiles" Visibility="Collapsed"/>
                <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Visibility="{Binding ShowBatchActions, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding SelectionLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                        <TextBlock x:Uid="MergeWorkspace_BatchHint" Style="{StaticResource MergeCaptionStyle}"/>
                        <StackPanel x:Name="BatchButtons" Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding AdoptOursLabel}" Click="OnOurs" IsEnabled="{Binding CanAdopt}" AutomationProperties.AutomationId="MergeWorkspace_BatchOurs"/>
                            <Button Content="{Binding AdoptTheirsLabel}" Click="OnTheirs" IsEnabled="{Binding CanAdopt}" AutomationProperties.AutomationId="MergeWorkspace_BatchTheirs"/>
                            <Button x:Uid="MergeWorkspace_ClearButton" Click="OnClear" IsEnabled="{Binding CanClear}" AutomationProperties.AutomationId="MergeWorkspace_BatchClear"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource MergePaneStyle}" Visibility="{Binding ShowEmptyDetails, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Spacing="12" MaxWidth="360" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Document" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding EmptyDetailTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding EmptyDetailHint}" Style="{StaticResource MergeCaptionStyle}" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2" RowSpacing="12" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SelectedPath}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SelectedPath}" IsTextSelectionEnabled="True"/>
                        <TextBlock Text="{Binding SelectedDescription}" Style="{StaticResource MergeCaptionStyle}"/>
                        <TextBlock Text="{Binding PreviewNotice}" Style="{StaticResource MergeCaptionStyle}" Visibility="{Binding HasPreviewNotice, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>
                    <!-- Each diff list owns its scroll; no outer ScrollViewer disables virtualization. -->
                    <Grid x:Name="CompareGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="CompareSecondColumn" Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="CompareSecondRow" Height="0"/></Grid.RowDefinitions>
                        <Grid x:Name="OursPanel" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Spacing="4" Padding="16,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <TextBlock x:Uid="MergeWorkspace_OursRole" Style="{StaticResource MergeCaptionStyle}"/>
                                <TextBlock Text="{Binding OursLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding OursLabel}"/>
                                <TextBlock Text="{Binding OursInfo}" Style="{StaticResource MergeCaptionStyle}"/>
                            </StackPanel>
                            <ListView x:Name="OursLinesList" Grid.Row="1" ItemsSource="{Binding OursLines}" ItemTemplate="{StaticResource DiffLineTemplate}" ItemContainerStyle="{StaticResource DiffRowStyle}" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled" Loaded="OnDiffLoaded"/>
                            <Button x:Name="AdoptOursButton" Grid.Row="2" Margin="12" Content="{Binding AdoptOursLabel}" Click="OnOurs" IsEnabled="{Binding CanAdopt}" HorizontalAlignment="Stretch" Visibility="{Binding ShowFileActions, Converter={StaticResource BoolToVisConverter}}"/>
                        </Grid>
                        <Grid x:Name="TheirsPanel" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Spacing="4" Padding="16,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <TextBlock x:Uid="MergeWorkspace_TheirsRole" Style="{StaticResource MergeCaptionStyle}"/>
                                <TextBlock Text="{Binding TheirsLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding TheirsLabel}"/>
                                <TextBlock Text="{Binding TheirsInfo}" Style="{StaticResource MergeCaptionStyle}"/>
                            </StackPanel>
                            <ListView x:Name="TheirsLinesList" Grid.Row="1" ItemsSource="{Binding TheirsLines}" ItemTemplate="{StaticResource DiffLineTemplate}" ItemContainerStyle="{StaticResource DiffRowStyle}" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled" Loaded="OnDiffLoaded"/>
                            <Button x:Name="AdoptTheirsButton" Grid.Row="2" Margin="12" Content="{Binding AdoptTheirsLabel}" Click="OnTheirs" IsEnabled="{Binding CanAdopt}" HorizontalAlignment="Stretch" Visibility="{Binding ShowFileActions, Converter={StaticResource BoolToVisConverter}}"/>
                        </Grid>
                    </Grid>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Expander x:Uid="MergeWorkspace_Base" IsExpanded="{Binding ShowBase, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="MergeWorkspace_Base" Visibility="{Binding CanPreviewBase, Converter={StaticResource BoolToVisConverter}}">
                            <TextBox x:Name="BaseContent" Text="{Binding BaseText}" AutomationProperties.Name="{Binding SelectedPath}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"/>
                        </Expander>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding ShowFileActions, Converter={StaticResource BoolToVisConverter}}">
                            <Button x:Uid="MergeWorkspace_Import" Click="OnImport" IsEnabled="{Binding CanImport}" AutomationProperties.AutomationId="MergeWorkspace_ImportAction"/>
                            <Button x:Uid="MergeWorkspace_ClearButton" Click="OnClear" IsEnabled="{Binding CanClear}" AutomationProperties.AutomationId="MergeWorkspace_Clear"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="2" Visibility="{Binding ShowReview, Converter={StaticResource BoolToVisConverter}}" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">
                <Border Style="{StaticResource StandardCardStyle}" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="MergeWorkspace_ReviewTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="{Binding ReviewSummary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ProtectionText}" TextWrapping="Wrap"/>
                        <TextBlock x:Uid="MergeWorkspace_Validation" Style="{StaticResource MergeCaptionStyle}"/>
                    </StackPanel>
                </Border>
                <Expander x:Uid="MergeWorkspace_WorkingChanges" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="MergeWorkspace_WorkingChanges">
                    <Grid>
                        <ListView x:Name="WorkingChangeList" ItemsSource="{Binding WorkingChanges}" ItemTemplate="{StaticResource ReviewLineTemplate}" MaxHeight="280" SelectionMode="None" Visibility="{Binding HasWorkingChanges, Converter={StaticResource BoolToVisConverter}}"/>
                        <TextBlock x:Uid="MergeWorkspace_NoWorkingChanges" Style="{StaticResource MergeCaptionStyle}" Visibility="{Binding HasWorkingChanges, Converter={StaticResource BoolToVisInvertConverter}}"/>
                    </Grid>
                </Expander>
                <Expander x:Uid="MergeWorkspace_BranchChanges" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="MergeWorkspace_BranchChanges">
                    <Grid>
                        <ListView x:Name="BranchChangeList" ItemsSource="{Binding BranchChanges}" ItemTemplate="{StaticResource ReviewLineTemplate}" MaxHeight="280" SelectionMode="None" Visibility="{Binding HasBranchChanges, Converter={StaticResource BoolToVisConverter}}"/>
                        <TextBlock x:Uid="MergeWorkspace_NoBranchChanges" Style="{StaticResource MergeCaptionStyle}" Visibility="{Binding HasBranchChanges, Converter={StaticResource BoolToVisInvertConverter}}"/>
                    </Grid>
                </Expander>
                <Button x:Uid="MergeWorkspace_EditDecisions" Click="OnEditDecisions" IsEnabled="{Binding IsIdle}" AutomationProperties.AutomationId="MergeWorkspace_EditDecisions"/>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="2" Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisConverter}}" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource StandardCardStyle}" Padding="24" HorizontalAlignment="Stretch">
                <StackPanel Spacing="16">
                    <SymbolIcon Symbol="Accept" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ResultDiagnostic}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Visibility="{Binding HasResultDiagnostic, Converter={StaticResource BoolToVisConverter}}"/>
                    <Button x:Uid="MergeWorkspace_ViewResult" Click="OnViewResult" IsEnabled="{Binding CanShowResult}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="MergeWorkspace_ViewResult"/>
                    <Button x:Uid="MergeWorkspace_ViewProtection" Click="OnViewProtection" IsEnabled="{Binding CanShowResult}" AutomationProperties.AutomationId="MergeWorkspace_ViewProtection"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Visibility="{Binding ShowFooter, Converter={StaticResource BoolToVisConverter}}">
            <Grid x:Name="FooterGrid" ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding FooterHint}" Style="{StaticResource MergeCaptionStyle}" VerticalAlignment="Center"/>
                <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="MergeWorkspace_StopButton" Click="OnStop" Visibility="{Binding CanStop, Converter={StaticResource BoolToVisConverter}}" AutomationProperties.AutomationId="MergeWorkspace_Stop"/>
                    <Button x:Uid="MergeWorkspace_NextButton" Click="OnNext" Visibility="{Binding CanNext, Converter={StaticResource BoolToVisConverter}}" AutomationProperties.AutomationId="MergeWorkspace_Next"/>
                    <Button x:Uid="MergeWorkspace_UndoButton" Click="OnUndo" Visibility="{Binding ShowUndo, Converter={StaticResource BoolToVisConverter}}" AutomationProperties.AutomationId="MergeWorkspace_Undo"/>
                    <Button x:Name="RecoverMergeButton" Content="{Binding ResumeLabel}" Click="OnRecover" Visibility="{Binding CanRecover, Converter={StaticResource BoolToVisConverter}}" Style="{StaticResource AccentButtonStyle}"/>
                    <Button x:Uid="MergeWorkspace_Generate" Click="OnGenerate" IsEnabled="{Binding CanGenerate}" Visibility="{Binding ShowWorkspace, Converter={StaticResource BoolToVisConverter}}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="MergeWorkspace_Generate"/>
                    <Button x:Uid="MergeWorkspace_ApplyReviewed" Click="OnApplyReview" IsEnabled="{Binding CanApplyReview}" Visibility="{Binding ShowReview, Converter={StaticResource BoolToVisConverter}}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="MergeWorkspace_ApplyReviewed"/>
                    <Button x:Uid="MergeWorkspace_ReturnHistory" Click="OnBack" Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisConverter}}" AutomationProperties.AutomationId="MergeWorkspace_ReturnHistory"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
