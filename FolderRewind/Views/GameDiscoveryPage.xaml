<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FolderRewind.Views.GameDiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FolderRewind.Models"
    xmlns:discovery="using:FolderRewind.Services.Discovery"
    xmlns:vm="using:FolderRewind.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="28">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="GameDiscoveryPage_Title" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Uid="GameDiscoveryPage_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <InfoBar x:Uid="GameDiscoveryPage_BetaNotice" IsOpen="True" IsClosable="False" Severity="Informational" Visibility="{x:Bind ViewModel.IsStandardDiscoveryMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>

            <Border Visibility="{x:Bind ViewModel.IsFullMachineMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="GameDiscoveryPage_DataHeading" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.CacheStatus, Mode=OneWay}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="GameDiscoveryPage_Attribution" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <HyperlinkButton x:Uid="GameDiscoveryPage_LudusaviSource" NavigateUri="https://github.com/mtkennerly/ludusavi-manifest" Padding="0"/>
                        <HyperlinkButton x:Uid="GameDiscoveryPage_PcgwNotice" NavigateUri="https://www.pcgamingwiki.com/wiki/PCGamingWiki:Disclaimer" Padding="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="GameDiscoveryPage_DownloadAndScan" Click="OnDownloadAndScanClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                        <Button x:Uid="GameDiscoveryPage_CheckUpdate" Click="OnCheckUpdateClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                        <Button x:Uid="GameDiscoveryPage_ImportManifest" Click="OnImportManifestClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                    </StackPanel>
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="GameDiscoveryPage_SecondaryManifest" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Settings.SecondaryManifestPath, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                        <Button x:Uid="Common_Browse" Grid.Column="2" Click="OnBrowseSecondaryClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                        <TextBlock x:Uid="GameDiscoveryPage_Override" Grid.Row="1" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Settings.OverridePath, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                        <Button x:Uid="Common_Browse" Grid.Row="1" Grid.Column="2" Click="OnBrowseOverrideClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Expander x:Uid="GameDiscoveryPage_LibraryRoots" Visibility="{x:Bind ViewModel.IsFullMachineMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" IsExpanded="False" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                <StackPanel Spacing="10" Padding="0,10,0,0">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Settings.LibraryRoots, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:GameLibraryRootSetting">
                                <Grid ColumnSpacing="8" Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Store, Mode=OneWay}" VerticalAlignment="Center" MinWidth="60"/>
                                    <TextBox Grid.Column="2" Text="{x:Bind Path, Mode=TwoWay}" IsReadOnly="{x:Bind IsAutoDetected, Mode=OneWay}"/>
                                    <Button x:Uid="GameDiscoveryPage_DeleteRoot" Grid.Column="3" Click="OnRemoveRootClick" Tag="{x:Bind}" Visibility="{x:Bind IsAutoDetected, Converter={StaticResource BoolToVisInvertConverter}, Mode=OneWay}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="GameDiscoveryPage_AddSteamRoot" Click="OnAddSteamRootClick"/>
                        <Button x:Uid="GameDiscoveryPage_AddGogRoot" Click="OnAddGogRootClick"/>
                        <Button x:Uid="GameDiscoveryPage_AddEpicRoot" Click="OnAddEpicRootClick"/>
                        <Button x:Uid="GameDiscoveryPage_SaveRoots" Click="OnSaveSettingsClick"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Border Visibility="{x:Bind ViewModel.IsPluginBatchMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SystemControlForegroundAccentBrush}" BorderThickness="1" AutomationProperties.AutomationId="PluginBatchSummary">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="GameDiscovery_PluginBatch_Heading" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="GameDiscovery_PluginBatch_Plugin"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PluginBatchPluginName, Mode=OneWay}" FontWeight="SemiBold"/>
                        <TextBlock x:Uid="GameDiscovery_PluginBatch_Kind" Grid.Row="1"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.PluginBatchKindName, Mode=OneWay}"/>
                        <TextBlock x:Uid="GameDiscovery_PluginBatch_Root" Grid.Row="2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.PluginBatchRoot, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="GameDiscovery_PluginBatch_Rescan" Click="OnScanClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                        <Button x:Uid="GameDiscoveryPage_Cancel" Click="OnCancelClick" IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"/>
                    </StackPanel>
                    <InfoBar IsOpen="{x:Bind ViewModel.HasPluginBatchFatalMessage, Mode=OneWay}" IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.PluginBatchFatalMessage, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.PluginBatchSummary, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PluginBatchItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="discovery:PluginBatchCreationSummaryItem">
                                <Border Padding="12" Margin="0,4" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind ConfigName, Mode=OneTime}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind DestinationPath, Mode=OneTime}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind SourceSummary, Mode=OneTime}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind ViewModel.PluginBatchSkippedSummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <Border Visibility="{x:Bind ViewModel.RequiresPluginBatchBroadRootConfirmation, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Padding="12" CornerRadius="6" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="GameDiscovery_PluginBatch_BroadRootWarning" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.PluginBatchBroadRootSummary, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            <CheckBox x:Uid="GameDiscovery_PluginBatch_BroadRootConfirm" IsChecked="{x:Bind ViewModel.IsPluginBatchBroadRootConfirmed, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Uid="GameDiscovery_PluginBatch_Commit" Click="OnPluginBatchCommitClick" HorizontalAlignment="Right" IsEnabled="{x:Bind ViewModel.CanCommitPluginBatch, Mode=OneWay}" AutomationProperties.AutomationId="PluginBatchCommitButton"/>
                </StackPanel>
            </Border>

            <Border Visibility="{x:Bind ViewModel.IsStandardDiscoveryMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="GameDiscoveryPage_ScanHeading" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" x:Uid="GameDiscoveryPage_Search" TextChanged="OnFilterChanged"/>
                        <ComboBox x:Name="StoreFilter" Grid.Column="1" SelectionChanged="OnFilterChanged" SelectedIndex="0">
                            <ComboBoxItem x:Uid="GameDiscoveryPage_FilterAllStores" Tag="All"/>
                            <ComboBoxItem Content="Steam" Tag="Steam"/>
                            <ComboBoxItem Content="GOG" Tag="Gog"/>
                            <ComboBoxItem Content="Epic" Tag="Epic"/>
                        </ComboBox>
                        <ComboBox x:Name="StatusFilter" Grid.Column="2" SelectionChanged="OnFilterChanged" SelectedIndex="0">
                            <ComboBoxItem x:Uid="GameDiscoveryPage_FilterAllStatus" Tag="All"/>
                            <ComboBoxItem x:Uid="GameDiscoveryPage_FilterNew" Tag="New"/>
                            <ComboBoxItem x:Uid="GameDiscoveryPage_FilterNewResources" Tag="NewResources"/>
                            <ComboBoxItem x:Uid="GameDiscoveryPage_FilterUpToDate" Tag="UpToDate"/>
                        </ComboBox>
                        <Button x:Uid="GameDiscoveryPage_Scan" Grid.Column="3" Click="OnScanClick" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                        <Button x:Uid="GameDiscoveryPage_Cancel" Grid.Column="4" Click="OnCancelClick" IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <TextBlock Visibility="{x:Bind ViewModel.IsStandardDiscoveryMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Text="{x:Bind ViewModel.HiddenSelectionSummary, Mode=OneWay}" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" TextWrapping="Wrap"/>

            <Grid Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" IsHitTestVisible="{x:Bind ViewModel.CanStart, Mode=OneWay}" ColumnSpacing="12" MinHeight="380">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ListView x:Name="GameList" ItemsSource="{x:Bind ViewModel.VisibleGames, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}" SelectionChanged="OnGameSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameDiscoveryCandidateItem">
                            <Grid ColumnSpacing="8" Padding="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind Stores, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ScrollViewer Grid.Column="1">
                    <StackPanel Spacing="12" Padding="8">
                        <TextBlock Text="{x:Bind ViewModel.SelectedGame.Name, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedGame.InstallationSummary, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedGame.Notes, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedGame.NativeCloud, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedGame.BackupSets, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameDiscoveryBackupSetItem">
                                    <Border Padding="12" Margin="0,4" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="240"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="2" ItemsSource="{x:Bind Presets, Mode=OneWay}" SelectedItem="{x:Bind SelectedPreset, Mode=TwoWay}" DisplayMemberPath="Name" IsEnabled="{x:Bind CanChoosePreset, Mode=OneWay}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{x:Bind Resources, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GameDiscoveryResourceItem">
                                                        <Grid ColumnSpacing="8" Margin="0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}" VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                                                <TextBlock Text="{x:Bind Expression, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{x:Bind Tags, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{x:Bind PathSummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{x:Bind Evidence, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{x:Bind SupportText, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Button x:Uid="GameDiscoveryPage_Review" Click="OnReviewClick" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>

            <Border Visibility="{x:Bind ViewModel.HasDrafts, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SystemControlForegroundAccentBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="GameDiscoveryPage_ConfirmHeading" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Uid="GameDiscoveryPage_ConfirmDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Drafts, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameDiscoveryDraftItem">
                                <Grid ColumnSpacing="8" RowSpacing="6" Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{x:Bind ConfigName, Mode=TwoWay}" IsReadOnly="{x:Bind IsExistingConfiguration, Mode=OneWay}"/>
                                    <TextBox Grid.Column="2" Text="{x:Bind DestinationPath, Mode=TwoWay}" IsReadOnly="{x:Bind IsExistingConfiguration, Mode=OneWay}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Reconciliation, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{x:Bind Issues, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{x:Bind Changes, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:DiscoverySourceChange">
                                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsActionable, Mode=OneTime}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind Kind, Mode=OneTime}"/>
                                                            <TextBlock Text="{x:Bind NormalizedRootPath, Mode=OneTime}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Uid="GameDiscoveryPage_Commit" Click="OnCommitClick" HorizontalAlignment="Right" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
