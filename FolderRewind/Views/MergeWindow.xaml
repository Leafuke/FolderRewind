<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FolderRewind.Views.MergeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FolderRewind.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 透明拖拽区交给系统标题栏接管；右上角关闭按钮仍使用系统按钮。 -->
        <Border x:Name="TitleBarDragRegion" Background="Transparent" />

        <!-- 顶部：合并方向、冲突进度、导航 -->
        <Border Grid.Row="1"
                Padding="24,0,24,12"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Uid="Merge_Title" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{x:Bind ViewModel.DirectionText, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Uid="Merge_Previous" Click="OnPreviousClick"
                            IsEnabled="{x:Bind ViewModel.CanNavigatePrevious, Mode=OneWay}" />
                    <Button x:Uid="Merge_Next" Click="OnNextClick"
                            IsEnabled="{x:Bind ViewModel.CanNavigateNext, Mode=OneWay}" />
                    <CheckBox x:Uid="Merge_ShowBase"
                              MinWidth="0"
                              IsChecked="{x:Bind ViewModel.ShowBase, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中部：左冲突列表，右冲突详情 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      Margin="12"
                      ItemsSource="{x:Bind ViewModel.Conflicts, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedConflict, Mode=TwoWay}"
                      SelectionChanged="OnConflictSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MergeConflictItem">
                        <Grid Margin="0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisInvertConverter}}" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind KindText}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind StateText}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1" Margin="0,12,24,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 当前冲突：路径、类型、整份取一边 -->
                <Border Grid.Row="0"
                        Padding="12"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{Binding HasSelectedConflict, Converter={StaticResource BoolToVisConverter}}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.ConflictPath, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.ConflictKindText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Uid="Merge_TakeOurs" Click="OnTakeOursClick"
                                    IsEnabled="{x:Bind ViewModel.CanResolveSelection, Mode=OneWay}" />
                            <Button x:Uid="Merge_TakeTheirs" Click="OnTakeTheirsClick"
                                    IsEnabled="{x:Bind ViewModel.CanResolveSelection, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 一条冲突都没有时占据同一格：没有可问人的东西，改为交代「自动合掉了什么」，
                     以及这批结果马上就可以应用。中间栏铺的是它的区段流。 -->
                <Border Grid.Row="0"
                        Padding="12"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{Binding IsAutoMergePreview, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Merge_AutoMerge_Title" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.AutoMergeSummary, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.AutoMergeUnviewableText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasUnviewableAutoMergedFiles, Converter={StaticResource BoolToVisConverter}}" />
                    </StackPanel>
                </Border>

                <!-- 区段流。三栏同处一个网格行，竖直位置是布局算出来的，不需要互驱滚动。 -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12" Height="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Uid="Merge_Pane_Ours"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" x:Uid="Merge_Pane_Result"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" x:Uid="Merge_Pane_Theirs"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.SideOnlyText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding ShowSideOnlyNotice, Converter={StaticResource BoolToVisConverter}}" />

                        <TextBlock x:Uid="Merge_NoSelection"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding ShowNoSelectionHint, Converter={StaticResource BoolToVisConverter}}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Hunks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MergeHunkItem">
                                    <Border Margin="0,0,0,8"
                                            Padding="8"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{Binding Hunk.Kind, Converter={StaticResource LineMergeKindToBrushConverter}}">
                                        <StackPanel Spacing="4">
                                            <!-- 所属文件。只在「已自动合并」预览里出现：那份流里铺着好几个文件的区段，
                                                 没有这一行就分不清哪几块属于哪个文件。 -->
                                            <TextBlock Text="{x:Bind FileHeader}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasFileHeader, Converter={StaticResource BoolToVisConverter}}" />

                                            <!-- 区段抬头：类型 + 选择状态 + 折叠钮 -->
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind KindText}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind ChoiceText}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding IsConflict, Converter={StaticResource BoolToVisConverter}}" />
                                                </StackPanel>
                                                <!-- 文案随展开状态变，所以不用 x:Uid，走条目上的本地化属性。 -->
                                                <Button Grid.Column="1"
                                                        Content="{x:Bind ToggleText, Mode=OneWay}"
                                                        Padding="8,2"
                                                        FontSize="12"
                                                        Click="OnToggleHunkClick"
                                                        Tag="{Binding}"
                                                        Visibility="{Binding LongUnchanged, Converter={StaticResource BoolToVisConverter}}" />
                                            </Grid>

                                            <!-- 折叠态：整块一行说明 -->
                                            <TextBlock Text="{x:Bind CollapsedText}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisConverter}}" />

                                            <!-- 展开态：三栏（本地 / 结果 / 对方） -->
                                            <Grid ColumnSpacing="12"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <ItemsControl Grid.Column="0" ItemsSource="{x:Bind OurLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:MergeLineItem">
                                                            <Grid Height="18" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Number}"
                                                                           TextAlignment="Right"
                                                                           FontFamily="Consolas"
                                                                           FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind Text}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="12"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ResultLines, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:MergeLineItem">
                                                            <Grid Height="18">
                                                                <TextBlock Text="{x:Bind Text}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="12"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl Grid.Column="2" ItemsSource="{x:Bind TheirLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:MergeLineItem">
                                                            <Grid Height="18" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Number}"
                                                                           TextAlignment="Right"
                                                                           FontFamily="Consolas"
                                                                           FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind Text}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="12"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <!-- 共同祖先：显示在块内，不占第四栏 —— 多一栏就得让三栏的每一行都跟着让位，
                                                 而共同祖先并非每条冲突都有。 -->
                                            <StackPanel Spacing="2"
                                                        Visibility="{Binding ShowBase, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock x:Uid="Merge_Pane_Base"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ItemsControl ItemsSource="{x:Bind BaseLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:MergeLineItem">
                                                            <Grid Height="18" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Number}"
                                                                           TextAlignment="Right"
                                                                           FontFamily="Consolas"
                                                                           FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind Text}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="12"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- 逐块选择 -->
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        Visibility="{Binding IsConflict, Converter={StaticResource BoolToVisConverter}}">
                                                <Button x:Uid="Merge_AcceptOurs" Padding="8,2" FontSize="12"
                                                        Click="OnAcceptOursClick" Tag="{Binding}"
                                                        IsEnabled="{x:Bind CanChoose, Mode=OneWay}" />
                                                <Button x:Uid="Merge_AcceptTheirs" Padding="8,2" FontSize="12"
                                                        Click="OnAcceptTheirsClick" Tag="{Binding}"
                                                        IsEnabled="{x:Bind CanChoose, Mode=OneWay}" />
                                                <Button x:Uid="Merge_AcceptBoth" Padding="8,2" FontSize="12"
                                                        Click="OnAcceptBothClick" Tag="{Binding}"
                                                        IsEnabled="{x:Bind CanChoose, Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 结果：可编辑的那一份就是这里的内容，提交的也是它。
                     没有冲突可解决时没有「结果」这回事（合并结果已经在库里，见上面的预览），整块收起。 -->
                <Grid Grid.Row="2" ColumnSpacing="8"
                      Visibility="{Binding HasSelectedConflict, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Uid="Merge_ResultHeader" VerticalAlignment="Center" />
                        <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="4" Padding="6,2"
                                Visibility="{Binding IsHandEdited, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock x:Uid="Merge_HandEdited" FontSize="11" TextWrapping="NoWrap" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Merge_ResetEdit" Click="OnResetEditClick"
                                IsEnabled="{x:Bind ViewModel.IsHandEdited, Mode=OneWay}" />
                        <Button x:Uid="Merge_SaveManual" Click="OnSaveManualClick"
                                IsEnabled="{x:Bind ViewModel.CanSubmitManual, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- 文本不绑定：视图模型推文本时会引发一次 TextChanged，那一次不是用户改的。
                     视图靠「框里的内容是不是自己刚写进去的那一份」把它认出来（见 MergeWindow.xaml.cs）——
                     那个通知可能迟到，用开关挡不住。
                     高度写在这里而不是行定义上：行是 Auto，收起时不该留下一个 180 像素的空洞。 -->
                <TextBox x:Name="ResultTextBox"
                         Grid.Row="4"
                         Height="180"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsSpellCheckEnabled="False"
                         TextChanged="OnResultTextChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisConverter}}"
                         IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- 底部：状态与整场动作 -->
        <Border Grid.Row="3"
                Padding="24,12"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="Merge_Abandon" Click="OnAbandonClick"
                            IsEnabled="{x:Bind ViewModel.CanStartCommand, Mode=OneWay}" />
                    <Button x:Uid="Merge_Recompute" Click="OnRecomputeClick"
                            IsEnabled="{x:Bind ViewModel.CanStartCommand, Mode=OneWay}" />
                    <Button x:Uid="Merge_Apply" Style="{StaticResource AccentButtonStyle}" Click="OnApplyClick"
                            IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
