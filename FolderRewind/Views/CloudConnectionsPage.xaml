<Page x:Class="FolderRewind.Views.CloudConnectionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:FolderRewind.ViewModels" xmlns:local="using:FolderRewind.Views">
    <Grid local:PageLayout.ResponsivePadding="True" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock x:Uid="CloudConnections_Title" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock x:Uid="CloudConnections_Description" TextWrapping="Wrap"/>
            <Grid x:Name="CreateActions" ColumnSpacing="12" SizeChanged="OnCreateSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Button x:Name="CreateSharedButton" x:Uid="CloudConnections_CreateShared" Click="OnCreateShared" AutomationProperties.AutomationId="CloudCreateShared" VerticalAlignment="Center"/>
                <ComboBox x:Name="ConnectionProjectPicker" Grid.Column="1" Width="280" x:Uid="CloudConnections_ProjectOwner" ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedProjectIndex, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.AutomationId="CloudConnectionOwner"/>
                <Button x:Name="CreateProjectButton" Grid.Column="2" x:Uid="CloudConnections_CreateProject" Click="OnCreateProject" IsEnabled="{x:Bind ViewModel.HasProjectSelection, Mode=OneWay}" AutomationProperties.AutomationId="CloudCreateProject" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}" SelectionChanged="OnSelected" AutomationProperties.AutomationId="CloudConnectionCatalog">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CloudConnectionDisplay">
                    <StackPanel Spacing="4" Padding="8"><TextBlock Text="{x:Bind Name, Mode=OneTime}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Detail, Mode=OneTime}" TextWrapping="Wrap"/></StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.SelectedConnectionText, Mode=OneWay}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8" SizeChanged="OnConnectionActionsSizeChanged">
                <Button x:Uid="CloudConnections_Edit" Click="OnEdit" IsEnabled="{x:Bind ViewModel.HasSelectedProfile, Mode=OneWay}" AutomationProperties.AutomationId="CloudEditConnection"/>
                <Button x:Uid="CloudConnections_Promote" Click="OnPromote" IsEnabled="{x:Bind ViewModel.CanPromote, Mode=OneWay}" AutomationProperties.AutomationId="CloudPromoteConnection"/>
                <Button x:Uid="CloudConnections_Delete" Click="OnDelete" IsEnabled="{x:Bind ViewModel.HasSelectedProfile, Mode=OneWay}" AutomationProperties.AutomationId="CloudDeleteConnection"/>
            </StackPanel>
            <TextBlock x:Name="Result" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </Grid>
</Page>
