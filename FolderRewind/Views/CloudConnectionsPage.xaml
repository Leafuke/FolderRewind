<Page x:Class="FolderRewind.Views.CloudConnectionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:FolderRewind.ViewModels">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock x:Uid="CloudConnections_Title" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock x:Uid="CloudConnections_Description" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="CloudConnections_CreateShared" Click="OnCreateShared" AutomationProperties.AutomationId="CloudCreateShared"/>
                <ComboBox x:Uid="CloudConnections_ProjectOwner" ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedProjectIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.AutomationId="CloudConnectionOwner"/>
                <Button x:Uid="CloudConnections_CreateProject" Click="OnCreateProject" AutomationProperties.AutomationId="CloudCreateProject"/>
            </StackPanel>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}" SelectionChanged="OnSelected" AutomationProperties.AutomationId="CloudConnectionCatalog">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CloudConnectionDisplay">
                    <StackPanel Spacing="4" Padding="8"><TextBlock Text="{x:Bind Name, Mode=OneTime}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail, Mode=OneTime}" TextWrapping="Wrap"/></StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="CloudConnections_Edit" Click="OnEdit" AutomationProperties.AutomationId="CloudEditConnection"/>
                <Button x:Uid="CloudConnections_Promote" Click="OnPromote" AutomationProperties.AutomationId="CloudPromoteConnection"/>
                <Button x:Uid="CloudConnections_Delete" Click="OnDelete" AutomationProperties.AutomationId="CloudDeleteConnection"/>
            </StackPanel>
            <TextBlock x:Name="Result" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </Grid>
</Page>
