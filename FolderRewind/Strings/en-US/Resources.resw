  <data name="Template_SyntaxHelp_Variables_Description" xml:space="preserve">
    <value>You can use these variables as path roots: {UserProfile}, {Documents}, {DocumentsMyGames}, {SavedGames}, {AppDataRoaming}, {AppDataLocal}, {AppDataLocalLow}, {ProgramData}, {SteamUserData}, and {UserName}.</value>
