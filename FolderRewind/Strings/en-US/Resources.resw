  <data name="Template_SyntaxHelp_Variables_Title" xml:space="preserve">
    <value>Common variables</value>
  </data>
  <data name="Template_SyntaxHelp_Variables_Description" xml:space="preserve">
    <value>You can use these variables as path roots: {UserProfile}, {Documents}, {DocumentsMyGames}, {SavedGames}, {AppDataRoaming}, {AppDataLocal}, {AppDataLocalLow}, {ProgramData}, {SteamUserData}, and {UserName}.</value>
  </data>
  <data name="Template_SyntaxHelp_Variables_Example" xml:space="preserve">
    <value>Example: {AppDataRoaming}\GameName\Saves</value>
  </data>
  <data name="Template_SyntaxHelp_Wildcard_Title" xml:space="preserve">
    <value>{*} wildcard folders</value>
  </data>
  <data name="Template_SyntaxHelp_Wildcard_Description" xml:space="preserve">
    <value>{*} expands every child folder at the current level. You can place it in the middle of a path or chain it multiple times. When it is the first segment, it traverses every ready drive.</value>
  </data>
  <data name="Template_SyntaxHelp_Wildcard_Example" xml:space="preserve">
    <value>Example: {*}\{*}\.minecraft\versions\{*}\saves\{*}</value>
  </data>
  <data name="Template_SyntaxHelp_Process_Title" xml:space="preserve">
    <value>Process directory</value>
  </data>
  <data name="Template_SyntaxHelp_Process_Description" xml:space="preserve">
    <value>{Process:xxx.exe} resolves the install directory of a currently running process before continuing the match. It works well for launchers and portable games.</value>
  </data>
  <data name="Template_SyntaxHelp_Process_Example" xml:space="preserve">
    <value>Example: {Process:Plain Craft Launcher 2.exe}\.minecraft\versions\{*}\saves\{*}</value>
  </data>
  <data name="Template_SyntaxHelp_Root_Title" xml:space="preserve">
    <value>Explicit drive roots</value>
  </data>
  <data name="Template_SyntaxHelp_Root_Description" xml:space="preserve">
    <value>You can now start expressions directly from a drive root such as C:\..., and you can mix explicit drives with wildcard folders.</value>
  </data>
  <data name="Template_SyntaxHelp_Root_Example" xml:space="preserve">
    <value>Example: C:\{*}\.minecraft\versions\{*}\saves\{*}</value>
  </data>
  <data name="Template_SyntaxHelp_FileMatch_Title" xml:space="preserve">
    <value>File match list</value>
  </data>
  <data name="Template_SyntaxHelp_FileMatch_Description" xml:space="preserve">
    <value>When you provide a ; separated list of file names, the rule only matches if the directory matches and every listed file exists.</value>
  </data>
  <data name="Template_SyntaxHelp_FileMatch_Example" xml:space="preserve">
    <value>Example: level.dat;session.lock</value>
  </data>
