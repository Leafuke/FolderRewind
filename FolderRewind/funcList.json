{
  "specVersion": "1.0",
  "manifestVersion": "3.0.0",
  "appName": "FolderRewind",
  "openSocket": {
    "auto_backup": {
      "appID": "0x00000020",
      "openSocketID": "0x00000010",
      "description": "Start periodic backup bound to this folder and these operation options.",
      "args": {
        "backup_blacklist": {
          "type": "input",
          "description": "Optional comma-separated rules appended and deduplicated against local rules; empty does not clear."
        },
        "backup_mode": {
          "type": "optional",
          "options": [
            [
              "full",
              "full"
            ],
            [
              "smart",
              "smart"
            ]
          ],
          "description": "Omit to inherit local mode; supplied value overrides this operation only."
        },
        "backup_scope": {
          "type": "input",
          "description": "Optional scope override. full/all/default/none disables the local plugin scope for this operation."
        },
        "backup_whitelist": {
          "type": "input",
          "description": "Optional comma-separated rules appended and deduplicated against local rules; nonempty selects whitelist mode."
        },
        "cmd": {
          "type": "static",
          "value": "AUTO_BACKUP",
          "description": "Operation command."
        },
        "comment": {
          "type": "input",
          "description": "Optional comment for this operation only."
        },
        "compression_level": {
          "type": "input",
          "description": "Optional integer; omit to inherit local level. Must be valid for the effective compression method."
        },
        "compression_method": {
          "type": "optional",
          "options": [
            [
              "LZMA2",
              "LZMA2"
            ],
            [
              "Deflate",
              "Deflate"
            ],
            [
              "BZip2",
              "BZip2"
            ],
            [
              "zstd",
              "zstd"
            ]
          ],
          "description": "Omit to inherit local compression; supplied value overrides this operation only."
        },
        "config_id": {
          "type": "input",
          "description": "Required backup configuration ID; also accepts name or zero-based index."
        },
        "folder": {
          "type": "input",
          "description": "Required folder name, path, stable ID or zero-based index."
        },
        "from": {
          "type": "input",
          "description": "Required caller identifier."
        },
        "interval_minutes": {
          "type": "input",
          "description": "Required integer interval, at least 1 minute.",
          "defaultVal": "10"
        },
        "request_id": {
          "type": "input",
          "description": "Required request correlation ID."
        },
        "scope_areas": {
          "type": "input",
          "description": "Optional scope override: x1,z1,x2,z2 block-coordinate rectangles, one per line; requires selected-regions scope."
        },
        "scope_dimensions": {
          "type": "input",
          "description": "Optional scope override: comma-separated overworld, nether, end (including their vanilla Minecraft aliases)."
        }
      },
      "returns": [
        [
          "Operation status.",
          "status"
        ],
        [
          "Response message.",
          "message"
        ]
      ]
    },
