          "description": "Optional one-shot backup mode."
        },
        "backup_scope": {
          "type": "input",
          "description": "Optional plugin backup scope ID.",
          "defaultVal": ""
        },
        "backup_whitelist": {
          "type": "input",
          "description": "Comma-separated one-shot whitelist rules.",
          "defaultVal": ""
        },
        "cmd": {
          "type": "static",
          "value": "BACKUP",
          "description": "Operation command."
        },
        "comment": {
          "type": "input",
          "description": "Optional backup comment.",
          "defaultVal": ""
        },
        "compression_level": {
          "type": "input",
          "description": "Optional one-shot compression level.",
          "defaultVal": ""
        },
        "compression_method": {
          "type": "optional",
          "options": [
            [
              "LZMA2",
              "LZMA2"
            ],
            [
              "Deflate",
              "Deflate"
            ],
            [
              "BZip2",
              "BZip2"
            ],
            [
              "zstd",
              "zstd"
            ]
          ],
          "description": "Optional one-shot compression method."
        },
        "config_id": {
          "type": "input",
          "description": "Backup configuration ID.",
          "defaultVal": "config-id"
        },
        "folder": {
          "type": "input",
          "description": "Folder name or index.",
          "defaultVal": "0"
        },
        "from": {
          "type": "input",
          "description": "Required caller identifier.",
          "defaultVal": "example.client"
        },
        "request_id": {
          "type": "input",
          "description": "Required unique request correlation ID.",
          "defaultVal": "request-001"
        },
        "scope_areas": {
          "type": "input",
          "description": "Example plugin scope parameter.",
          "defaultVal": ""
        },
        "scope_dimensions": {
          "type": "input",
          "description": "Example plugin scope parameter.",
          "defaultVal": ""
        }
