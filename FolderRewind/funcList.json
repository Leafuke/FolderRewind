{
  "specVersion": "1.0",
  "manifestVersion": "2.0.0",
  "appName": "FolderRewind",
  "openSocket": {
    "auto_backup": {
      "appID": "0x00000020",
      "openSocketID": "0x00000010",
      "description": "Start periodic backup for one managed folder.",
      "args": {
        "cmd": {
          "type": "static",
          "value": "AUTO_BACKUP",
          "description": "Operation command."
        },
        "config_id": {
          "type": "input",
          "description": "Backup configuration ID.",
          "defaultVal": "config-id"
        },
        "folder": {
          "type": "input",
          "description": "Folder name or index.",
          "defaultVal": "0"
        },
        "from": {
          "type": "input",
          "description": "Required caller identifier.",
          "defaultVal": "example.client"
        },
        "interval_minutes": {
          "type": "input",
          "description": "Backup interval in minutes.",
          "defaultVal": "10"
        },
        "request_id": {
          "type": "input",
          "description": "Required unique request correlation ID.",
          "defaultVal": "request-001"
        }
      },
      "returns": [
        [
          "Operation status.",
          "status"
        ],
        [
          "Response message.",
          "message"
        ]
      ]
    },
    "backup": {
      "appID": "0x00000020",
      "openSocketID": "0x00000010",
