{
  "schemaVersion": 1,
  "presetId": "minecraft-enhanced-experience",
  "name": "Minecraft Enhanced Experience",
  "actions": [
    {
      "id": "install-minerewind",
      "type": "installBundledPlugin",
      "pluginId": "com.folderrewind.minerewind",
      "packagePath": "Assets/Plugins/MineRewind-1.9.3.frplugin",
      "sha256": "9cf45bc4be235ec2c95beb4b4dcbf7d14184d66b2cd6c8e6d55206ae5fc35de5"
    },
    {
      "id": "enable-minerewind",
      "dependsOn": ["install-minerewind"],
      "type": "enablePlugin",
      "pluginId": "com.folderrewind.minerewind"
    },
    {
      "id": "enable-knotlink-host",
      "dependsOn": ["enable-minerewind"],
      "type": "setHostFeature",
      "feature": "knotLink",
      "enabled": true
    },
    {
      "id": "knotlink-installer-awaits-curation",
      "type": "notice",
      "severity": "warning",
      "messageResourceKey": "PluginPreset_Notice_KnotLinkCuration"
    },
    {
      "id": "mine-backup-reminder",
      "type": "notice",
      "severity": "information",
      "messageResourceKey": "PluginPreset_Notice_MineBackupReminder"
    }
  ]
}
