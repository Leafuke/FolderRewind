{
  "schemaVersion": 1,
  "presetId": "minecraft-enhanced-experience",
  "name": "Minecraft Enhanced Experience",
  "actions": [
    {
      "id": "install-minerewind",
      "type": "installBundledPlugin",
      "pluginId": "com.folderrewind.minerewind",
      "packagePath": "Assets/Plugins/MineRewind-1.9.0.frplugin",
      "sha256": "b0ed525bcf49dc22a7ee0ee04c07eda6242fe4efa52368758fc9ac406fc76b63"
    },
    {
      "id": "enable-minerewind",
      "type": "enablePlugin",
      "pluginId": "com.folderrewind.minerewind"
    },
    {
      "id": "enable-knotlink-host",
      "type": "setHostFeature",
      "feature": "knotLink",
      "enabled": true
    },
    {
      "id": "knotlink-installer-awaits-curation",
      "type": "notice",
      "severity": "warning",
      "message": "KnotLink external installer is not executed until an immutable official URL and SHA-256 have been curated."
    },
    {
      "id": "mine-backup-reminder",
      "type": "notice",
      "severity": "information",
      "message": "For hot consistency, install a compatible in-game Mine backup integration. Raw full backup remains available with warnings."
    }
  ]
}
