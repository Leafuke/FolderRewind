<UserControl
    x:Class="FolderRewind.Controls.NotificationCenterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FolderRewind.ViewModels">
    <Grid Padding="16" RowSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="NotificationCenter_Title" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Uid="NotificationCenter_SessionHint" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="1" x:Uid="NotificationCenter_Close" Click="OnClose" VerticalAlignment="Top"
                    AutomationProperties.AutomationId="NotificationCenterClose"><SymbolIcon Symbol="Cancel"/></Button>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox x:Uid="NotificationCenter_Filter" SelectedIndex="0" SelectionChanged="OnFilterChanged"
                      HorizontalAlignment="Stretch" AutomationProperties.AutomationId="NotificationCenterFilter">
                <ComboBoxItem x:Uid="NotificationCenter_All"/><ComboBoxItem x:Uid="NotificationCenter_UnreadFilter"/>
            </ComboBox>
            <Button Grid.Column="1" x:Uid="NotificationCenter_MarkAllRead" Command="{x:Bind ViewModel.MarkAllReadCommand}"
                    AutomationProperties.AutomationId="NotificationCenterMarkAllRead"/>
        </Grid>
        <ListView Grid.Row="2" x:Uid="NotificationCenter_List" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="True" ItemClick="OnItemClick" SelectionMode="None"
                  AutomationProperties.AutomationId="NotificationCenterList">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:NotificationItemViewModel">
                    <StackPanel Padding="4,8" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{x:Bind SeverityText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ReadState, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Message, Mode=OneWay}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Timestamp, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="2" x:Uid="NotificationCenter_Empty" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"/>
        <ScrollViewer Grid.Row="3" MaxHeight="280" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.DetailText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                <Button x:Uid="NotificationCenter_OpenTarget" Command="{x:Bind ViewModel.OpenTargetCommand}" IsEnabled="{x:Bind ViewModel.HasTarget, Mode=OneWay}" AutomationProperties.AutomationId="NotificationCenterOpenTarget"/>
                <Button x:Uid="NotificationCenter_OpenLogs" Command="{x:Bind ViewModel.OpenLogsCommand}" IsEnabled="{x:Bind ViewModel.HasLogs, Mode=OneWay}" AutomationProperties.AutomationId="NotificationCenterOpenLogs"/>
                <Button x:Name="CloseDetailsButton" x:Uid="NotificationCenter_CloseDetails" Command="{x:Bind ViewModel.CloseDetailsCommand}" AutomationProperties.AutomationId="NotificationCenterCloseDetails"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
