<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../FolderRewind.TestSupport/FolderRewind.TestSupport.csproj" />
  </ItemGroup>
  <Target Name="RequireFaultInjectionBuild" BeforeTargets="CoreCompile">
    <Error Condition="'$(FolderRewindFaultInjection)' != 'true'" Text="Build the recovery probe with -p:FolderRewindFaultInjection=true." />
  </Target>
</Project>
