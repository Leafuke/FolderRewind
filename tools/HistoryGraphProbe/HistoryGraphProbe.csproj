<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FolderRewind.Core/FolderRewind.Core.csproj" />
  </ItemGroup>
  <Target Name="RequireProductionCore" BeforeTargets="CoreCompile">
    <Error Condition="'$(FolderRewindFaultInjection)' == 'true'" Text="HistoryGraphProbe must reference the production Core build." />
  </Target>
</Project>
