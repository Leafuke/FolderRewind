<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <ApplicationManifest>..\..\FolderRewind\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.7.1" PrivateAssets="all" />
    <Compile Include="..\..\FolderRewind\Services\AppUpdatePolicy.cs" Link="AppUpdatePolicy.cs" />
    <Compile Include="..\..\FolderRewind\Services\AppUpdatePresentation.cs" Link="AppUpdatePresentation.cs" />
    <Compile Include="..\..\FolderRewind\Services\Plugins\GitHubReleaseMetadata.cs" Link="GitHubReleaseMetadata.cs" />
    <None Include="..\..\FolderRewind.Tests\Fixtures\AppUpdate\v1.9.6.json" Link="Fixtures\v1.9.6.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\FolderRewind\Strings\zh-CN\Resources.resw" Link="Fixtures\zh-CN.resw" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\FolderRewind\Strings\en-US\Resources.resw" Link="Fixtures\en-US.resw" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
