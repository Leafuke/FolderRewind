<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AbstractionsPath Condition="'$(AbstractionsPath)'==''">$(MSBuildThisFileDirectory)..\..\..\src\FolderRewind.Plugin.Abstractions\bin\Release\net10.0\FolderRewind.Plugin.Abstractions.dll</AbstractionsPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FolderRewind.Plugin.Abstractions"><HintPath>$(AbstractionsPath)</HintPath></Reference>
    <Reference Include="MineRewind"><HintPath>$(PackageDirectory)\MineRewind.dll</HintPath></Reference>
    <Reference Include="MineRewind.World"><HintPath>$(PackageDirectory)\MineRewind.World.dll</HintPath></Reference>
    <Reference Include="fNbt"><HintPath>$(PackageDirectory)\fNbt.dll</HintPath></Reference>
    <Reference Include="K4os.Compression.LZ4"><HintPath>$(PackageDirectory)\K4os.Compression.LZ4.dll</HintPath></Reference>
    <Reference Include="System.IO.Hashing"><HintPath>$(PackageDirectory)\System.IO.Hashing.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireExactPlugin" BeforeTargets="ResolveReferences">
    <Error Condition="'$(PackageDirectory)'=='' Or !Exists('$(PackageDirectory)\MineRewind.dll')" Text="Set PackageDirectory to an extracted exact .frplugin package." />
  </Target>
</Project>
